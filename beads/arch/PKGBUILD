pkgname=beads
pkgver=1.3.1
pkgrel=1
pkgdesc='Beads issue tracker, pinned client with a version guard'
arch=('x86_64')
url='https://github.com/steveyegge/beads'
license=('MIT')
depends=('glibc')
options=('!strip' '!debug')
source=("beads_${pkgver}_linux_amd64.tar.gz::https://github.com/steveyegge/beads/releases/download/v${pkgver}/beads_${pkgver}_linux_amd64.tar.gz")
sha256sums=('3219443a9734b89b93fb16ee8d65844759fa1b3cd3cf139c606b7353cfb0715c')
package() {
  install -Dm755 "$srcdir/bd" "$pkgdir/usr/lib/beads/$pkgver/bd"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/bd" <<'GUARD'
#!/bin/sh
set -eu
client=/usr/lib/beads/1.3.1/bd
version=$("$client" version) || { printf '%s\n' 'bd guard: pinned client unavailable' >&2; exit 78; }
case "$version" in
  'bd version 1.3.1 '*) ;;
  *) printf '%s\n' "bd guard: expected 1.3.1; refusing $version before opening a tracker" >&2; exit 78 ;;
esac
exec "$client" "$@"
GUARD
  chmod 755 "$pkgdir/usr/bin/bd"
}
