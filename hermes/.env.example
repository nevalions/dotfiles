# Credentials only. Copy to ~/.hermes/.env and fill in; this example and the
# real file are both local — the live .env is never tracked.
#
# Settings (models, toolsets, display) belong in config.yaml / config.base.yaml,
# not here. Hermes reads only documented secret variables from this file.

# Active provider on this machine.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kimi / Moonshot (provider: kimi-coding).
# KIMI_API_KEY=
# KIMI_BASE_URL=

# Other providers, uncomment as needed.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GLM_API_KEY=
# MINIMAX_API_KEY=
# HF_TOKEN=

# Tools that need their own credentials.
# BROWSERBASE_API_KEY=
# ELEVENLABS_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
