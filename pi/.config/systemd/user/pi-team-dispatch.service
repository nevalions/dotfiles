[Unit]
Description=Run one bounded Pi Team unattended dispatch tick (opt-in)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.pi/agent/bin/pi-team-dispatch tick --policy %h/.config/pi-team/dispatch-policy.json --json
UMask=0077
PrivateTmp=true
TimeoutStartSec=30m
StandardOutput=journal
StandardError=journal
