#!/usr/bin/env python3
"""Observe the installed canary without changing Kubernetes resources."""
from __future__ import annotations

import argparse
import copy
import hashlib
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import stat
import sys
import tempfile


class ObservationError(ValueError):
    """Current canary evidence is missing, changing or unhealthy."""


def require(condition, message):
    if not condition:
        raise ObservationError(message)


def get(args, namespace, kind, name=None):
    command = ['kubectl', '--context', args.context, '--request-timeout=10s', '-n', namespace, 'get', kind]
    if name:
        command.append(name)
    command += ['-o', 'json']
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=15, check=False)
    except subprocess.TimeoutExpired as exc:
        raise ObservationError(f'kubectl get {kind} timed out') from exc
    except OSError as exc:
        raise ObservationError(f'cannot execute kubectl: {exc}') from exc
    require(result.returncode == 0, f'kubectl get {kind} failed: {result.stderr.strip()[:1000]}')
    try:
        value = json.loads(result.stdout)
    except ValueError as exc:
        raise ObservationError(f'kubectl get {kind} returned invalid JSON') from exc
    require(isinstance(value, dict), f'kubectl get {kind} returned a non-object')
    return value


def owned(resource, kind, uid):
    return any(ref.get('kind') == kind and ref.get('uid') == uid and ref.get('controller') is True
               for ref in resource.get('metadata', {}).get('ownerReferences', []))


def snapshot(args):
    flux = get(args, args.flux_namespace, 'kustomizations.kustomize.toolkit.fluxcd.io', args.kustomization)
    deployment = get(args, args.namespace, 'deployment', args.deployment)
    replica_sets = get(args, args.namespace, 'replicasets').get('items', [])
    pods = get(args, args.namespace, 'pods').get('items', [])
    uid = deployment['metadata']['uid']
    replica_sets = [rs for rs in replica_sets if owned(rs, 'Deployment', uid)]
    rs_uids = {rs['metadata']['uid'] for rs in replica_sets}
    pods = [pod for pod in pods if any(owned(pod, 'ReplicaSet', rs_uid) for rs_uid in rs_uids)]
    return {'flux': flux, 'deployment': deployment,
            'replica_sets': sorted(replica_sets, key=lambda x: x['metadata']['uid']),
            'pods': sorted(pods, key=lambda x: x['metadata']['uid'])}


def condition(resource, name):
    found = [c for c in resource.get('status', {}).get('conditions', []) if c.get('type') == name]
    require(len(found) <= 1, f'duplicate {name} conditions')
    return found[0] if found else {}


def template(value):
    value = copy.deepcopy(value)
    value.get('metadata', {}).get('labels', {}).pop('pod-template-hash', None)
    return value


def identity(resource):
    metadata = resource['metadata']
    return {key: metadata[key] for key in ('uid', 'generation', 'resourceVersion') if key in metadata}


def validate(state, args):
    flux, dep = state['flux'], state['deployment']
    fm, fs = flux['metadata'], flux.get('status', {})
    require(not fm.get('deletionTimestamp'), 'Flux Kustomization is terminating')
    require(not dep['metadata'].get('deletionTimestamp'), 'deployment is terminating')
    ready = condition(flux, 'Ready')
    require(fs.get('observedGeneration') == fm['generation'], 'Flux observedGeneration is stale')
    require(ready.get('status') == 'True', 'Flux is not Ready')
    require(ready.get('observedGeneration', fm['generation']) == fm['generation'], 'Flux Ready condition is stale')
    require(all(condition(flux, name).get('status') != 'True' for name in ('Reconciling', 'Stalled')), 'Flux is reconciling or stalled')
    revision = fs.get('lastAppliedRevision')
    require(isinstance(revision, str) and revision and revision == fs.get('lastAttemptedRevision'), 'Flux applied/attempted revision is missing or differs')
    dm, ds = dep['metadata'], dep.get('status', {})
    desired = dep['spec'].get('replicas', 1)
    require(isinstance(desired, int) and desired > 0, 'deployment must have positive desired replicas')
    require(ds.get('observedGeneration') == dm['generation'], 'deployment observedGeneration is stale')
    require(all(ds.get(key, 0) == desired for key in ('replicas', 'updatedReplicas', 'readyReplicas', 'availableReplicas')), 'deployment rollout is incomplete')
    require(ds.get('unavailableReplicas', 0) == 0, 'deployment has unavailable replicas')
    require(condition(dep, 'Available').get('status') == 'True', 'deployment is not Available')
    progress = condition(dep, 'Progressing')
    require(progress.get('status') == 'True' and progress.get('reason') == 'NewReplicaSetAvailable', 'deployment has not completed progression')
    deployment_revision = dm.get('annotations', {}).get('deployment.kubernetes.io/revision')
    require(bool(deployment_revision), 'deployment revision is missing')
    current = [rs for rs in state['replica_sets'] if
               rs['metadata'].get('annotations', {}).get('deployment.kubernetes.io/revision') == deployment_revision
               and template(rs['spec']['template']) == template(dep['spec']['template'])]
    require(len(current) == 1, 'expected one owned current ReplicaSet matching deployment revision/template')
    rs = current[0]
    require(not rs['metadata'].get('deletionTimestamp') and rs['spec'].get('replicas') == desired, 'current ReplicaSet is terminating or scaled differently')
    require(rs.get('status', {}).get('observedGeneration') == rs['metadata']['generation'], 'ReplicaSet observedGeneration is stale')
    require(all(rs.get('status', {}).get(key, 0) == desired for key in ('replicas', 'readyReplicas', 'availableReplicas')), 'ReplicaSet is incomplete')
    pods = [p for p in state['pods'] if owned(p, 'ReplicaSet', rs['metadata']['uid'])]
    require(len(pods) == desired and len(state['pods']) == desired, 'expected only the current ReplicaSet desired pods')
    declared = [c for c in dep['spec']['template']['spec']['containers'] if c['name'] == args.container]
    require(len(declared) == 1, 'canary container is missing or duplicated in deployment')
    observed_pods = []
    for pod in pods:
        name = pod['metadata'].get('name', pod['metadata']['uid'])
        require(not pod['metadata'].get('deletionTimestamp'), f'pod {name} is terminating')
        require(pod.get('status', {}).get('phase') == 'Running' and all(condition(pod, c).get('status') == 'True' for c in ('Ready', 'ContainersReady')), f'pod {name} is not Ready')
        containers = [c for c in pod['spec']['containers'] if c['name'] == args.container]
        require(len(containers) == 1 and containers[0]['image'] == declared[0]['image'], f'pod {name} container image differs from deployment')
        statuses = [c for c in pod['status'].get('containerStatuses', []) if c.get('name') == args.container]
        require(len(statuses) == 1 and statuses[0].get('ready') is True and 'running' in statuses[0].get('state', {}), f'pod {name} canary container is not running/ready')
        image_id = statuses[0].get('imageID', '')
        match = re.fullmatch(r'(?:[a-zA-Z0-9+.-]+://)?(?:[^\s@]+@)?(sha256:[0-9a-fA-F]{64})', image_id)
        require(match is not None, f'pod {name} canary imageID has no sha256 digest')
        observed_pods.append(dict(identity(pod), name=name, image_id=image_id, digest=match.group(1).lower()))
    return {'flux': dict(identity(flux), revision=revision),
            'deployment': dict(identity(dep), revision=deployment_revision, replicas=desired, image=declared[0]['image']),
            'replica_set': dict(identity(rs), name=rs['metadata'].get('name')), 'pods': observed_pods,
            'digests': sorted({p['digest'] for p in observed_pods})}



TARGET_FIELDS = ('context', 'flux_namespace', 'kustomization', 'namespace', 'deployment', 'container')
DEFAULT_CANDIDATE = Path('/etc/pi-kube-maintenance/candidate.json')
SHA = r'[0-9a-f]{40}'
DIGEST = r'sha256:[0-9a-f]{64}'


def unique_fields(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result, f'duplicate candidate field: {key}')
        result[key] = value
    return result


def load_candidate(path, args, explicit=False):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        require(not explicit, f'candidate file missing: {path}')
        return None
    except OSError as exc:
        raise ObservationError(f'cannot safely open candidate file: {exc}') from exc
    with os.fdopen(descriptor, 'rb') as source:
        metadata = os.fstat(source.fileno())
        require(stat.S_ISREG(metadata.st_mode), 'candidate must be a regular file')
        require(metadata.st_uid in ({0, os.getuid()} if explicit else {0}), 'candidate owner is unauthorized')
        require(not metadata.st_mode & 0o022, 'candidate is group/world writable')
        if not explicit:
            for parent in path.absolute().parents:
                info = parent.lstat()
                require(stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022, f'candidate directory is not trusted: {parent}')
            require(metadata.st_uid != os.getuid() or os.getuid() == 0, 'candidate is writable by service owner')
        raw = source.read(65537)
        require(len(raw) <= 65536, 'candidate file exceeds 64 KiB')
    try:
        candidate = json.loads(raw, object_pairs_hook=unique_fields)
        require(isinstance(candidate, dict) and candidate.get('schema_version') == 1, 'candidate schema_version must be 1')
        require(candidate['target'] == {key: getattr(args, key) for key in TARGET_FIELDS}, 'candidate target differs from trusted CLI target')
        release = candidate['release']
        require(type(release['pr']) is int and release['pr'] > 0, 'candidate PR must be positive integer')
        require(all(isinstance(release[key], str) and re.fullmatch(SHA, release[key]) for key in ('source_sha', 'merge_sha')), 'candidate source/merge SHA is invalid')
        require(candidate['expected_revision'] == 'master@sha1:' + release['merge_sha'], 'candidate expected revision differs from merge SHA')
        ci = release['required_ci']
        require(isinstance(ci, list) and ci, 'candidate required CI references are missing')
        require(all(isinstance(item, dict) and isinstance(item.get('context'), str) and item['context'] and item.get('status') == 'success' and item.get('sha') == release['merge_sha'] and isinstance(item.get('url'), str) and item['url'].startswith('https://') for item in ci), 'candidate CI evidence must reference successful checks on merge SHA')
        image = candidate['desired_image']
        require(isinstance(image, str) and '@' not in image and re.fullmatch(r'[^\s]+:[^/\s:]+', image), 'candidate desired image must be exact tagged reference')
        evidence = candidate['registry_evidence']
        require(evidence['tag_ref'] == image, 'candidate registry image tag differs from desired image')
        require(all(isinstance(evidence[key], str) and re.fullmatch(DIGEST, evidence[key]) for key in ('manifest_digest', 'runtime_manifest_digest')), 'candidate registry manifest digest invalid')
        require(isinstance(evidence['url'], str) and evidence['url'].startswith('https://'), 'candidate registry evidence URL missing')
    except (ValueError, KeyError, TypeError, AttributeError) as exc:
        raise ObservationError(f'invalid candidate receipt: {exc}') from exc
    return candidate


def candidate_id(candidate):
    return hashlib.sha256(json.dumps(candidate, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def selected(value, fields):
    return {key: value[key] for key in fields if key in value}


def observed_conditions(resource):
    return [selected(item, ('type', 'status', 'reason', 'observedGeneration'))
            for item in resource.get('status', {}).get('conditions', [])]


def observed_container(container):
    result = selected(container, ('name', 'ready', 'image', 'imageID'))
    states = container.get('state', {})
    for kind in ('running', 'waiting', 'terminated'):
        if kind in states:
            result['state'] = kind
            if 'reason' in states[kind]:
                result['reason'] = states[kind]['reason']
            break
    return result


def observed(state, args):
    flux, dep = state['flux'], state['deployment']
    fs, ds = flux.get('status', {}), dep.get('status', {})
    containers = dep.get('spec', {}).get('template', {}).get('spec', {}).get('containers', [])
    images = [c.get('image') for c in containers if c.get('name') == args.container]
    return {
        'flux': dict(identity(flux), **selected(fs, ('observedGeneration', 'lastAppliedRevision', 'lastAttemptedRevision')), conditions=observed_conditions(flux)),
        'deployment': dict(identity(dep), image=images[0] if len(images) == 1 else images,
                           **selected(ds, ('observedGeneration', 'replicas', 'readyReplicas', 'updatedReplicas', 'availableReplicas'))),
        'pods': [{'uid': p.get('metadata', {}).get('uid'), 'conditions': observed_conditions(p),
                  'containers': [observed_container(c) for c in p.get('status', {}).get('containerStatuses', [])]}
                 for p in state['pods']]}


def candidate_failure_summary(candidate, current):
    flux, dep = current.get('flux', {}), current.get('deployment', {})
    reasons = [c.get('reason', '') for c in flux.get('conditions', []) if c.get('status') == 'False']
    image_ids = [c.get('imageID', '') for p in current.get('pods', []) for c in p.get('containers', [])]
    return (f"; expected revision {candidate['expected_revision']}, image {candidate['desired_image']}, "
            f"digest {candidate['registry_evidence']['runtime_manifest_digest']}; "
            f"actual applied {flux.get('lastAppliedRevision')}, attempted {flux.get('lastAttemptedRevision')}, "
            f"image {dep.get('image')}, imageIDs {image_ids}, health reasons {reasons}")


def validate_candidate(candidate, observation):
    require(observation['flux']['revision'] == candidate['expected_revision'], f"candidate revision mismatch: actual {observation['flux']['revision']}, expected {candidate['expected_revision']}")
    require(observation['deployment']['image'] == candidate['desired_image'], f"candidate image mismatch: actual {observation['deployment']['image']}, expected {candidate['desired_image']}")
    expected_digest = candidate['registry_evidence']['runtime_manifest_digest']
    require(observation['digests'] == [expected_digest], f"candidate digest mismatch: actual {observation['digests']}, expected {expected_digest}")
    for pod in observation['pods']:
        require('@' in pod['image_id'], f"candidate runtime imageID {pod['image_id']} is opaque; registry manifest comparison unavailable")
        repository = candidate['desired_image'].rsplit(':', 1)[0]
        actual_repository = pod['image_id'].split('://')[-1].split('@')[0]
        require(actual_repository == repository, f'candidate runtime image repository mismatch: actual {actual_repository}, expected {repository}')

def persist(directory, receipt, filename='latest.json', first_only=False):
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', dir=directory, prefix='.latest-', delete=False) as output:
            temporary = Path(output.name)
            json.dump(receipt, output, sort_keys=True)
            output.write('\n')
            output.flush()
            os.fsync(output.fileno())
        if first_only:
            try:
                os.link(temporary, directory / filename)
            except FileExistsError:
                pass
            temporary.unlink()
        else:
            os.replace(temporary, directory / filename)
        temporary = None
        descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--once', action='store_true', required=True)
    parser.add_argument('--context', required=True)
    parser.add_argument('--state-dir', type=Path, required=True)
    parser.add_argument('--flux-namespace', default='flux-system')
    parser.add_argument('--kustomization', default='autodeploy-canary')
    parser.add_argument('--namespace', default='agent-school')
    parser.add_argument('--deployment', default='autodeploy-canary')
    parser.add_argument('--container', default='canary')
    parser.add_argument('--candidate-file', type=Path, help='explicit trusted operator candidate (root or invoking user owned)')
    args = parser.parse_args()
    receipt = {'schema_version': 1, 'mode': 'current-observation', 'verified_release': False,
               'observed_at': datetime.now(timezone.utc).isoformat(), 'context': args.context,
               'target': {'flux_namespace': args.flux_namespace, 'kustomization': args.kustomization,
                          'namespace': args.namespace, 'deployment': args.deployment, 'container': args.container}}
    candidate = None
    candidate_path = args.candidate_file or DEFAULT_CANDIDATE
    if args.candidate_file is not None or candidate_path.exists() or candidate_path.is_symlink():
        receipt['mode'] = 'candidate-verification'
    try:
        candidate = load_candidate(candidate_path, args, explicit=args.candidate_file is not None)
        if candidate is not None:
            receipt.update(mode='candidate-verification', candidate_id=candidate_id(candidate), candidate=candidate)
        first = snapshot(args)
        receipt['observed'] = observed(first, args)
        receipt['observation'] = validate(first, args)
        second = snapshot(args)
        validate(second, args)
        require(first == second, 'canary resources changed during observation; retry after reconciliation settles')
        if candidate is not None:
            validate_candidate(candidate, receipt['observation'])
        final_candidate = load_candidate(candidate_path, args, explicit=args.candidate_file is not None)
        require(candidate == final_candidate, 'candidate changed during observation; retry')
        receipt['status'] = 'verified' if candidate is not None else 'observed'
        receipt['verified_release'] = candidate is not None
        code = 0
    except (ObservationError, OSError, KeyError, TypeError, AttributeError) as exc:
        receipt.update(status='failed', verified_release=False, error=str(exc) or type(exc).__name__)
        if candidate is not None:
            receipt['error'] += candidate_failure_summary(candidate, receipt.get('observed', {}))
        code = 1
    try:
        if 'candidate_id' in receipt:
            persist(args.state_dir / 'candidates', receipt, receipt['candidate_id'] + '.json')
        persist(args.state_dir, receipt)
        if receipt['verified_release']:
            persist(args.state_dir / 'verified', receipt, receipt['candidate_id'] + '.json', first_only=True)
    except OSError as exc:
        receipt.update(status='failed', verified_release=False, error=f'cannot persist receipt: {exc}')
        code = 1
    print(json.dumps(receipt, sort_keys=True))
    return code


if __name__ == '__main__':
    sys.exit(main())
