#!/bin/sh
set -eu
agent_dir=$HOME/.pi/agent
if ! IFS= read -r version < "$agent_dir/install/current-version"; then
  printf '%s\n' 'pi-team: could not read the managed Pi version.' >&2
  exit 1
fi
case "$version" in
  ''|.|..|*[!0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz._+-]*)
    printf '%s\n' 'pi-team: invalid managed Pi version.' >&2
    exit 1 ;;
esac
examples=$agent_dir/install/releases/$version/node_modules/@earendil-works/pi-coding-agent/examples/extensions
launcher=$(readlink -f -- "$0")
team_dir=${launcher%/*}/../team
subagent_source=$examples/subagent/index.ts
todo=$examples/todo.ts
policy=$team_dir/workflow.md
if [ ! -r "$subagent_source" ] || [ ! -r "$todo" ] || [ ! -r "$policy" ] || [ ! -r "$team_dir/prepare-subagent.py" ] || [ ! -r "$team_dir/subagent-watchdog.mjs" ] || [ ! -r "$team_dir/subagent-blockers.mjs" ] || [ ! -r "$team_dir/team-health.mjs" ] || [ ! -r "$team_dir/worktree-activity.mjs" ] || [ ! -d "$agent_dir/agents" ] || [ ! -r "$agent_dir/extensions/agy-worker.ts" ]; then
  printf '%s\n' 'pi-team: missing AGY worker extension, bundled subagent or todo example, workflow policy, or role definitions.' >&2
  exit 1
fi
subagent=$(python3 -I "$team_dir/prepare-subagent.py" "$subagent_source" "$agent_dir/install/team-cache")
unset PI_TEAM_TASK_PICKER
case "$#:${1-}" in
  0:|1:-c|1:--continue|1:-r|1:--resume) export PI_TEAM_TASK_PICKER=1 ;;
esac
exec "$agent_dir/bin/pi" --extension "$subagent" --extension "$todo" --append-system-prompt "$policy" --agy-team "$@"
