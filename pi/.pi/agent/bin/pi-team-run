V1_SCHEMA = (
    """
    CREATE TABLE runs (
        run_id TEXT PRIMARY KEY,
        repo_key TEXT NOT NULL,
        status TEXT NOT NULL CHECK (status IN ('active', 'waiting', 'completed', 'cancelled')),
        current_stage TEXT,
        wait_generation INTEGER NOT NULL DEFAULT 0,
        commit_only INTEGER NOT NULL DEFAULT 0 CHECK (commit_only IN (0, 1)),
        no_ci INTEGER NOT NULL DEFAULT 0 CHECK (no_ci IN (0, 1)),
        with_deploy INTEGER NOT NULL DEFAULT 0 CHECK (with_deploy IN (0, 1)),
        with_honcho INTEGER NOT NULL DEFAULT 0 CHECK (with_honcho IN (0, 1)),
        with_wiki INTEGER NOT NULL DEFAULT 0 CHECK (with_wiki IN (0, 1)),
        note TEXT,
        cancelled_stage TEXT,
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL,
        completed_at TEXT
    )
    """,
    """
    CREATE UNIQUE INDEX idx_runs_active_repo
        ON runs(repo_key)
        WHERE status IN ('active', 'waiting')
    """,
    """
    CREATE TABLE checkpoints (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        run_id TEXT NOT NULL REFERENCES runs(run_id),
        stage TEXT NOT NULL,
        disposition TEXT NOT NULL CHECK (disposition IN ('completed', 'skipped')),
        evidence TEXT NOT NULL,
        rev TEXT,
        note TEXT,
        created_at TEXT NOT NULL,
        UNIQUE(run_id, stage)
    )
    """,
    """
    CREATE TABLE waits (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        run_id TEXT NOT NULL REFERENCES runs(run_id),
        generation INTEGER NOT NULL,
        stage TEXT NOT NULL,
        target TEXT NOT NULL CHECK (target IN ('coordinator', 'user', 'ci')),
        expected_rev TEXT,
        deadline_at TEXT,
        reason TEXT,
        created_at TEXT NOT NULL,
        resolved_at TEXT,
        resolution TEXT,
        UNIQUE(run_id, generation)
    )
    """,
    """
    CREATE UNIQUE INDEX idx_waits_active_run
        ON waits(run_id)
        WHERE resolved_at IS NULL
    """,
    """
    CREATE TABLE notices (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        run_id TEXT NOT NULL REFERENCES runs(run_id),
        wait_generation INTEGER NOT NULL,
        stage TEXT NOT NULL,
        target TEXT NOT NULL CHECK (target IN ('coordinator', 'user')),
        wait_target TEXT NOT NULL CHECK (wait_target IN ('coordinator', 'user', 'ci')),
        reason TEXT NOT NULL,
        payload_json TEXT NOT NULL,
        emitted_at TEXT NOT NULL,
        UNIQUE(run_id, wait_generation)
    )
    """,
    """
    CREATE TABLE events (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        run_id TEXT NOT NULL REFERENCES runs(run_id),
        event_type TEXT NOT NULL,
        stage TEXT,
        detail TEXT,
        created_at TEXT NOT NULL
    )
    """,
)


V2_MIGRATION = (
    'ALTER TABLE runs ADD COLUMN issue TEXT',
    'ALTER TABLE runs ADD COLUMN worktree TEXT',
    'ALTER TABLE runs ADD COLUMN reserved INTEGER NOT NULL DEFAULT 0 CHECK (reserved IN (0, 1))',
    'DROP INDEX idx_runs_active_repo',
    """CREATE TRIGGER exclusive_unscoped_start BEFORE INSERT ON runs
       WHEN NEW.status IN ('active', 'waiting') AND EXISTS (
           SELECT 1 FROM runs WHERE repo_key = NEW.repo_key AND status IN ('active', 'waiting')
           AND (issue IS NULL OR NEW.issue IS NULL))
       BEGIN SELECT RAISE(ABORT, 'repository has an exclusive run'); END""",
    """CREATE UNIQUE INDEX idx_active_issue ON runs(repo_key, COALESCE(issue, ''))
       WHERE status IN ('active', 'waiting')""",
    """CREATE UNIQUE INDEX idx_active_worktree ON runs(worktree)
       WHERE status IN ('active', 'waiting')""",
    'CREATE UNIQUE INDEX idx_repo_reservation ON runs(repo_key) WHERE reserved = 1',
)


V3_MIGRATION = (
    """
    CREATE TABLE writer_attempts (
        attempt_id TEXT PRIMARY KEY,
        repo_key TEXT NOT NULL,
        worktree TEXT NOT NULL,
        issue TEXT NOT NULL,
        bound INTEGER NOT NULL CHECK (bound IN (0, 1)),
        run_id TEXT REFERENCES runs(run_id),
        status TEXT NOT NULL CHECK (status IN ('open', 'closed')),
        exit_code INTEGER,
        created_at TEXT NOT NULL,
        closed_at TEXT,
        CHECK ((bound = 0 AND run_id IS NULL) OR (bound = 1 AND run_id IS NOT NULL))
    )
    """,
    "CREATE UNIQUE INDEX idx_writer_attempts_unbound ON writer_attempts(repo_key) WHERE status = 'open' AND bound = 0",
    "CREATE UNIQUE INDEX idx_writer_attempts_issue ON writer_attempts(repo_key, issue) WHERE status = 'open'",
    "CREATE UNIQUE INDEX idx_writer_attempts_worktree ON writer_attempts(worktree) WHERE status = 'open'",
    """
    CREATE TRIGGER writer_fence_before_run_insert BEFORE INSERT ON runs
    WHEN NEW.status IN ('active', 'waiting') AND EXISTS (
        SELECT 1 FROM writer_attempts w
        WHERE w.status = 'open'
          AND w.repo_key = NEW.repo_key
          AND (
              w.bound = 0
              OR NEW.issue IS NULL
              OR w.issue = NEW.issue
              OR (NEW.worktree IS NOT NULL AND w.worktree = NEW.worktree)
          )
    )
    BEGIN
        SELECT RAISE(ABORT, 'writer fence active for repository');
    END
    """,
)


class CliError(Exception):
    """Domain or validation error surfaced cleanly to stderr."""


def utc_now() -> datetime:
    """Return current UTC datetime."""
    return datetime.now(timezone.utc)


def format_utc(dt: datetime) -> str:
    """Format a timezone-aware datetime as a UTC ISO-8601 string."""
    return dt.astimezone(timezone.utc).isoformat().replace('+00:00', 'Z')


def parse_iso_utc(raw: str) -> datetime:
    """Parse an ISO-8601 timestamp with explicit timezone offset or Z."""
    text = raw.strip()
    if not text:
        raise CliError('timestamp must not be empty')
    if text.endswith(('Z', 'z')):
        text = text[:-1] + '+00:00'
    try:
        dt = datetime.fromisoformat(text)
    except ValueError as exc:
        raise CliError(f'invalid ISO-8601 timestamp: {raw}') from exc
    if dt.tzinfo is None or dt.utcoffset() is None:
        raise CliError(f'timestamp must include timezone offset or Z: {raw}')
    return dt.astimezone(timezone.utc)


def validate_stage(stage: str) -> str:
    """Ensure stage is a known pipeline stage."""
    if stage not in STAGES:
        raise CliError(f'unknown stage {stage!r}; valid stages: {", ".join(STAGES)}')
    return stage


def validate_full_rev(rev: str) -> str:
    """Validate and normalize a full 40- or 64-character hexadecimal git revision."""
    text = rev.strip()
    if not REV_RE.fullmatch(text):
        raise CliError('CI revision must be a full 40- or 64-character hex SHA')
    return text.lower()


def validate_evidence(evidence: str) -> str:
    """Validate an opaque nonsecret evidence locator token."""
    text = evidence.strip()
    if not text:
        raise CliError('evidence token must not be empty')
    if len(text) > 512:
        raise CliError('evidence token exceeds 512 characters')
    if any(ch in text for ch in ('\n', '\r', '\x00')):
        raise CliError('evidence token must be a single line without control characters')
    for prefix in SECRET_PREFIXES:
        if prefix in text:
            raise CliError(f'evidence token must be a nonsecret locator (rejected {prefix!r})')
    return text


def _clean_git_env() -> dict[str, str]:
    """Return a clean environment for read-only Git identity queries."""
    env = {
        k: v
        for k, v in os.environ.items()
        if not k.startswith('GIT_') and k not in GIT_ENV_OVERRIDES
    }
    env['GIT_CONFIG_NOSYSTEM'] = '1'
    env['GIT_CONFIG_GLOBAL'] = '/dev/null'
    env['GIT_TERMINAL_PROMPT'] = '0'
    return env


def _has_purported_git_metadata(path: Path) -> bool:
    """Return True if path or any ancestor carries Git repository metadata."""
    for cur in (path, *path.parents):
        if os.path.lexists(cur / '.git') or cur.name == '.git':
            return True
    return (path / 'HEAD').is_file() and (path / 'objects').is_dir()


def canonicalize_repo(repo: str, *, git_bin: str = 'git') -> str:
    """Canonicalize a repository path via real Git common-dir, failing closed on lookup errors."""
    raw = repo.strip()
    if not raw:
        raise CliError('repository argument must not be empty')
    expanded = os.path.expanduser(raw)
    is_path = (
        raw in ('.', '..')
        or raw.startswith(('/', './', '../', '~/'))
        or os.path.exists(expanded)
        or os.path.lexists(expanded)
    )
    if is_path:
        if not os.path.exists(expanded):
            raise CliError(f'repository path does not exist or is unresolvable: {repo!r}')
        real = os.path.realpath(expanded)
        probe = real if os.path.isdir(real) else os.path.dirname(real)
        if not probe or not os.path.isdir(probe):
            raise CliError(f'unable to resolve repository directory: {repo!r}')
        try:
            proc = subprocess.run(
                [git_bin, '-C', probe, 'rev-parse', '--path-format=absolute', '--git-common-dir'],
                env=_clean_git_env(),
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise CliError(f'git repository identity lookup failed for {repo!r}: {exc}') from None
        if proc.returncode == 0:
            if '\x00' in proc.stdout:
                raise CliError(f'malformed git common-dir output for {repo!r}')
            lines = proc.stdout.splitlines()
            if len(lines) != 1:
                raise CliError(f'malformed git common-dir output for {repo!r}')
            common_dir = lines[0].strip()
            if not common_dir or not os.path.isabs(common_dir) or not os.path.isdir(common_dir):
                raise CliError(f'unresolvable git common-dir output for {repo!r}')
            return os.path.realpath(common_dir)
        is_confirmed_nonrepo = (
            proc.returncode == 128
            and 'not a git repository' in proc.stderr.lower()
            and not _has_purported_git_metadata(Path(probe))
        )
        if not is_confirmed_nonrepo:
            raise CliError(f'unable to resolve git repository identity for {repo!r} (exit {proc.returncode})')
        return real
    cleaned = raw.rstrip('/')
    if not cleaned:
        raise CliError(f'invalid repository identifier: {repo!r}')
    return cleaned


def resolve_state_db_path() -> Path:
    """Resolve the private XDG state database path."""
    xdg = os.environ.get('XDG_STATE_HOME', '').strip()
    if xdg:
        base = Path(os.path.expanduser(xdg))
        if not base.is_absolute():
            raise CliError(f'XDG_STATE_HOME must be an absolute path: {xdg!r}')
    else:
        base = Path.home() / '.local' / 'state'
    return base / 'pi-team-run' / 'state.db'


def ensure_private_state_dir(state_dir: Path) -> None:
    """Create the XDG state directory with 0700 permissions."""
    state_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(state_dir, 0o700)


def check_schema_version(conn: sqlite3.Connection, *, allow_init: bool) -> None:
    """Verify PRAGMA user_version or initialize a brand-new database."""
    version = conn.execute('PRAGMA user_version').fetchone()[0]
    if version == SCHEMA_VERSION:
        return
    if version == 0 and allow_init:
        existing = conn.execute(
            "SELECT count(*) FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
        ).fetchone()[0]
        if existing > 0:
            raise CliError('unsupported unversioned SQLite schema (PRAGMA user_version=0)')
        for stmt in V1_SCHEMA:
            conn.execute(stmt)
        version = 1
    if version == 1:
        if not allow_init:
            return
        for stmt in V2_MIGRATION:
            conn.execute(stmt)
        version = 2
    if version == 2:
        if not allow_init:
            return
        for stmt in V3_MIGRATION:
            conn.execute(stmt)
        conn.execute(f'PRAGMA user_version = {SCHEMA_VERSION}')
        return
    raise CliError(f'unsupported SQLite schema version {version}; expected {SCHEMA_VERSION}')


def _verify_ledger_inode(
    db_path: Path,
    *,
    require_exists: bool = False,
    expected_lstat: os.stat_result | None = None,
) -> tuple[int, int] | None:
    """Verify an existing ledger database is a single-link regular file, not a symlink or alias."""
    try:
        st = os.lstat(db_path)
    except FileNotFoundError:
        if require_exists:
            raise CliError(f'writer ledger file missing outside the writable worktree: {db_path}') from None
        return None
    except OSError as exc:
        raise CliError(f'unable to inspect writer ledger file outside the writable worktree: {exc}') from None
    if stat.S_ISLNK(st.st_mode):
        raise CliError(f'writer ledger path must be symlink-free and outside the writable worktree: {db_path}')
    if not stat.S_ISREG(st.st_mode):
        raise CliError(f'writer ledger path must be a regular file outside the writable worktree: {db_path}')
    if st.st_nlink != 1:
        raise CliError(
            f'writer ledger path must not have hardlink aliases outside the writable worktree '
            f'(st_nlink={st.st_nlink}): {db_path}'
        )
    if expected_lstat is not None and (st.st_dev, st.st_ino) != (expected_lstat.st_dev, expected_lstat.st_ino):
        raise CliError(f'writer ledger path changed during validation outside the writable worktree: {db_path}')
    try:
        fd = os.open(db_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        raise CliError(
            f'unable to open writer ledger file for inode check outside the writable worktree: {exc}'
        ) from None
    try:
        fst = os.fstat(fd)
    finally:
        os.close(fd)
    if not stat.S_ISREG(fst.st_mode):
        raise CliError(f'writer ledger path must be a regular file outside the writable worktree: {db_path}')
    if fst.st_nlink != 1:
        raise CliError(
            f'writer ledger path must not have hardlink aliases outside the writable worktree '
            f'(st_nlink={fst.st_nlink}): {db_path}'
        )
    if (fst.st_dev, fst.st_ino) != (st.st_dev, st.st_ino):
        raise CliError(f'writer ledger path changed during validation outside the writable worktree: {db_path}')
    return fst.st_dev, fst.st_ino


@contextmanager
def open_write_tx(db_path: Path):
    """Open a private SQLite connection inside a BEGIN IMMEDIATE transaction."""
    ensure_private_state_dir(db_path.parent)
    _verify_ledger_inode(db_path, require_exists=False)
    conn = sqlite3.connect(str(db_path), timeout=5.0, isolation_level=None)
    conn.row_factory = sqlite3.Row
    try:
        _verify_ledger_inode(db_path, require_exists=True)
        os.chmod(db_path, 0o600)
        conn.execute('PRAGMA busy_timeout = 5000')
        conn.execute('PRAGMA journal_mode = DELETE')
        conn.execute('PRAGMA foreign_keys = ON')
        conn.execute('BEGIN IMMEDIATE')
        check_schema_version(conn, allow_init=True)
        yield conn
        conn.execute('COMMIT')
    except Exception:
        try:
            if conn.in_transaction:
                conn.execute('ROLLBACK')
        except sqlite3.Error:
            pass
        raise
    finally:
        conn.close()


@contextmanager
def open_read_only(db_path: Path):
    """Open an existing SQLite database strictly read-only."""
    conn = sqlite3.connect(f'{db_path.resolve().as_uri()}?mode=ro', uri=True, timeout=5.0, isolation_level=None)
    conn.row_factory = sqlite3.Row
    try:
        conn.execute('PRAGMA busy_timeout = 5000')
        conn.execute('PRAGMA foreign_keys = ON')
        conn.execute('BEGIN')
        check_schema_version(conn, allow_init=False)
        yield conn
    finally:
        conn.close()


def active_stages_for_run(run: sqlite3.Row) -> list[str]:
    """Return the immutable ordered stage list active for a run."""
    enabled = {
        'deploy': bool(run['with_deploy']),
        'honcho': bool(run['with_honcho']),
        'wiki': bool(run['with_wiki']),
    }
    if run['commit_only']:
        stages = list(STAGES[:STAGES.index('commit') + 1])
        for stage in ('honcho', 'wiki'):
            if enabled[stage]:
                stages.append(stage)
        return stages
    return [
        stage for stage in STAGES
        if (stage not in OPTIONAL_STAGES or enabled[stage]) and not (stage == 'ci' and run['no_ci'])
    ]


def next_stage_after(run: sqlite3.Row, stage: str) -> str | None:
    """Return the next active stage after the given stage, or None if terminal."""
    active = active_stages_for_run(run)
    idx = active.index(stage)
    if idx + 1 < len(active):
        return active[idx + 1]
    return None


def fetch_run(conn: sqlite3.Connection, run_id: str) -> sqlite3.Row:
    """Fetch a run row or raise CliError if missing."""
    row = conn.execute('SELECT * FROM runs WHERE run_id = ?', (run_id,)).fetchone()
    if row is None:
        raise CliError(f'run not found: {run_id}')
    return row


def is_dispatcher_owned(conn: sqlite3.Connection, run_id: str) -> bool:
    """Return True if run_id is reserved and owned by pi-team-dispatch."""
    has_table = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='dispatch_runs'"
    ).fetchone()
    if has_table is None:
        return False
    return conn.execute('SELECT 1 FROM dispatch_runs WHERE run_id = ?', (run_id,)).fetchone() is not None


def require_interactive_run(conn: sqlite3.Connection, run_id: str) -> None:
    """Refuse interactive mutations against dispatcher-owned reservation rows."""
    if is_dispatcher_owned(conn, run_id):
        raise CliError(
            f'run {run_id} is owned by pi-team-dispatch; interactive wait/checkpoint/cancel refused'
        )


def fetch_active_wait(conn: sqlite3.Connection, run_id: str) -> sqlite3.Row | None:
    """Fetch the unresolved wait for a run if one exists."""
    return conn.execute(
        'SELECT * FROM waits WHERE run_id = ? AND resolved_at IS NULL',
        (run_id,),
    ).fetchone()


def require_writable_stage(run: sqlite3.Row, stage: str) -> str:
    """Validate stage name, non-terminal status, and exact current stage match."""
    validated = validate_stage(stage)
    if run['status'] in TERMINAL_STATUSES:
        raise CliError(f'run {run["run_id"]} is already terminal ({run["status"]})')
    if run['current_stage'] != validated:
        raise CliError(
            f'stale or out-of-order stage {validated!r} for run {run["run_id"]}; '
            f'current stage is {run["current_stage"]!r}'
        )
    return validated


def build_run_dict(conn: sqlite3.Connection, run: sqlite3.Row) -> dict:
    """Build a serializable snapshot of a run and its durability records."""
    checkpoints = [
        dict(row)
        for row in conn.execute(
            'SELECT stage, disposition, evidence, rev, note, created_at FROM checkpoints WHERE run_id = ? ORDER BY id',
            (run['run_id'],),
        ).fetchall()
    ]
    active_wait_row = fetch_active_wait(conn, run['run_id'])
    notices = [
        json.loads(row['payload_json'])
        for row in conn.execute(
            'SELECT payload_json FROM notices WHERE run_id = ? ORDER BY id',
            (run['run_id'],),
        ).fetchall()
    ]
    return {
        'run_id': run['run_id'],
        'repo_key': run['repo_key'],
        'issue': run['issue'] if 'issue' in run.keys() else None,
        'worktree': run['worktree'] if 'worktree' in run.keys() else None,
        'reserved': bool(run['reserved']) if 'reserved' in run.keys() else False,
        'status': run['status'],
        'current_stage': run['current_stage'],
        'wait_generation': run['wait_generation'],
        'commit_only': bool(run['commit_only']),
        'no_ci': bool(run['no_ci']),
        'optional_stages': {
            'deploy': bool(run['with_deploy']),
            'honcho': bool(run['with_honcho']),
            'wiki': bool(run['with_wiki']),
        },
        'active_stages': active_stages_for_run(run),
        'note': run['note'],
        'cancelled_stage': run['cancelled_stage'],
        'created_at': run['created_at'],
        'updated_at': run['updated_at'],
        'completed_at': run['completed_at'],
        'active_wait': dict(active_wait_row) if active_wait_row is not None else None,
        'checkpoints': checkpoints,
        'notices': notices,
    }


def compute_next_step(
    run: sqlite3.Row,
    active_wait: sqlite3.Row | None,
    now: datetime,
    *,
    dispatcher_owned: bool = False,
) -> dict:
    """Compute the read-only resume guidance for a run without mutating state."""
    run_id = run['run_id']
    if run['status'] in TERMINAL_STATUSES:
        return {
            'run_id': run_id,
            'status': run['status'],
            'current_stage': None,
            'action': 'none',
            'authorized': False,
            'message': f'Run {run_id} is terminal ({run["status"]}); no further action.',
        }
    if dispatcher_owned:
        return {
            'run_id': run_id,
            'status': run['status'],
            'current_stage': run['current_stage'],
            'action': 'dispatcher_managed',
            'authorized': False,
            'message': f'Run {run_id} is managed by pi-team-dispatch; interactive actions are disabled.',
        }
    stage = run['current_stage']
    if active_wait is not None:
        target = active_wait['target']
        if target in ('user', 'coordinator'):
            return {
                'run_id': run_id,
                'status': run['status'],
                'current_stage': stage,
                'action': f'await_{target}',
                'wait_target': target,
                'wait_generation': active_wait['generation'],
                'authorized': False,
                'message': (
                    f'Waiting on {target} at stage {stage!r} (gen {active_wait["generation"]}); '
                    f'resume does not authorize this wait. After explicit {target} approval, '
                    f'{"reserve before shared work, then run" if needs_reservation(run) else "run"} '
                    f'`pi-team-run checkpoint {run_id} {stage} --evidence <locator>` or '
                    f'`pi-team-run cancel {run_id} {stage}`.'
                ),
            }
        deadline = parse_iso_utc(active_wait['deadline_at'])
        overdue = now >= deadline
        return {
            'run_id': run_id,
            'status': run['status'],
            'current_stage': stage,
            'action': 'await_ci',
            'wait_target': 'ci',
            'wait_generation': active_wait['generation'],
            'expected_rev': active_wait['expected_rev'],
            'deadline_at': active_wait['deadline_at'],
            'overdue': overdue,
            'authorized': False,
            'message': (
                f'Waiting on CI for exact revision {active_wait["expected_rev"]} '
                f'(deadline {active_wait["deadline_at"]}, overdue={overdue}). '
                f'Timeout never succeeds; once verified, run '
                f'`pi-team-run checkpoint {run_id} ci --rev {active_wait["expected_rev"]} --evidence <locator>`.'
            ),
        }
    if stage == 'ci':
        return {
            'run_id': run_id,
            'status': run['status'],
            'current_stage': 'ci',
            'action': 'wait_ci',
            'authorized': False,
            'message': (
                f'Stage {stage!r} requires a CI wait first: '
                f'`pi-team-run wait {run_id} ci --target ci --rev <full_sha> --deadline <iso8601>`.'
            ),
        }
    if needs_reservation(run) and not run['reserved']:
        return {'run_id': run_id, 'status': run['status'], 'current_stage': stage, 'action': 'reserve',
                'authorized': False, 'message': f'Before shared work: pi-team-run reserve {run_id} {stage}'}
    hint = f'`pi-team-run checkpoint {run_id} {stage} --evidence <locator>`'
    if stage in OPTIONAL_STAGES:
        hint += f' (or `--skip --evidence <locator>`)'
    return {
        'run_id': run_id,
        'status': run['status'],
        'current_stage': stage,
        'action': 'checkpoint',
        'authorized': False,
        'message': f'Next step for {run_id}: {hint}.',
    }


def scoped_worktree(repo: str, repo_key: str, issue: str, *, git_bin: str = 'git') -> str:
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*-[A-Za-z0-9][A-Za-z0-9.]*', issue) or len(issue) > 128:
        raise CliError('--issue requires the full Beads issue ID')
    root = Path(repo).expanduser().resolve()
    try:
        result = subprocess.run(
            [git_bin, '-C', str(root), 'rev-parse', '--path-format=absolute', '--show-toplevel', '--git-dir'],
            capture_output=True, text=True, env=_clean_git_env(), timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CliError(f'worktree lookup failed: {exc}') from None
    if '\x00' in result.stdout:
        raise CliError('--issue requires the root of a linked Git worktree')
    paths = result.stdout.splitlines()
    if (
        result.returncode != 0
        or len(paths) != 2
        or any(not p or p != p.strip() or not os.path.isabs(p) or not os.path.isdir(p) for p in paths)
        or Path(paths[0]).resolve() != root
        or Path(paths[1]).resolve().parent != Path(repo_key) / 'worktrees'
    ):
        raise CliError('--issue requires the root of a linked Git worktree')
    return str(Path(paths[1]).resolve())


def _same_repo_key(stored: str, repo_key: str, *, git_bin: str = 'git') -> bool:
    """Compare stored run repo_key against canonical repo_key, failing closed if unresolvable."""
    return stored == repo_key or canonicalize_repo(stored, git_bin=git_bin) == repo_key


class _RetryActiveKeys(Exception):
    """Internal sentinel to release a write lock before resolving unfamiliar active keys."""

    def __init__(self, unresolved_keys: set[str]) -> None:
        super().__init__('retry active key resolution')
        self.unresolved_keys = unresolved_keys


@contextmanager
def _open_short_active_write_tx(
    db_path: Path,
    repo_key: str,
    *,
    git_bin: str = 'git',
    max_attempts: int = 8,
):
    """Resolve unfamiliar active repo keys outside BEGIN IMMEDIATE, then yield inside one short write tx."""
    resolved_keys: dict[str, str] = {repo_key: repo_key}
    for _ in range(max_attempts):
        try:
            with open_write_tx(db_path) as conn:
                active_rows = conn.execute(
                    "SELECT run_id, repo_key, status, issue, worktree FROM runs WHERE status IN ('active', 'waiting')"
                ).fetchall()
                missing = {row['repo_key'] for row in active_rows if row['repo_key'] not in resolved_keys}
                if missing:
                    raise _RetryActiveKeys(missing)
                yield conn, active_rows, resolved_keys
                return
        except _RetryActiveKeys as retry:
            for key in sorted(retry.unresolved_keys):
                resolved_keys[key] = canonicalize_repo(key, git_bin=git_bin)
    raise CliError('active repository keys changed repeatedly during admission; retry')


def _check_writer_fence_for_start(
    conn: sqlite3.Connection,
    repo_key: str,
    issue: str | None,
    worktree: str | None,
) -> None:
    """Reject run admission if an open writer attempt conflicts with the requested scope."""
    open_attempts = conn.execute(
        "SELECT attempt_id, repo_key, worktree, issue, bound FROM writer_attempts WHERE status = 'open'"
    ).fetchall()
    for att in open_attempts:
        same_repo = att['repo_key'] == repo_key
        same_worktree = worktree is not None and att['worktree'] == worktree
        if not same_repo and not same_worktree:
            continue
        if not att['bound']:
            raise CliError(
                f'writer fence active for {repo_key}: unbound writer attempt {att["attempt_id"]} in {att["worktree"]}'
            )
        if issue is None:
            raise CliError(
                f'writer fence active for {repo_key}: scoped writer attempt {att["attempt_id"]} ({att["issue"]})'
            )
        if att['issue'] == issue:
            raise CliError(
                f'writer fence active for {repo_key}: writer attempt {att["attempt_id"]} already open for issue {issue}'
            )
        if same_worktree:
            raise CliError(
                f'writer fence active for {repo_key}: writer attempt {att["attempt_id"]} already open in worktree {worktree}'
            )


def cmd_start(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Start a new active pipeline run for a repository."""
    if args.commit_only and (args.no_ci or args.with_deploy):
        raise CliError('--commit-only cannot be combined with --no-ci or --with-deploy')
    repo_key = canonicalize_repo(args.repo, git_bin=TRUSTED_GIT_BIN)
    worktree = scoped_worktree(args.repo, repo_key, args.issue, git_bin=TRUSTED_GIT_BIN) if args.issue is not None else None
    now = format_utc(utc_now())
    run_id = args.run_id or f'run-{utc_now().strftime("%Y%m%dT%H%M%SZ")}-{secrets.token_hex(4)}'
    with _open_short_active_write_tx(db_path, repo_key, git_bin=TRUSTED_GIT_BIN) as (conn, active_rows, resolved_keys):
        _check_writer_fence_for_start(conn, repo_key, args.issue, worktree)
        for existing in active_rows:
            if resolved_keys[existing['repo_key']] == repo_key:
                if (existing['repo_key'] == repo_key and args.issue and existing['issue'] and args.issue != existing['issue']
                        and worktree != existing['worktree']):
                    continue
                raise CliError(
                    f'active run already exists for {repo_key}: {existing["run_id"]} ({existing["status"]})'
                )
        try:
            conn.execute(
                """
                INSERT INTO runs (
                    run_id, repo_key, issue, worktree, status, current_stage, wait_generation,
                    commit_only, no_ci, with_deploy, with_honcho, with_wiki, note, created_at, updated_at
                ) VALUES (?, ?, ?, ?, 'active', ?, 0, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    run_id,
                    repo_key,
                    args.issue,
                    worktree,
                    STAGES[0],
                    int(args.commit_only),
                    int(args.no_ci),
                    int(bool(args.with_deploy)),
                    int(bool(args.with_honcho)),
                    int(bool(args.with_wiki)),
                    args.note,
                    now,
                    now,
                ),
            )
        except sqlite3.IntegrityError as exc:
            raise CliError(f'cannot start run for {repo_key}: {exc}') from exc
        conn.execute(
            'INSERT INTO events (run_id, event_type, stage, detail, created_at) VALUES (?, ?, ?, ?, ?)',
            (run_id, 'start', STAGES[0], args.note, now),
        )
        run = fetch_run(conn, run_id)
        payload = build_run_dict(conn, run)
    return 0, payload


def cmd_status(args: argparse.Namespace, db_path: Path) -> tuple[int, dict | list]:
    """Inspect one run or list active/all runs without writing."""
    if not db_path.exists():
        if args.run_id:
            raise CliError(f'run not found: {args.run_id}')
        return 0, []
    with open_read_only(db_path) as conn:
        if args.run_id:
            run = fetch_run(conn, args.run_id)
            return 0, build_run_dict(conn, run)
        query = 'SELECT * FROM runs'
        if not args.all:
            query += " WHERE status IN ('active', 'waiting')"
        query += ' ORDER BY created_at ASC'
        rows = conn.execute(query).fetchall()
        return 0, [build_run_dict(conn, row) for row in rows]


def cmd_discover(args: argparse.Namespace, db_path: Path) -> tuple[int, list]:
    """List only this Git repository's unfinished runs; never initialize or migrate the ledger."""
    checkout = Path(args.checkout).resolve()
    key = canonicalize_repo(str(checkout))
    if not (Path(key) / 'HEAD').is_file() or not (Path(key) / 'objects').is_dir():
        raise CliError('startup discovery requires a Git checkout')
    if not db_path.exists():
        return 0, []
    result = []
    with open_read_only(db_path) as conn:
        for row in conn.execute("SELECT * FROM runs WHERE status IN ('active', 'waiting') ORDER BY created_at"):
            stored = row['repo_key']
            if stored != key:
                if not os.path.exists(stored) or canonicalize_repo(stored) != key:
                    continue
            issue = row['issue'] if 'issue' in row.keys() else None
            root = None
            if issue and row['worktree']:
                admin = Path(row['worktree'])
                if admin.parent == Path(key) / 'worktrees':
                    try:
                        gitfile = (admin / (admin / 'gitdir').read_text().rstrip('\n')).resolve(strict=True)
                        if gitfile.name == '.git' and scoped_worktree(str(gitfile.parent), key, issue) == str(admin):
                            root = str(gitfile.parent)
                    except (OSError, ValueError, CliError):
                        pass
            result.append({'run_id': row['run_id'], 'issue': issue, 'worktree': root,
                           'stage': row['current_stage'], 'status': row['status']})
    return 0, result


def cmd_resume(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Show the next required step for a run without making any state changes."""
    if not db_path.exists():
        raise CliError(f'run not found: {args.run_id}')
    now = utc_now()
    with open_read_only(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        active_wait = fetch_active_wait(conn, run['run_id'])
        return 0, compute_next_step(
            run, active_wait, now, dispatcher_owned=is_dispatcher_owned(conn, run['run_id'])
        )


def cmd_wait(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Place the current stage of a run into an explicit coordinator, user, or CI wait."""
    stage = validate_stage(args.stage)
    target = args.target
    if stage == 'ci' and target != 'ci':
        raise CliError('stage "ci" requires --target ci')
    if target == 'ci' and stage != 'ci':
        raise CliError('--target ci is only valid for stage "ci"')
    expected_rev: str | None = None
    deadline_iso: str | None = None
    if target == 'ci':
        if not args.rev:
            raise CliError('CI wait requires --rev with full hexadecimal revision')
        if not args.deadline:
            raise CliError('CI wait requires --deadline with ISO-8601 timestamp')
        expected_rev = validate_full_rev(args.rev)
        deadline_iso = format_utc(parse_iso_utc(args.deadline))
    else:
        if args.rev:
            raise CliError('--rev is only valid for CI waits')
        if args.deadline:
            deadline_iso = format_utc(parse_iso_utc(args.deadline))

    now = format_utc(utc_now())
    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, run['run_id'])
        require_writable_stage(run, stage)
        active_wait = fetch_active_wait(conn, run['run_id'])
        if active_wait is not None:
            if not args.replace:
                raise CliError(
                    f'run {run["run_id"]} already has an active wait on {active_wait["stage"]!r} '
                    f'(gen {active_wait["generation"]}); pass --replace to supersede it'
                )
            conn.execute(
                'UPDATE waits SET resolved_at = ?, resolution = ? WHERE id = ?',
                (now, 'superseded', active_wait['id']),
            )
        new_gen = int(run['wait_generation']) + 1
        conn.execute(
            """
            INSERT INTO waits (
                run_id, generation, stage, target, expected_rev, deadline_at, reason, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (run['run_id'], new_gen, stage, target, expected_rev, deadline_iso, args.reason, now),
        )
        conn.execute(
            "UPDATE runs SET status = 'waiting', wait_generation = ?, updated_at = ? WHERE run_id = ?",
            (new_gen, now, run['run_id']),
        )
        conn.execute(
            'INSERT INTO events (run_id, event_type, stage, detail, created_at) VALUES (?, ?, ?, ?, ?)',
            (run['run_id'], 'wait', stage, f'target={target} gen={new_gen}', now),
        )
        updated = fetch_run(conn, run['run_id'])
        payload = build_run_dict(conn, updated)
    return 0, payload


def needs_reservation(run: sqlite3.Row) -> bool:
    return ('issue' in run.keys() and run['issue'] is not None and
            (run['current_stage'] in SHARED_STAGES or (run['no_ci'] and run['current_stage'] == 'publish')))


def cmd_reserve(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, args.run_id)
        require_writable_stage(run, args.stage)
        if not run['issue'] or args.stage == 'ci':
            raise CliError('reserve requires an issue-scoped run outside PR CI')
        owner = conn.execute('SELECT run_id FROM runs WHERE repo_key = ? AND reserved = 1',
                             (run['repo_key'],)).fetchone()
        if owner and owner['run_id'] != args.run_id:
            raise CliError(f'repository reserved by {owner["run_id"]}; retry before any shared operation')
        conn.execute('UPDATE runs SET reserved = 1 WHERE run_id = ?', (args.run_id,))
        return 0, build_run_dict(conn, fetch_run(conn, args.run_id))


def cmd_checkpoint(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Record a stage checkpoint with required evidence and advance the pipeline."""
    stage = validate_stage(args.stage)
    evidence = validate_evidence(args.evidence)
    if args.skip and stage not in OPTIONAL_STAGES:
        raise CliError(f'stage {stage!r} is required and cannot be skipped')
    provided_rev = validate_full_rev(args.rev) if args.rev else None
    disposition = 'skipped' if args.skip else 'completed'
    now = format_utc(utc_now())

    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, run['run_id'])
        require_writable_stage(run, stage)
        active_wait = fetch_active_wait(conn, run['run_id'])
        if needs_reservation(run) and not run['reserved'] and not args.skip:
            raise CliError(f'reserve {args.run_id} {stage} before shared operations')
        generation = getattr(args, 'generation', None)
        if generation is not None and (active_wait is None or active_wait['generation'] != generation):
            raise CliError('CI wait changed during monitoring; refusing to checkpoint')
        if stage == 'ci':
            if active_wait is None or active_wait['target'] != 'ci' or active_wait['stage'] != 'ci':
                raise CliError('CI checkpoint requires an active CI wait first')
            if provided_rev is None:
                raise CliError('CI checkpoint requires --rev matching the waited full revision')
            if provided_rev != active_wait['expected_rev']:
                raise CliError(
                    f'CI revision mismatch: waited {active_wait["expected_rev"]}, got {provided_rev}'
                )
        if active_wait is not None:
            conn.execute(
                'UPDATE waits SET resolved_at = ?, resolution = ? WHERE id = ?',
                (now, disposition, active_wait['id']),
            )
        conn.execute(
            """
            INSERT INTO checkpoints (run_id, stage, disposition, evidence, rev, note, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            """,
            (run['run_id'], stage, disposition, evidence, provided_rev, args.note, now),
        )
        nxt = next_stage_after(run, stage)
        if run['reserved'] and nxt not in LANDING_STAGES:
            conn.execute('UPDATE runs SET reserved = 0 WHERE run_id = ?', (run['run_id'],))
        if nxt is None:
            conn.execute(
                """
                UPDATE runs
                SET status = 'completed', current_stage = NULL, updated_at = ?, completed_at = ?
                WHERE run_id = ?
                """,
                (now, now, run['run_id']),
            )
        else:
            conn.execute(
                """
                UPDATE runs
                SET status = 'active', current_stage = ?, updated_at = ?
                WHERE run_id = ?
                """,
                (nxt, now, run['run_id']),
            )
        conn.execute(
            'INSERT INTO events (run_id, event_type, stage, detail, created_at) VALUES (?, ?, ?, ?, ?)',
            (run['run_id'], f'checkpoint:{disposition}', stage, evidence, now),
        )
        updated = fetch_run(conn, run['run_id'])
        payload = build_run_dict(conn, updated)
    return 0, payload


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def forgejo_get(host: str, repo: str, path: str):
    token = os.environ.get('PI_TEAM_FORGEJO_TOKEN')
    if not token and host == 'git.butakov.su':
        token_file = Path.home() / '.config/forgejo/token'
        if token_file.is_file():
            token = token_file.read_text().strip()
    headers = {'Accept': 'application/json'}
    if token:
        headers['Authorization'] = f'token {token}'
    request = Request(f'https://{host}/api/v1/repos/{repo}/{path}', headers=headers)
    with build_opener(NoRedirect()).open(request, timeout=8) as response:
        return json.load(response)


def check_required(statuses: list, required: list[str]) -> tuple[list[str], list[str]]:
    by_context = {}
    for entry in statuses:
        by_context.setdefault(entry['context'], entry['status'])
    waiting = [name for name in required if by_context.get(name) in (None, 'pending', 'running')]
    failed = [name for name in required if name not in waiting and by_context[name] != 'success']
    return waiting, failed


WATCH_PREFIX = 'forgejo-ci-v1:'


DELIVERY_PROFILES = {
    ('git.butakov.su', 'nevalions/frontend-angular-signals'): {
        'base': 'master',
        'pr_checks': [f'CI / {name} (pull_request)' for name in
                      ('lint', 'typecheck', 'test', 'build', 'quality-gate')] +
                     [f'security-pr / {name} (pull_request)' for name in ('semgrep', 'gitleaks', 'trivy-fs')],
        'push_checks': ['CI / quality-gate (push)', 'CI / publish-image (push)'],
        'merge': {'mechanism': 'Forgejo server-side squash', 'entrypoint': 'scripts/ship.sh'},
        'artifact': {'repository': 'docker.butakov.su/library/statsboards-frontend',
                     'revision_label': 'org.opencontainers.image.revision'},
        'deploy': {
            'dev': {'mechanism': 'kube-lvl47 auto-deploy PR and Flux', 'namespace': 'stats-dev',
                    'hosts': ['butakov.su']},
            'prod': {'mechanism': 'separately authorized kube-lvl47 pin PR and Flux', 'namespace': 'stats-prod',
                     'hosts': ['statsboard.online', 'statsboard.ru']},
        },
        'rollout_evidence': ['authorized environment and GitOps revision applied by Flux',
                             'published image digest tied to the exact application merge SHA',
                             'ready serving pods running that digest in the target environment',
                             'served asset and affected route checks on the target public host'],
    },
}


def get_delivery_profile(host, repo):
    profile = DELIVERY_PROFILES.get((host, repo))
    if profile is None:
        raise CliError('no delivery profile for this Forgejo host and repository')
    return profile


def cmd_delivery_profile(args: argparse.Namespace, _db_path: Path) -> tuple[int, dict]:
    profile = get_delivery_profile(args.host, args.repo)
    return 0, {'host': args.host, 'repo': args.repo, **profile, 'grants_authority': False}


def cmd_monitor(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    queue = getattr(args, 'queue', False)
    once = getattr(args, 'once', False)
    if queue and (not args.run_id or args.pr is None or args.host != 'git.butakov.su'):
        raise CliError('--queue requires --run-id, --pr and the configured git.butakov.su host')
    rev = validate_full_rev(args.rev)
    host = urlsplit(f'https://{args.host}')
    if host.netloc != args.host or not re.fullmatch(r'[A-Za-z0-9.-]+(?::[0-9]+)?', args.host):
        raise CliError('invalid Forgejo host')
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', args.repo) or any(
        component in ('.', '..') for component in args.repo.split('/')
    ):
        raise CliError('expected Forgejo repository as owner/name')
    if args.pr is not None and args.pr < 1:
        raise CliError('expected positive PR number')
    if not 1 <= args.interval <= 120 or not 1 <= args.timeout <= 7200:
        raise CliError('interval must be 1–120 seconds and timeout 1–7200 seconds')
    profile = get_delivery_profile(args.host, args.repo) if getattr(args, 'profile', False) else None
    if profile and args.require and not getattr(args, 'watch_generation', None):
        raise CliError('use either --profile or --require, not both')
    required = sorted(set(profile['pr_checks' if args.pr else 'push_checks'] if profile else (args.require or [])))
    if profile and args.require and required != args.require:
        raise CliError('queued delivery profile checks changed; register a new wait')
    if not required or any(not name.strip() or len(name) > 256 or not name.isprintable() for name in required):
        raise CliError('invalid required check context')
    scope_parts = [args.host, args.repo, args.pr, required]
    queue_parts = [args.repo, args.pr, required]
    if profile:
        scope_parts.append(profile['base'])
        queue_parts.append(profile['base'])
        if getattr(args, 'queued_base', profile['base']) != profile['base']:
            raise CliError('queued delivery profile base changed; register a new wait')
    scope = sha256(json.dumps(scope_parts).encode()).hexdigest()
    reason = f'Forgejo {args.repo} PR {args.pr} monitor:{scope}'
    queued_reason = WATCH_PREFIX + json.dumps(queue_parts, separators=(',', ':'))
    if queue:
        reason = queued_reason
    deadline = utc_now() + timedelta(seconds=args.timeout)
    generation = None
    if args.run_id:
        if args.pr is None:
            raise CliError('ledger CI monitoring requires --pr; post-merge monitoring is read-only')
        with open_read_only(db_path) as conn:
            run = fetch_run(conn, args.run_id)
            require_interactive_run(conn, run['run_id'])
            require_writable_stage(run, 'ci')
            existing = fetch_active_wait(conn, args.run_id)
        watch_generation = getattr(args, 'watch_generation', None)
        if watch_generation is not None and (existing is None or existing['generation'] != watch_generation):
            raise CliError('queued CI wait was superseded')
        if existing is None:
            cmd_wait(argparse.Namespace(run_id=args.run_id, stage='ci', target='ci', rev=rev,
                                      deadline=format_utc(deadline), reason=reason,
                                      replace=False), db_path)
            with open_read_only(db_path) as conn:
                existing = fetch_active_wait(conn, args.run_id)
        if (existing is None or existing['target'] != 'ci' or existing['expected_rev'] != rev
                or (existing['reason'] != reason and not (
                    not queue and args.host == 'git.butakov.su' and existing['reason'] == queued_reason
                ))):
            raise CliError('active CI wait does not match this revision, PR and required check set')
        generation = existing['generation']
        deadline = min(deadline, parse_iso_utc(existing['deadline_at']))
    if queue:
        return 0, {'status': 'queued', 'revision': rev, 'checks': required, 'run_id': args.run_id}

    def check_head():
        if args.pr is None:
            if profile:
                branch = forgejo_get(args.host, args.repo, f"branches/{quote(profile['base'], safe='')}")
                if branch['commit']['id'] != rev:
                    raise CliError('profile base tip does not match the expected merged revision')
            return
        pr = forgejo_get(args.host, args.repo, f'pulls/{args.pr}')
        if pr['state'] != 'open' or pr.get('draft') or pr['head']['sha'] != rev:
            raise CliError('PR is not ready/open at the expected revision; CI evidence is stale')
        if profile and (pr['base']['ref'] != profile['base'] or pr['base']['repo']['full_name'] != args.repo):
            raise CliError('PR target does not match the delivery profile base')

    while utc_now() < deadline:
        try:
            check_head()
            statuses = forgejo_get(args.host, args.repo, f'commits/{quote(rev)}/status')
            if statuses.get('sha') != rev:
                raise CliError('Forgejo status response does not match the expected revision')
            waiting, failed = check_required(statuses['statuses'], required)
            if failed:
                raise CliError('required CI did not pass: ' + ', '.join(failed))
            if not waiting and utc_now() < deadline:
                check_head()
                if utc_now() >= deadline:
                    break
                if args.run_id:
                    cmd_checkpoint(argparse.Namespace(run_id=args.run_id, stage='ci', rev=rev, skip=False,
                                                      note=None, generation=generation,
                                                      evidence=f'forgejo:{args.host}/{args.repo}#{args.pr}@{rev}'), db_path)
                return 0, {'status': 'success', 'revision': rev, 'checks': required, 'run_id': args.run_id}
        except HTTPError as exc:
            if exc.code not in (429, 500, 502, 503, 504):
                raise CliError(f'Forgejo lookup failed (HTTP {exc.code})') from None
        except (URLError, TimeoutError):
            pass
        except (ValueError, TypeError, KeyError):
            raise CliError('invalid Forgejo response; required CI is unverified') from None
        if once:
            return 0, {'status': 'pending'}
        time.sleep(max(0, min(args.interval, (deadline - utc_now()).total_seconds())))
    raise CliError('CI monitoring deadline reached; required checks remain unverified')


def _validate_writer_bwrap_argv(cmd_argv: list[str], cwd: str) -> tuple[str, list[str], list[str]]:
    """Validate exact required bwrap isolation flags and extract payload argv."""
    if not cmd_argv or cmd_argv[0] not in ('bwrap', TRUSTED_BWRAP_BIN):
        raise CliError('writer-exec requires bwrap command argv')
    bwrap_bin = TRUSTED_BWRAP_BIN
    if not os.path.isabs(bwrap_bin) or not os.access(bwrap_bin, os.X_OK):
        raise CliError('trusted bwrap executable not found or not executable')
    try:
        sep_idx = cmd_argv.index('--', 1)
    except ValueError:
        raise CliError('writer-exec requires `--` separating bwrap flags and payload') from None
    bwrap_flags = cmd_argv[1:sep_idx]
    payload_argv = cmd_argv[sep_idx + 1:]
    if not payload_argv or any(not arg or '\x00' in arg for arg in payload_argv):
        raise CliError('writer-exec requires a valid payload command after `--`')

    resolved_cwd = Path(cwd).resolve()
    has_unshare_pid = False
    has_die_with_parent = False
    has_ro_root = False
    has_bind_cwd = False
    has_dev = False
    has_proc = False
    overlay_src: Path | None = None
    tmp_overlay: Path | None = None

    i = 0
    while i < len(bwrap_flags):
        flag = bwrap_flags[i]
        if flag == '--unshare-pid':
            has_unshare_pid = True
            i += 1
        elif flag == '--die-with-parent':
            has_die_with_parent = True
            i += 1
        elif flag == '--ro-bind':
            if i + 2 >= len(bwrap_flags) or bwrap_flags[i + 1] != '/' or bwrap_flags[i + 2] != '/':
                raise CliError('writer-exec requires exact `--ro-bind / /`')
            has_ro_root = True
            i += 3
        elif flag == '--bind':
            if i + 2 >= len(bwrap_flags):
                raise CliError('writer-exec requires `--bind <cwd> <cwd>`')
            if Path(bwrap_flags[i + 1]).resolve() != resolved_cwd or Path(bwrap_flags[i + 2]).resolve() != resolved_cwd:
                raise CliError('writer-exec `--bind` must target exact worktree root')
            has_bind_cwd = True
            i += 3
        elif flag == '--overlay-src':
            if i + 1 >= len(bwrap_flags) or overlay_src is not None:
                raise CliError('invalid `--overlay-src` in writer-exec')
            overlay_src = Path(bwrap_flags[i + 1]).resolve()
            i += 2
        elif flag == '--tmp-overlay':
            if i + 1 >= len(bwrap_flags) or tmp_overlay is not None:
                raise CliError('invalid `--tmp-overlay` in writer-exec')
            tmp_overlay = Path(bwrap_flags[i + 1]).resolve()
            i += 2
        elif flag == '--dev':
            if i + 1 >= len(bwrap_flags) or bwrap_flags[i + 1] != '/dev':
                raise CliError('writer-exec requires `--dev /dev`')
            has_dev = True
            i += 2
        elif flag == '--proc':
            if i + 1 >= len(bwrap_flags) or bwrap_flags[i + 1] != '/proc':
                raise CliError('writer-exec requires `--proc /proc`')
            has_proc = True
            i += 2
        else:
            raise CliError(f'unsupported or disallowed bwrap flag in writer-exec: {flag!r}')

    if not (has_unshare_pid and has_die_with_parent and has_ro_root and has_bind_cwd and has_dev and has_proc):
        raise CliError('writer-exec requires exact bwrap PID and mount isolation flags')
    if (overlay_src is None) != (tmp_overlay is None):
        raise CliError('writer-exec requires paired `--overlay-src` and `--tmp-overlay`')
    if overlay_src is not None and (overlay_src != tmp_overlay or overlay_src == Path('/') or not overlay_src.is_dir()):
        raise CliError('writer-exec overlay target must be an existing non-root directory')
    return bwrap_bin, bwrap_flags, payload_argv


def _read_bwrap_info(info_r: int, timeout: float = INFO_READ_TIMEOUT_SEC) -> dict:
    """Read bounded JSON metadata from bwrap --info-fd until EOF."""
    os.set_blocking(info_r, False)
    deadline = time.monotonic() + timeout
    chunks: list[bytes] = []
    total = 0
    with selectors.DefaultSelector() as sel:
        sel.register(info_r, selectors.EVENT_READ)
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not sel.select(timeout=remaining):
                raise CliError('bwrap --info-fd timed out before reporting child PID')
            try:
                chunk = os.read(info_r, MAX_INFO_BYTES + 1 - total)
            except BlockingIOError:
                continue
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_INFO_BYTES:
                raise CliError('bwrap --info-fd output exceeded byte limit')
            chunks.append(chunk)
    try:
        info = json.loads(b''.join(chunks).decode('utf-8'))
    except (UnicodeDecodeError, ValueError) as exc:
        raise CliError(f'bwrap --info-fd returned invalid JSON: {exc}') from None
    if not isinstance(info, dict):
        raise CliError('bwrap --info-fd payload must be a JSON object')
    return info


def _read_proc_identity(pid: int | str) -> tuple[int, str, tuple[int, ...], str, str]:
    """Read PPid, State, NStgid, starttime, and pid namespace symlink for a process."""
    try:
        status_text = Path(f'/proc/{pid}/status').read_text(encoding='utf-8')
        stat_text = Path(f'/proc/{pid}/stat').read_text(encoding='utf-8')
        ns_pid = os.readlink(f'/proc/{pid}/ns/pid')
    except OSError as exc:
        raise CliError(f'unable to inspect sandbox process {pid}: {exc}') from None
    ppid: int | None = None
    state = ''
    nstgid: tuple[int, ...] = ()
    for line in status_text.splitlines():
        if line.startswith('PPid:'):
            ppid = int(line.split(':', 1)[1].strip())
        elif line.startswith('State:'):
            state = line.split(':', 1)[1].strip()[:1]
        elif line.startswith('NStgid:'):
            nstgid = tuple(int(tok) for tok in line.split(':', 1)[1].split())
    rparen = stat_text.rfind(')')
    if rparen < 0:
        raise CliError(f'malformed /proc/{pid}/stat')
    fields = stat_text[rparen + 2:].split()
    if len(fields) <= 19 or ppid is None or not state or not nstgid or int(fields[1]) != ppid:
        raise CliError(f'incomplete /proc identity metadata for {pid}')
    return ppid, state, nstgid, fields[19], ns_pid


def _pin_verified_namespace_init(info: dict, launcher_pid: int) -> int:
    """Verify child-pid is a live nested PID namespace init under launcher and pin its pidfd."""
    child_pid = info.get('child-pid')
    if not isinstance(child_pid, int) or isinstance(child_pid, bool) or child_pid <= 1:
        raise CliError('bwrap --info-fd did not report a valid child-pid')
    _, _, host_nstgid, _, host_ns_pid = _read_proc_identity('self')

    def check_once() -> tuple[int, tuple[int, ...], str, str]:
        ppid, state, nstgid, starttime, ns_pid = _read_proc_identity(child_pid)
        if ppid != launcher_pid:
            raise CliError(f'child-pid {child_pid} is not a direct child of bwrap launcher {launcher_pid}')
        if state not in ('R', 'S', 'D'):
            raise CliError(f'child-pid {child_pid} is not live (state={state!r})')
        if len(nstgid) <= len(host_nstgid) or nstgid[-1] != 1:
            raise CliError(f'child-pid {child_pid} is not a nested PID namespace init ({nstgid})')
        if ns_pid == host_ns_pid:
            raise CliError(f'child-pid {child_pid} remained in host PID namespace')
        reported_ns = info.get('pid-namespace')
        if isinstance(reported_ns, int) and not isinstance(reported_ns, bool) and ns_pid != f'pid:[{reported_ns}]':
            raise CliError(f'child-pid {child_pid} pid namespace mismatch')
        return ppid, nstgid, starttime, ns_pid

    ident_before = check_once()
    pidfd = os.pidfd_open(child_pid, 0)
    try:
        ident_after = check_once()
        if ident_after != ident_before:
            raise CliError(f'child-pid {child_pid} identity changed during pidfd verification')
    except Exception:
        os.close(pidfd)
        raise
    return pidfd


def _validate_writer_state_path(
    db_path: Path,
    resolved_cwd: Path,
    *,
    require_exists: bool = False,
) -> tuple[int, int] | None:
    """Require a symlink-free, single-link regular ledger pathname outside the writable worktree."""
    if not db_path.is_absolute():
        raise CliError('writer ledger path must be an absolute path outside the writable worktree')
    norm_parts: list[str] = []
    missing_seen = False
    last_st: os.stat_result | None = None
    parts = db_path.parts
    for idx, part in enumerate(parts[1:], start=1):
        is_last = idx == len(parts) - 1
        if part == '.':
            continue
        if part == '..':
            if missing_seen:
                raise CliError('writer ledger path must not traverse missing directories with `..` outside the writable worktree')
            if norm_parts:
                norm_parts.pop()
            cur = Path('/', *norm_parts)
            if cur == resolved_cwd or cur.is_relative_to(resolved_cwd):
                raise CliError('writer ledger path must not be inside the writable worktree')
            continue
        norm_parts.append(part)
        cur = Path('/', *norm_parts)
        if cur == resolved_cwd or cur.is_relative_to(resolved_cwd):
            raise CliError('writer ledger path must not be inside the writable worktree')
        try:
            st = os.lstat(cur)
        except FileNotFoundError:
            missing_seen = True
            continue
        except OSError as exc:
            raise CliError(f'unable to inspect writer ledger path outside the writable worktree: {exc}') from None
        if missing_seen:
            raise CliError('writer ledger path state changed during writable worktree isolation check')
        if stat.S_ISLNK(st.st_mode):
            raise CliError(f'writer ledger path must be symlink-free and outside the writable worktree: {cur}')
        if not is_last and not stat.S_ISDIR(st.st_mode):
            raise CliError(f'writer ledger parent component is not a directory outside the writable worktree: {cur}')
        if is_last:
            if not stat.S_ISREG(st.st_mode):
                raise CliError(f'writer ledger path must be a regular file outside the writable worktree: {cur}')
            if st.st_nlink != 1:
                raise CliError(
                    f'writer ledger path must not have hardlink aliases outside the writable worktree '
                    f'(st_nlink={st.st_nlink}): {cur}'
                )
            last_st = st
    try:
        state_candidates = (db_path.resolve(), db_path.parent.resolve(), db_path.parent.parent.resolve())
    except OSError as exc:
        raise CliError(f'unable to resolve writer ledger path: {exc}') from None
    if any(candidate == resolved_cwd or candidate.is_relative_to(resolved_cwd) for candidate in state_candidates):
        raise CliError('writer ledger path must not be inside the writable worktree')
    if require_exists or last_st is not None:
        return _verify_ledger_inode(db_path, require_exists=require_exists, expected_lstat=last_st)
    return None


def cmd_writer_exec(args: argparse.Namespace, db_path: Path) -> tuple[int, None]:
    """Register a writer fence attempt, supervise isolated bwrap execution, and close only on verified exit."""
    if not hasattr(os, 'pidfd_open'):
        raise CliError('Linux os.pidfd_open is required for writer-exec')
    python_bin = TRUSTED_PYTHON_BIN
    if not python_bin or not os.path.isabs(python_bin) or not os.access(python_bin, os.X_OK):
        raise CliError('trusted absolute Python executable is required for writer-exec')
    raw_argv = list(args.argv or [])
    if raw_argv and raw_argv[0] == '--':
        raw_argv = raw_argv[1:]
    bwrap_bin, bwrap_flags, payload_argv = _validate_writer_bwrap_argv(raw_argv, args.cwd)
    resolved_cwd = Path(args.cwd).resolve()
    pre_ledger_id = _validate_writer_state_path(db_path, resolved_cwd, require_exists=False)
    repo_key = canonicalize_repo(args.cwd, git_bin=TRUSTED_GIT_BIN)
    worktree = scoped_worktree(args.cwd, repo_key, args.issue, git_bin=TRUSTED_GIT_BIN)
    attempt_id = f'wa-{secrets.token_hex(16)}'
    now = format_utc(utc_now())

    with _open_short_active_write_tx(db_path, repo_key, git_bin=TRUSTED_GIT_BIN) as (conn, active_rows, resolved_keys):
        same_repo_runs = [row for row in active_rows if resolved_keys[row['repo_key']] == repo_key]
        bound_run = None
        for row in same_repo_runs:
            if row['issue'] is None:
                raise CliError(
                    f'writer fence: exclusive unscoped run {row["run_id"]} ({row["status"]}) active for {repo_key}'
                )
            norm_row_wt = os.path.realpath(row['worktree']) if row['worktree'] else None
            if row['issue'] == args.issue:
                if norm_row_wt != worktree:
                    raise CliError(
                        f'writer fence: active run {row["run_id"]} for {args.issue} is bound to different worktree {row["worktree"]!r}'
                    )
                if row['status'] != 'active':
                    raise CliError(
                        f'writer fence: run {row["run_id"]} for {args.issue} is {row["status"]}, not active'
                    )
                bound_run = row
            elif norm_row_wt == worktree:
                raise CliError(
                    f'writer fence: worktree {worktree} already bound to active run {row["run_id"]} ({row["issue"]})'
                )
        bound = 1 if bound_run is not None else 0
        run_id = bound_run['run_id'] if bound_run is not None else None
        if not bound and same_repo_runs:
            raise CliError(
                f'writer fence: unbound writer cannot start while active run {same_repo_runs[0]["run_id"]} exists for {repo_key}'
            )

        open_attempts = conn.execute(
            "SELECT attempt_id, repo_key, worktree, issue, bound FROM writer_attempts WHERE status = 'open'"
        ).fetchall()
        for att in open_attempts:
            same_repo = att['repo_key'] == repo_key
            same_wt = att['worktree'] == worktree
            if not same_repo and not same_wt:
                continue
            if not att['bound']:
                raise CliError(
                    f'writer fence: exclusive unbound writer attempt {att["attempt_id"]} already open for {repo_key}'
                )
            if not bound:
                raise CliError(
                    f'writer fence: unbound writer cannot start while writer attempt {att["attempt_id"]} is open for {repo_key}'
                )
            if att['issue'] == args.issue:
                raise CliError(
                    f'writer fence: writer attempt {att["attempt_id"]} already open for issue {args.issue}'
                )
            if same_wt:
                raise CliError(
                    f'writer fence: writer attempt {att["attempt_id"]} already open for worktree {worktree}'
                )

        try:
            conn.execute(
                """
                INSERT INTO writer_attempts (
                    attempt_id, repo_key, worktree, issue, bound, run_id, status, created_at
                ) VALUES (?, ?, ?, ?, ?, ?, 'open', ?)
                """,
                (attempt_id, repo_key, worktree, args.issue, bound, run_id, now),
            )
        except sqlite3.IntegrityError as exc:
            raise CliError(f'writer fence conflict for {repo_key}: {exc}') from exc

    post_ledger_id = _validate_writer_state_path(db_path, resolved_cwd, require_exists=True)
    if pre_ledger_id is not None and post_ledger_id != pre_ledger_id:
        raise CliError('writer ledger inode changed during registration; leaving writer fence open')

    info_r, info_w = os.pipe2(os.O_CLOEXEC)
    go_r, go_w = os.pipe2(os.O_CLOEXEC)
    pidfd = -1
    proc: subprocess.Popen[bytes] | None = None
    try:
        bwrap_cmd = [
            bwrap_bin,
            *bwrap_flags,
            '--info-fd',
            str(info_w),
            '--',
            python_bin,
            '-I',
            '-S',
            '-c',
            TRUSTED_WRITER_BOOTSTRAP_PY,
            *payload_argv,
        ]
        proc = subprocess.Popen(
            bwrap_cmd,
            cwd=args.cwd,
            stdin=go_r,
            stdout=None,
            stderr=None,
            pass_fds=(info_w,),
            close_fds=True,
        )
        os.close(info_w)
        info_w = -1
        os.close(go_r)
        go_r = -1

        info = _read_bwrap_info(info_r)
        os.close(info_r)
        info_r = -1

        pidfd = _pin_verified_namespace_init(info, proc.pid)
        if proc.poll() is not None:
            raise CliError(f'bwrap launcher exited prematurely ({proc.returncode}) before GO')

        view = memoryview(b'GO')
        sent = 0
        while sent < len(view):
            n = os.write(go_w, view[sent:])
            if n <= 0:
                raise CliError('failed to deliver GO to isolated sandbox bootstrap')
            sent += n
        os.close(go_w)
        go_w = -1

        launcher_rc = proc.wait()
        if launcher_rc < 0:
            return 128 + (-launcher_rc), None

        with selectors.DefaultSelector() as sel:
            sel.register(pidfd, selectors.EVENT_READ)
            if not sel.select(timeout=PIDFD_WAIT_TIMEOUT_SEC):
                raise CliError('namespace-init pidfd not readable after launcher wait; leaving writer fence open')

        closed_at = format_utc(utc_now())
        with open_write_tx(db_path) as conn:
            cur = conn.execute(
                """
                UPDATE writer_attempts
                SET status = 'closed', exit_code = ?, closed_at = ?
                WHERE attempt_id = ? AND status = 'open'
                """,
                (launcher_rc, closed_at, attempt_id),
            )
            if cur.rowcount != 1:
                raise CliError(f'writer fence close mismatch for {attempt_id}')
        return launcher_rc, None
    finally:
        for fd in (info_w, info_r, go_r, go_w, pidfd):
            if fd >= 0:
                try:
                    os.close(fd)
                except OSError:
                    pass
        if proc is not None and proc.poll() is None:
            try:
                proc.kill()
                proc.wait(timeout=5)
            except (OSError, subprocess.SubprocessError):
                pass


def cmd_cancel(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Cancel a non-terminal run at its current stage and free its repo key."""
    stage = validate_stage(args.stage)
    now = format_utc(utc_now())
    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, run['run_id'])
        require_writable_stage(run, stage)
        active_wait = fetch_active_wait(conn, run['run_id'])
        if active_wait is not None:
            conn.execute(
                'UPDATE waits SET resolved_at = ?, resolution = ? WHERE id = ?',
                (now, 'cancelled', active_wait['id']),
            )
        conn.execute(
            """
            UPDATE runs
            SET status = 'cancelled', reserved = 0, current_stage = NULL, cancelled_stage = ?,
                updated_at = ?, completed_at = ?
            WHERE run_id = ?
            """,
            (stage, now, now, run['run_id']),
        )
        conn.execute(
            'INSERT INTO events (run_id, event_type, stage, detail, created_at) VALUES (?, ?, ?, ?, ?)',
            (run['run_id'], 'cancel', stage, args.reason, now),
        )
        updated = fetch_run(conn, run['run_id'])
        payload = build_run_dict(conn, updated)
    return 0, payload


def poll_queued_ci(db_path: Path) -> tuple[list[dict], dict[int, str]]:
    with open_read_only(db_path) as conn:
        rows = conn.execute(
            "SELECT * FROM waits WHERE target = 'ci' AND resolved_at IS NULL AND reason LIKE ? ORDER BY id",
            (WATCH_PREFIX + '%',),
        ).fetchall()
    results = []
    failures = {}
    for row in rows:
        if parse_iso_utc(row['deadline_at']) <= utc_now():
            continue
        try:
            repo, pr, required, *profile_base = json.loads(row['reason'][len(WATCH_PREFIX):])
            if len(profile_base) > 1:
                raise CliError('invalid queued CI request')
            _, result = cmd_monitor(argparse.Namespace(
                rev=row['expected_rev'], host='git.butakov.su', repo=repo, pr=pr, require=required,
                profile=bool(profile_base), queued_base=profile_base[0] if profile_base else None,
                run_id=row['run_id'], interval=1, timeout=30, once=True, queue=False,
                watch_generation=row['generation'],
            ), db_path)
            if result['status'] == 'success':
                results.append({'reason': 'ci_passed', 'run_id': row['run_id'], 'stage': 'ci',
                                'expected_rev': row['expected_rev'], 'wait_generation': row['generation']})
        except CliError as exc:
            failures[row['id']] = str(exc)
        except (ValueError, TypeError, AttributeError):
            failures[row['id']] = 'invalid queued CI request'
    return results, failures


def cmd_preflight(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    def git(*tokens):
        try:
            result = subprocess.run([TRUSTED_GIT_BIN, '-C', args.checkout, *tokens], capture_output=True,
                                    text=True, env=_clean_git_env(), timeout=5, check=False)
        except (OSError, subprocess.TimeoutExpired):
            raise CliError('Git preflight exceeded its deadline') from None
        if result.returncode:
            raise CliError('preflight requires a readable Git checkout')
        return result.stdout.rstrip('\n')

    root, git_dir, common_dir, head = git('rev-parse', '--path-format=absolute', '--show-toplevel',
                                         '--git-dir', '--git-common-dir', 'HEAD').splitlines()
    payload = {
        'checkout': root,
        'linked_worktree': git_dir != common_dir,
        'head': validate_full_rev(head),
        'dirty': bool(git('status', '--porcelain')),
        'next': None,
    }
    if args.run_id:
        _, payload['next'] = cmd_resume(args, db_path)
    return 0, payload


def cmd_watch(args: argparse.Namespace, db_path: Path) -> tuple[int, list[dict]]:
    """Poll queued CI and emit deduped JSON notices for due or failed waits."""
    if not db_path.exists():
        return 0, []
    emitted, failures = poll_queued_ci(db_path)
    now_dt = utc_now()
    now_iso = format_utc(now_dt)
    with open_write_tx(db_path) as conn:
        has_dispatch = conn.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='dispatch_runs'"
        ).fetchone() is not None
        dispatch_filter = (
            ' AND NOT EXISTS (SELECT 1 FROM dispatch_runs d WHERE d.run_id = r.run_id)'
            if has_dispatch
            else ''
        )
        pending = conn.execute(
            f"""
            SELECT w.*, r.repo_key, r.current_stage
            FROM waits w
            JOIN runs r ON r.run_id = w.run_id
            WHERE r.status = 'waiting'
              AND w.resolved_at IS NULL
              {dispatch_filter}
              AND NOT EXISTS (
                  SELECT 1 FROM notices n
                  WHERE n.run_id = w.run_id AND n.wait_generation = w.generation
              )
            ORDER BY w.id ASC
            """
        ).fetchall()
        for wait_row in pending:
            wait_target = wait_row['target']
            failure = failures.get(wait_row['id'])
            if not failure and wait_row['deadline_at'] and now_dt < parse_iso_utc(wait_row['deadline_at']):
                continue
            if failure:
                notice_target = 'coordinator'
                reason = 'ci_unverified'
            elif wait_target == 'ci':
                notice_target = 'coordinator'
                reason = 'ci_overdue'
            else:
                notice_target = wait_target
                reason = 'wait_pending'
            notice = {
                'run_id': wait_row['run_id'],
                'repo_key': wait_row['repo_key'],
                'stage': wait_row['stage'],
                'wait_generation': wait_row['generation'],
                'target': notice_target,
                'wait_target': wait_target,
                'reason': reason,
                'expected_rev': wait_row['expected_rev'],
                'deadline_at': wait_row['deadline_at'],
                'wait_reason': failure or wait_row['reason'],
                'emitted_at': now_iso,
            }
            payload_json = json.dumps(notice, sort_keys=True)
            conn.execute(
                """
                INSERT INTO notices (
                    run_id, wait_generation, stage, target, wait_target, reason, payload_json, emitted_at
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    wait_row['run_id'],
                    wait_row['generation'],
                    wait_row['stage'],
                    notice_target,
                    wait_target,
                    reason,
                    payload_json,
                    now_iso,
                ),
            )
            emitted.append(notice)
    return 0, emitted


def format_human(command: str, data: object) -> str:
    """Format command output for interactive CLI callers."""
    if command == 'resume' and isinstance(data, dict):
        return data['message']
    if command == 'status' and isinstance(data, list) and not data:
        return 'no active runs'
    return json.dumps(data, indent=2, sort_keys=True)


def build_parser() -> argparse.ArgumentParser:
    """Construct the CLI argument parser."""
    parser = argparse.ArgumentParser(
        prog='pi-team-run',
        description='Manual durable pipeline bookkeeping for pi team runs.',
    )
    parser.add_argument('--json', action='store_true', default=False, help='Emit JSON output')
    sub = parser.add_subparsers(dest='command', required=True)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--json', action='store_true', default=argparse.SUPPRESS, help='Emit JSON output')

    p_start = sub.add_parser('start', parents=[common], help='Start a pipeline run for a repo')
    p_start.add_argument('repo', help='Repository path or identifier')
    p_start.add_argument('--issue', help='Exact Beads issue ID; repo must be the linked task worktree root')
    p_start.add_argument('--run-id', help='Optional explicit run identifier')
    p_start.add_argument(
        '--commit-only',
        action='store_true',
        help='Stop delivery after the local commit checkpoint (optional closeout stages may follow)',
    )
    p_start.add_argument('--no-ci', action='store_true', help='Omit CI only where repository policy explicitly has none')
    p_start.add_argument('--with-deploy', action='store_true', help='Opt in to optional deploy stage')
    p_start.add_argument('--with-honcho', action='store_true', help='Opt in to optional honcho stage')
    p_start.add_argument('--with-wiki', action='store_true', help='Opt in to optional wiki stage')
    p_start.add_argument('--note', help='Optional nonsecret run note')

    p_discover = sub.add_parser('discover', parents=[common], help='List unfinished runs for this checkout')
    p_discover.add_argument('checkout', nargs='?', default='.')

    p_preflight = sub.add_parser('preflight', parents=[common], help='Show exact local checkout and ledger state')
    p_preflight.add_argument('checkout')
    p_preflight.add_argument('--run-id')

    p_status = sub.add_parser('status', parents=[common], help='Inspect a run or list runs')
    p_status.add_argument('run_id', nargs='?', help='Optional run identifier')
    p_status.add_argument('--all', action='store_true', help='Include terminal runs when listing')

    p_resume = sub.add_parser('resume', parents=[common], help='Show next step without modifying state')
    p_resume.add_argument('run_id', help='Run identifier')

    p_wait = sub.add_parser('wait', parents=[common], help='Record an explicit wait on the current stage')
    p_wait.add_argument('run_id', help='Run identifier')
    p_wait.add_argument('stage', help='Current stage name')
    p_wait.add_argument('--target', required=True, choices=WAIT_TARGETS, help='Wait routing target')
    p_wait.add_argument('--rev', help='Expected full hex revision (required for CI)')
    p_wait.add_argument('--deadline', help='ISO-8601 deadline with timezone or Z (required for CI)')
    p_wait.add_argument('--reason', help='Optional nonsecret wait reason')
    p_wait.add_argument('--replace', action='store_true', help='Supersede an existing active wait')

    p_reserve = sub.add_parser('reserve', parents=[common], help='Reserve this repo before a shared operation')
    p_reserve.add_argument('run_id')
    p_reserve.add_argument('stage', choices=STAGES)

    p_ckpt = sub.add_parser('checkpoint', parents=[common], help='Checkpoint the current stage')
    p_ckpt.add_argument('run_id', help='Run identifier')
    p_ckpt.add_argument('stage', help='Current stage name')
    p_ckpt.add_argument('--evidence', required=True, help='Required opaque nonsecret evidence locator')
    p_ckpt.add_argument('--rev', help='Full hex revision (required for CI checkpoint)')
    p_ckpt.add_argument('--skip', action='store_true', help='Explicitly skip an optional stage')
    p_ckpt.add_argument('--note', help='Optional nonsecret note')

    sub.add_parser('watch', parents=[common], help='Poll queued CI once and emit JSON notices')

    p_monitor = sub.add_parser('monitor', parents=[common], help='Poll required Forgejo CI on an exact revision')
    p_monitor.add_argument('repo', help='Forgejo owner/name')
    p_monitor.add_argument('--host', default='git.butakov.su')
    p_monitor.add_argument('--pr', type=int, help='Verify this ready PR still points at the exact revision')
    p_monitor.add_argument('--run-id', help='Checkpoint CI on success for an existing run (requires --pr)')
    p_monitor.add_argument('--rev', required=True, help='Full commit SHA')
    checks = p_monitor.add_mutually_exclusive_group(required=True)
    checks.add_argument('--require', action='append', help='Exact required check context; repeat for each check')
    checks.add_argument('--profile', action='store_true', help='Use the registered delivery profile for this host and repo')
    p_profile = sub.add_parser('delivery-profile', parents=[common], help='Show the read-only delivery policy for a repository')
    p_profile.add_argument('repo', help='Forgejo owner/name')
    p_profile.add_argument('--host', default='git.butakov.su')
    p_monitor.add_argument('--interval', type=int, default=15)
    p_monitor.add_argument('--timeout', type=int, default=900)
    p_monitor.add_argument('--queue', action='store_true', help='Register a durable Forgejo PR wait for the watch service')

    p_cancel = sub.add_parser('cancel', parents=[common], help='Cancel a run at its current stage')
    p_cancel.add_argument('run_id', help='Run identifier')
    p_cancel.add_argument('stage', help='Current stage name')
    p_cancel.add_argument('--reason', help='Optional cancellation reason')

    p_wexec = sub.add_parser('writer-exec', help=argparse.SUPPRESS)
    p_wexec.add_argument('--cwd', required=True)
    p_wexec.add_argument('--issue', required=True)
    p_wexec.add_argument('argv', nargs=argparse.REMAINDER)

    return parser


def main(argv: list[str] | None = None) -> int:
    """CLI entrypoint."""
    parser = build_parser()
    args = parser.parse_args(argv)
    handlers = {
        'start': cmd_start,
        'status': cmd_status,
        'preflight': cmd_preflight,
        'discover': cmd_discover,
        'delivery-profile': cmd_delivery_profile,
        'resume': cmd_resume,
        'wait': cmd_wait,
        'checkpoint': cmd_checkpoint,
        'reserve': cmd_reserve,
        'watch': cmd_watch,
        'monitor': cmd_monitor,
        'cancel': cmd_cancel,
        'writer-exec': cmd_writer_exec,
    }
    os.umask(0o077)
    try:
        db_path = resolve_state_db_path()
        code, result = handlers[args.command](args, db_path)
    except CliError as exc:
        print(f'error: {exc}', file=sys.stderr)
        return 1
    except (sqlite3.DatabaseError, OSError) as exc:
        print(f'state error: {exc}', file=sys.stderr)
        return 1

    if args.command == 'writer-exec':
        return code
    if args.command == 'watch':
        for notice in result:
            print(json.dumps(notice, sort_keys=True))
    elif args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(format_human(args.command, result))
    return code


if __name__ == '__main__':
    sys.exit(main())
