    'ALTER TABLE checkpoints ADD COLUMN writer_attempt_id TEXT REFERENCES writer_attempts(attempt_id)',
    'ALTER TABLE checkpoints ADD COLUMN check_checkpoint_id INTEGER REFERENCES checkpoints(id)',
)


