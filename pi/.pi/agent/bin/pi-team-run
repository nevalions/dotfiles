WRITER_RECOVERY_EVENTS_SCHEMA = (
    """
    CREATE TABLE IF NOT EXISTS writer_recovery_events (
        attempt_id TEXT NOT NULL REFERENCES writer_attempts(attempt_id),
        action TEXT NOT NULL CHECK (action IN ('arm', 'retire')),
        disposition TEXT CHECK (
            (action = 'arm' AND disposition IS NULL)
            OR (action = 'retire' AND disposition = 'interrupted')
        ),
        attempt_repo_key TEXT NOT NULL,
        attempt_worktree TEXT NOT NULL,
        attempt_issue TEXT NOT NULL,
        attempt_bound INTEGER NOT NULL CHECK (attempt_bound IN (0, 1)),
        attempt_run_id TEXT,
        attempt_status TEXT NOT NULL CHECK (attempt_status IN ('open', 'closed')),
        attempt_exit_code INTEGER CHECK (attempt_exit_code IS NULL),
        attempt_created_at TEXT NOT NULL,
        attempt_closed_at TEXT,
        boot_id TEXT NOT NULL,
        machine_id_hash TEXT NOT NULL,
        pid_ns_inode INTEGER NOT NULL,
        ledger_path TEXT NOT NULL,
        ledger_fs_type TEXT NOT NULL,
        ledger_fsid TEXT NOT NULL,
        ledger_ino INTEGER NOT NULL,
        operator_attestation TEXT NOT NULL,
        created_at TEXT NOT NULL,
        PRIMARY KEY (attempt_id, action),
        CHECK (
            (action = 'arm' AND attempt_status = 'open' AND attempt_closed_at IS NULL)
            OR (action = 'retire' AND attempt_status = 'closed' AND attempt_closed_at IS NOT NULL)
        ),
        CHECK ((attempt_bound = 0 AND attempt_run_id IS NULL) OR (attempt_bound = 1 AND attempt_run_id IS NOT NULL))
    )
    """,
    """
    CREATE TRIGGER IF NOT EXISTS writer_recovery_events_no_update
    BEFORE UPDATE ON writer_recovery_events
    BEGIN
        SELECT RAISE(ABORT, 'writer_recovery_events is append-only');
    END
    """,
    """
    CREATE TRIGGER IF NOT EXISTS writer_recovery_events_no_delete
    BEFORE DELETE ON writer_recovery_events
    BEGIN
        SELECT RAISE(ABORT, 'writer_recovery_events is append-only');
    END
    """,
)


class CliError(Exception):
    """Domain or validation error surfaced cleanly to stderr."""


def utc_now() -> datetime:
    """Return current UTC datetime."""
    return datetime.now(timezone.utc)


def format_utc(dt: datetime) -> str:
    """Format a timezone-aware datetime as a UTC ISO-8601 string."""
    return dt.astimezone(timezone.utc).isoformat().replace('+00:00', 'Z')


def parse_iso_utc(raw: str) -> datetime:
    """Parse an ISO-8601 timestamp with explicit timezone offset or Z."""
    text = raw.strip()
    if not text:
        raise CliError('timestamp must not be empty')
    if text.endswith(('Z', 'z')):
        text = text[:-1] + '+00:00'
    try:
        dt = datetime.fromisoformat(text)
    except ValueError as exc:
        raise CliError(f'invalid ISO-8601 timestamp: {raw}') from exc
    if dt.tzinfo is None or dt.utcoffset() is None:
        raise CliError(f'timestamp must include timezone offset or Z: {raw}')
    return dt.astimezone(timezone.utc)


def validate_stage(stage: str) -> str:
    """Ensure stage is a known pipeline stage."""
    if stage not in STAGES:
        raise CliError(f'unknown stage {stage!r}; valid stages: {", ".join(STAGES)}')
    return stage


def validate_full_rev(rev: str) -> str:
    """Validate and normalize a full 40- or 64-character hexadecimal git revision."""
    text = rev.strip()
    if not REV_RE.fullmatch(text):
        raise CliError('CI revision must be a full 40- or 64-character hex SHA')
    return text.lower()


def validate_sha256_rev(rev: str) -> str:
    """Validate and normalize a full 64-character hexadecimal SHA-256 digest."""
    text = rev.strip()
    if not SHA256_REV_RE.fullmatch(text):
        raise CliError('local-only check/review requires --rev with a full 64-character hex SHA-256 digest')
    return text.lower()


def validate_run_id(run_id: str) -> str:
    """Validate an explicit run identifier without trimming."""
    if not isinstance(run_id, str) or not RUN_ID_RE.fullmatch(run_id):
        raise CliError('run ID must be 1-128 ASCII characters matching [A-Za-z0-9][A-Za-z0-9._-]{0,127}')
    return run_id


def validate_evidence(evidence: str) -> str:
    """Validate an opaque nonsecret evidence locator token."""
    text = evidence.strip()
    if not text:
        raise CliError('evidence token must not be empty')
    if len(text) > 512:
        raise CliError('evidence token exceeds 512 characters')
    if any(ch in text for ch in ('\n', '\r', '\x00')):
        raise CliError('evidence token must be a single line without control characters')
    for prefix in SECRET_PREFIXES:
        if prefix in text:
            raise CliError(f'evidence token must be a nonsecret locator (rejected {prefix!r})')
    return text


def _clean_git_env() -> dict[str, str]:
    """Return a clean environment for read-only Git identity queries."""
    env = {
        k: v
        for k, v in os.environ.items()
        if not k.startswith('GIT_') and k not in GIT_ENV_OVERRIDES
    }
    env['GIT_CONFIG_NOSYSTEM'] = '1'
    env['GIT_CONFIG_GLOBAL'] = '/dev/null'
    env['GIT_TERMINAL_PROMPT'] = '0'
    return env


def _has_purported_git_metadata(path: Path) -> bool:
    """Return True if path or any ancestor carries Git repository metadata."""
    for cur in (path, *path.parents):
        if os.path.lexists(cur / '.git') or cur.name == '.git':
            return True
    return (path / 'HEAD').is_file() and (path / 'objects').is_dir()


def canonicalize_repo(repo: str, *, git_bin: str = 'git') -> str:
    """Canonicalize a repository path via real Git common-dir, failing closed on lookup errors."""
    raw = repo.strip()
    if not raw:
        raise CliError('repository argument must not be empty')
    expanded = os.path.expanduser(raw)
    is_path = (
        raw in ('.', '..')
        or raw.startswith(('/', './', '../', '~/'))
        or os.path.exists(expanded)
        or os.path.lexists(expanded)
    )
    if is_path:
        if not os.path.exists(expanded):
            raise CliError(f'repository path does not exist or is unresolvable: {repo!r}')
        real = os.path.realpath(expanded)
        probe = real if os.path.isdir(real) else os.path.dirname(real)
        if not probe or not os.path.isdir(probe):
            raise CliError(f'unable to resolve repository directory: {repo!r}')
        try:
            proc = subprocess.run(
                [git_bin, '-C', probe, 'rev-parse', '--path-format=absolute', '--git-common-dir'],
                env=_clean_git_env(),
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise CliError(f'git repository identity lookup failed for {repo!r}: {exc}') from None
        if proc.returncode == 0:
            if '\x00' in proc.stdout:
                raise CliError(f'malformed git common-dir output for {repo!r}')
            lines = proc.stdout.splitlines()
            if len(lines) != 1:
                raise CliError(f'malformed git common-dir output for {repo!r}')
            common_dir = lines[0].strip()
            if not common_dir or not os.path.isabs(common_dir) or not os.path.isdir(common_dir):
                raise CliError(f'unresolvable git common-dir output for {repo!r}')
            return os.path.realpath(common_dir)
        is_confirmed_nonrepo = (
            proc.returncode == 128
            and 'not a git repository' in proc.stderr.lower()
            and not _has_purported_git_metadata(Path(probe))
        )
        if not is_confirmed_nonrepo:
            raise CliError(f'unable to resolve git repository identity for {repo!r} (exit {proc.returncode})')
        return real
    cleaned = raw.rstrip('/')
    if not cleaned:
        raise CliError(f'invalid repository identifier: {repo!r}')
    return cleaned


def resolve_state_db_path() -> Path:
    """Resolve the private XDG state database path."""
    xdg = os.environ.get('XDG_STATE_HOME', '').strip()
    if xdg:
        base = Path(os.path.expanduser(xdg))
        if not base.is_absolute():
            raise CliError(f'XDG_STATE_HOME must be an absolute path: {xdg!r}')
    else:
        base = Path.home() / '.local' / 'state'
    return base / 'pi-team-run' / 'state.db'


def ensure_private_state_dir(state_dir: Path) -> None:
    """Create the XDG state directory with 0700 permissions."""
    state_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(state_dir, 0o700)


def check_schema_version(conn: sqlite3.Connection, *, allow_init: bool) -> None:
    """Verify PRAGMA user_version or initialize a brand-new database."""
    version = conn.execute('PRAGMA user_version').fetchone()[0]
    if version == SCHEMA_VERSION:
        return
    if version == 0 and allow_init:
        existing = conn.execute(
            "SELECT count(*) FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
        ).fetchone()[0]
        if existing > 0:
            raise CliError('unsupported unversioned SQLite schema (PRAGMA user_version=0)')
        for stmt in V1_SCHEMA:
            conn.execute(stmt)
        version = 1
    if version == 1:
        if not allow_init:
            return
        for stmt in V2_MIGRATION:
            conn.execute(stmt)
        version = 2
    if version == 2:
        if not allow_init:
            return
        for stmt in V3_MIGRATION:
            conn.execute(stmt)
        version = 3
    if version == 3:
        if not allow_init:
            return
        for stmt in V4_MIGRATION:
            conn.execute(stmt)
        conn.execute(f'PRAGMA user_version = {SCHEMA_VERSION}')
        return
    raise CliError(f'unsupported SQLite schema version {version}; expected {SCHEMA_VERSION}')


def _verify_ledger_inode(
    db_path: Path,
    *,
    require_exists: bool = False,
    expected_lstat: os.stat_result | None = None,
) -> tuple[int, int] | None:
    """Verify an existing ledger database is a single-link regular file, not a symlink or alias."""
    try:
        st = os.lstat(db_path)
    except FileNotFoundError:
        if require_exists:
            raise CliError(f'writer ledger file missing outside the writable worktree: {db_path}') from None
        return None
    except OSError as exc:
        raise CliError(f'unable to inspect writer ledger file outside the writable worktree: {exc}') from None
    if stat.S_ISLNK(st.st_mode):
        raise CliError(f'writer ledger path must be symlink-free and outside the writable worktree: {db_path}')
    if not stat.S_ISREG(st.st_mode):
        raise CliError(f'writer ledger path must be a regular file outside the writable worktree: {db_path}')
    if st.st_nlink != 1:
        raise CliError(
            f'writer ledger path must not have hardlink aliases outside the writable worktree '
            f'(st_nlink={st.st_nlink}): {db_path}'
        )
    if expected_lstat is not None and (st.st_dev, st.st_ino) != (expected_lstat.st_dev, expected_lstat.st_ino):
        raise CliError(f'writer ledger path changed during validation outside the writable worktree: {db_path}')
    try:
        fd = os.open(db_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        raise CliError(
            f'unable to open writer ledger file for inode check outside the writable worktree: {exc}'
        ) from None
    try:
        fst = os.fstat(fd)
    finally:
        os.close(fd)
    if not stat.S_ISREG(fst.st_mode):
        raise CliError(f'writer ledger path must be a regular file outside the writable worktree: {db_path}')
    if fst.st_nlink != 1:
        raise CliError(
            f'writer ledger path must not have hardlink aliases outside the writable worktree '
            f'(st_nlink={fst.st_nlink}): {db_path}'
        )
    if (fst.st_dev, fst.st_ino) != (st.st_dev, st.st_ino):
        raise CliError(f'writer ledger path changed during validation outside the writable worktree: {db_path}')
    return fst.st_dev, fst.st_ino


@contextmanager
def open_write_tx(db_path: Path):
    """Open a private SQLite connection inside a BEGIN IMMEDIATE transaction."""
    ensure_private_state_dir(db_path.parent)
    _verify_ledger_inode(db_path, require_exists=False)
    conn = sqlite3.connect(str(db_path), timeout=5.0, isolation_level=None)
    conn.row_factory = sqlite3.Row
    try:
        _verify_ledger_inode(db_path, require_exists=True)
        os.chmod(db_path, 0o600)
        conn.execute('PRAGMA busy_timeout = 5000')
        conn.execute('PRAGMA journal_mode = DELETE')
        conn.execute('PRAGMA foreign_keys = ON')
        conn.execute('BEGIN IMMEDIATE')
        check_schema_version(conn, allow_init=True)
        yield conn
        conn.execute('COMMIT')
    except Exception:
        try:
            if conn.in_transaction:
                conn.execute('ROLLBACK')
        except sqlite3.Error:
            pass
        raise
    finally:
        conn.close()


@contextmanager
def open_read_only(db_path: Path):
    """Open an existing SQLite database strictly read-only."""
    conn = sqlite3.connect(f'{db_path.resolve().as_uri()}?mode=ro', uri=True, timeout=5.0, isolation_level=None)
    conn.row_factory = sqlite3.Row
    try:
        conn.execute('PRAGMA busy_timeout = 5000')
        conn.execute('PRAGMA foreign_keys = ON')
        conn.execute('BEGIN')
        check_schema_version(conn, allow_init=False)
        yield conn
    finally:
        conn.close()


def active_stages_for_run(run: sqlite3.Row) -> list[str]:
    """Return the immutable ordered stage list active for a run."""
    if 'local_only' in run.keys() and run['local_only']:
        return list(STAGES[:STAGES.index('review') + 1])
    enabled = {
        'deploy': bool(run['with_deploy']),
        'honcho': bool(run['with_honcho']),
        'wiki': bool(run['with_wiki']),
    }
    if run['commit_only']:
        stages = list(STAGES[:STAGES.index('commit') + 1])
        for stage in ('honcho', 'wiki'):
            if enabled[stage]:
                stages.append(stage)
        return stages
    return [
        stage for stage in STAGES
        if (stage not in OPTIONAL_STAGES or enabled[stage]) and not (stage == 'ci' and run['no_ci'])
    ]


def next_stage_after(run: sqlite3.Row, stage: str) -> str | None:
    """Return the next active stage after the given stage, or None if terminal."""
    active = active_stages_for_run(run)
    idx = active.index(stage)
    if idx + 1 < len(active):
        return active[idx + 1]
    return None


def fetch_run(conn: sqlite3.Connection, run_id: str) -> sqlite3.Row:
    """Fetch a run row or raise CliError if missing."""
    row = conn.execute('SELECT * FROM runs WHERE run_id = ?', (run_id,)).fetchone()
    if row is None:
        raise CliError(f'run not found: {run_id}')
    return row


def is_dispatcher_owned(conn: sqlite3.Connection, run_id: str) -> bool:
    """Return True if run_id is reserved and owned by pi-team-dispatch."""
    has_table = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='dispatch_runs'"
    ).fetchone()
    if has_table is None:
        return False
    return conn.execute('SELECT 1 FROM dispatch_runs WHERE run_id = ?', (run_id,)).fetchone() is not None


def require_interactive_run(conn: sqlite3.Connection, run_id: str) -> None:
    """Refuse interactive mutations against dispatcher-owned reservation rows."""
    if is_dispatcher_owned(conn, run_id):
        raise CliError(
            f'run {run_id} is owned by pi-team-dispatch; interactive wait/checkpoint/cancel refused'
        )


def external_patch_table(conn: sqlite3.Connection) -> bool:
    return conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='external_patches'").fetchone() is not None


def install_external_patch_table(conn: sqlite3.Connection) -> None:
    conn.execute("""CREATE TABLE IF NOT EXISTS external_patches (
        wait_id INTEGER PRIMARY KEY REFERENCES waits(id), rejected TEXT NOT NULL,
        supplied TEXT, source TEXT)""")
    conn.execute("""CREATE TRIGGER IF NOT EXISTS external_patch_resolution BEFORE UPDATE OF resolved_at ON waits
        WHEN EXISTS (SELECT 1 FROM external_patches WHERE wait_id=OLD.id)
          AND COALESCE(NEW.resolution,'') NOT IN ('cancelled', 'verified_patch', 'rejected_patch', 'patch_received')
        BEGIN SELECT RAISE(ABORT, 'external patch wait requires exact verification'); END""")
    conn.execute("""CREATE TRIGGER IF NOT EXISTS external_patch_checkpoint BEFORE INSERT ON checkpoints
        WHEN NEW.stage IN ('implement','check','review') AND EXISTS (
            SELECT 1 FROM (SELECT supplied FROM external_patches JOIN waits ON wait_id=waits.id
                WHERE waits.run_id=NEW.run_id ORDER BY waits.id DESC LIMIT 1)
            WHERE supplied IS NULL OR supplied IS NOT NEW.rev)
        BEGIN SELECT RAISE(ABORT, 'checkpoint requires the verified external patch digest'); END""")
    conn.execute("""CREATE TRIGGER IF NOT EXISTS external_patch_writer BEFORE INSERT ON writer_attempts
        WHEN EXISTS (SELECT 1 FROM waits JOIN external_patches ON wait_id=waits.id WHERE waits.run_id=NEW.run_id)
        BEGIN SELECT RAISE(ABORT, 'external patch required; writer budget not reset'); END""")


def fetch_active_wait(conn: sqlite3.Connection, run_id: str) -> dict | None:
    """Fetch the unresolved wait for a run if one exists."""
    row = conn.execute('SELECT * FROM waits WHERE run_id = ? AND resolved_at IS NULL', (run_id,)).fetchone()
    if row is None:
        return None
    wait = dict(row)
    if external_patch_table(conn):
        patch = conn.execute('SELECT rejected, supplied, source FROM external_patches WHERE wait_id=?',
                             (row['id'],)).fetchone()
        if patch:
            wait['external_patch'] = dict(patch)
    return wait


def require_writable_stage(run: sqlite3.Row, stage: str) -> str:
    """Validate stage name, non-terminal status, and exact current stage match."""
    validated = validate_stage(stage)
    if run['status'] in TERMINAL_STATUSES:
        raise CliError(f'run {run["run_id"]} is already terminal ({run["status"]})')
    if run['current_stage'] != validated:
        raise CliError(
            f'stale or out-of-order stage {validated!r} for run {run["run_id"]}; '
            f'current stage is {run["current_stage"]!r}'
        )
    return validated


def build_run_dict(conn: sqlite3.Connection, run: sqlite3.Row) -> dict:
    """Build a serializable snapshot of a run and its durability records."""
    checkpoints = [
        {
            'stage': row['stage'],
            'disposition': row['disposition'],
            'evidence': row['evidence'],
            'rev': row['rev'],
            'note': row['note'],
            'created_at': row['created_at'],
            'writer_attempt_id': row['writer_attempt_id'] if 'writer_attempt_id' in row.keys() else None,
            'check_checkpoint_id': row['check_checkpoint_id'] if 'check_checkpoint_id' in row.keys() else None,
        }
        for row in conn.execute(
            'SELECT * FROM checkpoints WHERE run_id = ? ORDER BY id',
            (run['run_id'],),
        ).fetchall()
    ]
    active_wait_row = fetch_active_wait(conn, run['run_id'])
    notices = [
        json.loads(row['payload_json'])
        for row in conn.execute(
            'SELECT payload_json FROM notices WHERE run_id = ? ORDER BY id',
            (run['run_id'],),
        ).fetchall()
    ]
    last_writer_attempt = None
    has_attempts_table = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='writer_attempts'"
    ).fetchone() is not None
    if has_attempts_table:
        last_att_row = conn.execute(
            """
            SELECT attempt_id, repo_key, worktree, issue, bound, run_id, status, exit_code, created_at, closed_at
            FROM writer_attempts
            WHERE run_id = ? AND bound = 1
            ORDER BY rowid DESC
            LIMIT 1
            """,
            (run['run_id'],),
        ).fetchone()
        if last_att_row is not None:
            last_writer_attempt = dict(last_att_row)
    return {
        'run_id': run['run_id'],
        'repo_key': run['repo_key'],
        'issue': run['issue'] if 'issue' in run.keys() else None,
        'worktree': run['worktree'] if 'worktree' in run.keys() else None,
        'reserved': bool(run['reserved']) if 'reserved' in run.keys() else False,
        'local_only': bool(run['local_only']) if 'local_only' in run.keys() else False,
        'status': run['status'],
        'current_stage': run['current_stage'],
        'wait_generation': run['wait_generation'],
        'commit_only': bool(run['commit_only']),
        'no_ci': bool(run['no_ci']),
        'optional_stages': {
            'deploy': bool(run['with_deploy']),
            'honcho': bool(run['with_honcho']),
            'wiki': bool(run['with_wiki']),
        },
        'active_stages': active_stages_for_run(run),
        'note': run['note'],
        'cancelled_stage': run['cancelled_stage'],
        'created_at': run['created_at'],
        'updated_at': run['updated_at'],
        'completed_at': run['completed_at'],
        'active_wait': dict(active_wait_row) if active_wait_row is not None else None,
        'last_writer_attempt': last_writer_attempt,
        'checkpoints': checkpoints,
        'notices': notices,
    }


def _checkpoint_hint(run: sqlite3.Row, stage: str) -> str:
    """Return the stage-specific checkpoint CLI hint for resume guidance."""
    run_id = run['run_id']
    is_local_only = bool(run['local_only']) if 'local_only' in run.keys() else False
    if is_local_only and stage == 'check':
        return f'`pi-team-run checkpoint {run_id} check --rev <sha256> --writer-attempt <attempt_id> --evidence <locator>`'
    if is_local_only and stage == 'review':
        return f'`pi-team-run checkpoint {run_id} review --rev <sha256> --evidence review:pass:<locator>`'
    hint = f'`pi-team-run checkpoint {run_id} {stage} --evidence <locator>`'
    if stage in OPTIONAL_STAGES:
        hint += ' (or `--skip --evidence <locator>`)'
    return hint


def compute_next_step(
    run: sqlite3.Row,
    active_wait: dict | None,
    now: datetime,
    *,
    dispatcher_owned: bool = False,
) -> dict:
    """Compute the read-only resume guidance for a run without mutating state."""
    run_id = run['run_id']
    if run['status'] in TERMINAL_STATUSES:
        return {
            'run_id': run_id,
            'status': run['status'],
            'current_stage': None,
            'action': 'none',
            'authorized': False,
            'message': f'Run {run_id} is terminal ({run["status"]}); no further action.',
        }
    if dispatcher_owned:
        return {
            'run_id': run_id,
            'status': run['status'],
            'current_stage': run['current_stage'],
            'action': 'dispatcher_managed',
            'authorized': False,
            'message': f'Run {run_id} is managed by pi-team-dispatch; interactive actions are disabled.',
        }
    stage = run['current_stage']
    if active_wait is not None:
        target = active_wait['target']
        if patch := active_wait.get('external_patch'):
            supplied = patch['supplied']
            return {'run_id': run_id, 'status': run['status'], 'current_stage': stage,
                    'action': 'verify_external_patch' if supplied else 'await_external_patch',
                    'wait_generation': active_wait['generation'], 'external_patch': patch,
                    'findings': active_wait['reason'], 'authorized': False,
                    'message': (f'Verify supplied candidate {supplied}; no checks or review have been passed by submission.'
                                if supplied else 'External maintainer patch required. No writer is scheduled; do not retry or ask for approval.')}
        if target in ('user', 'coordinator'):
            hint = _checkpoint_hint(run, stage)
            return {
                'run_id': run_id,
                'status': run['status'],
                'current_stage': stage,
                'action': f'await_{target}',
                'wait_target': target,
                'wait_generation': active_wait['generation'],
                'authorized': False,
                'message': (
                    f'Waiting on {target} at stage {stage!r} (gen {active_wait["generation"]}); '
                    f'resume does not authorize this wait. After explicit {target} approval, '
                    f'{"reserve before shared work, then run" if needs_reservation(run) else "run"} '
                    f'{hint} or '
                    f'`pi-team-run cancel {run_id} {stage}`.'
                ),
            }
        deadline = parse_iso_utc(active_wait['deadline_at'])
        overdue = now >= deadline
        return {
            'run_id': run_id,
            'status': run['status'],
            'current_stage': stage,
            'action': 'await_ci',
            'wait_target': 'ci',
            'wait_generation': active_wait['generation'],
            'expected_rev': active_wait['expected_rev'],
            'deadline_at': active_wait['deadline_at'],
            'overdue': overdue,
            'authorized': False,
            'message': (
                f'Waiting on CI for exact revision {active_wait["expected_rev"]} '
                f'(deadline {active_wait["deadline_at"]}, overdue={overdue}). '
                f'Timeout never succeeds; once verified, run '
                f'`pi-team-run checkpoint {run_id} ci --rev {active_wait["expected_rev"]} --evidence <locator>`.'
            ),
        }
    if stage == 'ci':
        return {
            'run_id': run_id,
            'status': run['status'],
            'current_stage': 'ci',
            'action': 'wait_ci',
            'authorized': False,
            'message': (
                f'Stage {stage!r} requires a CI wait first: '
                f'`pi-team-run wait {run_id} ci --target ci --rev <full_sha> --deadline <iso8601>`.'
            ),
        }
    if needs_reservation(run) and not run['reserved']:
        return {'run_id': run_id, 'status': run['status'], 'current_stage': stage, 'action': 'reserve',
                'authorized': False, 'message': f'Before shared work: pi-team-run reserve {run_id} {stage}'}
    hint = _checkpoint_hint(run, stage)
    return {
        'run_id': run_id,
        'status': run['status'],
        'current_stage': stage,
        'action': 'checkpoint',
        'authorized': False,
        'message': f'Next step for {run_id}: {hint}.',
    }


def _read_fd_text(fd: int, label: str, *, max_bytes: int = 1048576) -> str:
    """Read bounded UTF-8 text from an open regular file descriptor and close it."""
    try:
        fst = os.fstat(fd)
        if not stat.S_ISREG(fst.st_mode):
            raise CliError(f'{label} must be a regular file')
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(fd, min(65536, max_bytes + 1 - total))
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                raise CliError(f'{label} exceeded {max_bytes} bytes')
            chunks.append(chunk)
        data = b''.join(chunks)
    except OSError as exc:
        raise CliError(f'unable to read {label}: {exc}') from None
    finally:
        try:
            os.close(fd)
        except OSError:
            pass
    try:
        return data.decode('utf-8')
    except UnicodeDecodeError:
        raise CliError(f'{label} is not valid UTF-8') from None


def _verify_linked_worktree_backlink(root: Path, admin: Path) -> None:
    """Verify admin dir gitdir backlink resolves to exact linked worktree .git file."""
    root_git = root / '.git'
    try:
        root_git_lst = os.lstat(root_git)
    except OSError:
        raise CliError('--issue requires the root of a linked Git worktree') from None
    if stat.S_ISLNK(root_git_lst.st_mode) or not stat.S_ISREG(root_git_lst.st_mode):
        raise CliError('--issue requires the root of a linked Git worktree (.git must be a regular gitfile)')
    try:
        root_git_resolved = root_git.resolve(strict=True)
    except OSError:
        raise CliError('--issue requires the root of a linked Git worktree') from None

    gitdir_file = admin / 'gitdir'
    try:
        fd = os.open(gitdir_file, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise CliError('--issue requires a valid linked Git worktree admin gitdir backlink') from None
    raw_text = _read_fd_text(fd, 'worktree admin gitdir', max_bytes=8192)
    if '\x00' in raw_text or '\r' in raw_text:
        raise CliError('malformed linked Git worktree admin gitdir metadata')
    if raw_text.count('\n') > 1 or ('\n' in raw_text and not raw_text.endswith('\n')):
        raise CliError('ambiguous or malformed linked Git worktree admin gitdir metadata')
    target_raw = raw_text[:-1] if raw_text.endswith('\n') else raw_text
    if not target_raw or target_raw != target_raw.strip():
        raise CliError('empty or malformed linked Git worktree admin gitdir metadata')
    try:
        target_resolved = (admin / target_raw).resolve(strict=True)
    except OSError:
        raise CliError('unresolvable linked Git worktree admin gitdir backlink') from None
    if target_resolved.name != '.git' or target_resolved != root_git_resolved:
        raise CliError(
            '--issue requires the exact linked Git worktree root matching admin gitdir backlink'
        )


def scoped_worktree(repo: str, repo_key: str, issue: str, *, git_bin: str = 'git') -> str:
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*-[A-Za-z0-9][A-Za-z0-9.]*', issue) or len(issue) > 128:
        raise CliError('--issue requires the full Beads issue ID')
    root = Path(repo).expanduser().resolve()
    try:
        result = subprocess.run(
            [git_bin, '-C', str(root), 'rev-parse', '--path-format=absolute', '--show-toplevel', '--git-dir'],
            capture_output=True, text=True, env=_clean_git_env(), timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CliError(f'worktree lookup failed: {exc}') from None
    if '\x00' in result.stdout:
        raise CliError('--issue requires the root of a linked Git worktree')
    paths = result.stdout.splitlines()
    if (
        result.returncode != 0
        or len(paths) != 2
        or any(not p or p != p.strip() or not os.path.isabs(p) or not os.path.isdir(p) for p in paths)
        or Path(paths[0]).resolve() != root
        or Path(paths[1]).resolve().parent != Path(repo_key) / 'worktrees'
    ):
        raise CliError('--issue requires the root of a linked Git worktree')
    return str(Path(paths[1]).resolve())


def _same_repo_key(stored: str, repo_key: str, *, git_bin: str = 'git') -> bool:
    """Compare stored run repo_key against canonical repo_key, failing closed if unresolvable."""
    return stored == repo_key or canonicalize_repo(stored, git_bin=git_bin) == repo_key


class _RetryActiveKeys(Exception):
    """Internal sentinel to release a write lock before resolving unfamiliar active keys."""

    def __init__(self, unresolved_keys: set[str]) -> None:
        super().__init__('retry active key resolution')
        self.unresolved_keys = unresolved_keys


@contextmanager
def _open_short_active_write_tx(
    db_path: Path,
    repo_key: str,
    *,
    git_bin: str = 'git',
    max_attempts: int = 8,
):
    """Resolve unfamiliar active repo keys outside BEGIN IMMEDIATE, then yield inside one short write tx."""
    resolved_keys: dict[str, str] = {repo_key: repo_key}
    for _ in range(max_attempts):
        try:
            with open_write_tx(db_path) as conn:
                active_rows = conn.execute(
                    "SELECT run_id, repo_key, status, issue, worktree, local_only FROM runs WHERE status IN ('active', 'waiting')"
                ).fetchall()
                missing = {row['repo_key'] for row in active_rows if row['repo_key'] not in resolved_keys}
                if missing:
                    raise _RetryActiveKeys(missing)
                yield conn, active_rows, resolved_keys
                return
        except _RetryActiveKeys as retry:
            for key in sorted(retry.unresolved_keys):
                resolved_keys[key] = canonicalize_repo(key, git_bin=git_bin)
    raise CliError('active repository keys changed repeatedly during admission; retry')


def _check_writer_fence_for_start(
    conn: sqlite3.Connection,
    repo_key: str,
    issue: str | None,
    worktree: str | None,
) -> None:
    """Reject run admission if an open writer attempt conflicts with the requested scope."""
    open_attempts = conn.execute(
        "SELECT attempt_id, repo_key, worktree, issue, bound FROM writer_attempts WHERE status = 'open'"
    ).fetchall()
    for att in open_attempts:
        same_repo = att['repo_key'] == repo_key
        same_worktree = worktree is not None and att['worktree'] == worktree
        if not same_repo and not same_worktree:
            continue
        if not att['bound']:
            raise CliError(
                f'writer fence active for {repo_key}: unbound writer attempt {att["attempt_id"]} in {att["worktree"]}'
            )
        if issue is None:
            raise CliError(
                f'writer fence active for {repo_key}: scoped writer attempt {att["attempt_id"]} ({att["issue"]})'
            )
        if att['issue'] == issue:
            raise CliError(
                f'writer fence active for {repo_key}: writer attempt {att["attempt_id"]} already open for issue {issue}'
            )
        if same_worktree:
            raise CliError(
                f'writer fence active for {repo_key}: writer attempt {att["attempt_id"]} already open in worktree {worktree}'
            )


def cmd_start(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Start a new active pipeline run for a repository."""
    if args.commit_only and (args.no_ci or args.with_deploy):
        raise CliError('--commit-only cannot be combined with --no-ci or --with-deploy')
    if args.local_only:
        if args.issue is None:
            raise CliError('--local-only requires --issue with the full Beads issue ID')
        if args.commit_only or args.no_ci or args.with_deploy or args.with_honcho or args.with_wiki:
            raise CliError(
                '--local-only cannot be combined with --commit-only, --no-ci, --with-deploy, --with-honcho, or --with-wiki'
            )
    if args.run_id is not None:
        run_id = validate_run_id(args.run_id)
    else:
        run_id = f'run-{utc_now().strftime("%Y%m%dT%H%M%SZ")}-{secrets.token_hex(4)}'
    repo_key = canonicalize_repo(args.repo, git_bin=TRUSTED_GIT_BIN)
    worktree = scoped_worktree(args.repo, repo_key, args.issue, git_bin=TRUSTED_GIT_BIN) if args.issue is not None else None
    now = format_utc(utc_now())
    with _open_short_active_write_tx(db_path, repo_key, git_bin=TRUSTED_GIT_BIN) as (conn, active_rows, resolved_keys):
        _check_writer_fence_for_start(conn, repo_key, args.issue, worktree)
        for existing in active_rows:
            if resolved_keys[existing['repo_key']] == repo_key:
                if (existing['repo_key'] == repo_key and args.issue and existing['issue'] and args.issue != existing['issue']
                        and worktree != existing['worktree']):
                    continue
                raise CliError(
                    f'active run already exists for {repo_key}: {existing["run_id"]} ({existing["status"]})'
                )
        try:
            conn.execute(
                """
                INSERT INTO runs (
                    run_id, repo_key, issue, worktree, status, current_stage, wait_generation,
                    commit_only, no_ci, local_only, with_deploy, with_honcho, with_wiki, note, created_at, updated_at
                ) VALUES (?, ?, ?, ?, 'active', ?, 0, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    run_id,
                    repo_key,
                    args.issue,
                    worktree,
                    STAGES[0],
                    int(args.commit_only),
                    int(args.no_ci),
                    int(bool(args.local_only)),
                    int(bool(args.with_deploy)),
                    int(bool(args.with_honcho)),
                    int(bool(args.with_wiki)),
                    args.note,
                    now,
                    now,
                ),
            )
        except sqlite3.IntegrityError as exc:
            raise CliError(f'cannot start run for {repo_key}: {exc}') from exc
        conn.execute(
            'INSERT INTO events (run_id, event_type, stage, detail, created_at) VALUES (?, ?, ?, ?, ?)',
            (run_id, 'start', STAGES[0], args.note, now),
        )
        run = fetch_run(conn, run_id)
        payload = build_run_dict(conn, run)
    return 0, payload


def cmd_status(args: argparse.Namespace, db_path: Path) -> tuple[int, dict | list]:
    """Inspect one run or list active/all runs without writing."""
    if not db_path.exists():
        if args.run_id:
            raise CliError(f'run not found: {args.run_id}')
        return 0, []
    with open_read_only(db_path) as conn:
        if args.run_id:
            run = fetch_run(conn, args.run_id)
            data = build_run_dict(conn, run)
            if getattr(args, 'writer', False) and conn.execute(
                    "SELECT 1 FROM sqlite_master WHERE name='writer_attempts'").fetchone():
                data['last_writer'] = None
                last = conn.execute("""SELECT attempt_id,status,exit_code FROM writer_attempts
                                    WHERE run_id=? ORDER BY rowid DESC LIMIT 1""", (args.run_id,)).fetchone()
                if last:
                    data['last_writer'] = dict(last)
            return 0, data
        query = 'SELECT * FROM runs'
        if not args.all:
            query += " WHERE status IN ('active', 'waiting')"
        query += ' ORDER BY created_at ASC'
        rows = conn.execute(query).fetchall()
        return 0, [build_run_dict(conn, row) for row in rows]


def cmd_discover(args: argparse.Namespace, db_path: Path) -> tuple[int, list]:
    """List only this Git repository's unfinished runs; never initialize or migrate the ledger."""
    checkout = Path(args.checkout).resolve()
    key = canonicalize_repo(str(checkout))
    if not (Path(key) / 'HEAD').is_file() or not (Path(key) / 'objects').is_dir():
        raise CliError('startup discovery requires a Git checkout')
    if not db_path.exists():
        return 0, []
    result = []
    with open_read_only(db_path) as conn:
        for row in conn.execute("SELECT * FROM runs WHERE status IN ('active', 'waiting') ORDER BY created_at"):
            stored = row['repo_key']
            if stored != key:
                if not os.path.exists(stored) or canonicalize_repo(stored) != key:
                    continue
            issue = row['issue'] if 'issue' in row.keys() else None
            root = None
            if issue and row['worktree']:
                admin = Path(row['worktree'])
                if admin.parent == Path(key) / 'worktrees':
                    try:
                        gitfile = (admin / (admin / 'gitdir').read_text().rstrip('\n')).resolve(strict=True)
                        if gitfile.name == '.git' and scoped_worktree(str(gitfile.parent), key, issue) == str(admin):
                            root = str(gitfile.parent)
                    except (OSError, ValueError, CliError):
                        pass
            info = {'run_id': row['run_id'], 'issue': issue, 'worktree': root,
                    'stage': row['current_stage'], 'status': row['status']}
            if row['status'] == 'waiting':
                wait = fetch_active_wait(conn, row['run_id'])
                if wait and wait.get('external_patch'):
                    info['action'] = 'verify_external_patch' if wait['external_patch']['supplied'] else 'await_external_patch'
            result.append(info)
    return 0, result


def cmd_resume(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Show the next required step for a run without making any state changes."""
    if not db_path.exists():
        raise CliError(f'run not found: {args.run_id}')
    now = utc_now()
    with open_read_only(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        active_wait = fetch_active_wait(conn, run['run_id'])
        return 0, compute_next_step(
            run, active_wait, now, dispatcher_owned=is_dispatcher_owned(conn, run['run_id'])
        )


def cmd_wait(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Place the current stage of a run into an explicit coordinator, user, or CI wait."""
    stage = validate_stage(args.stage)
    target = args.target
    if stage == 'ci' and target != 'ci':
        raise CliError('stage "ci" requires --target ci')
    if target == 'ci' and stage != 'ci':
        raise CliError('--target ci is only valid for stage "ci"')
    rejected = getattr(args, 'rejected_patch', None)
    if rejected and (not re.fullmatch('[0-9a-f]{64}', rejected) or stage not in ('implement', 'check', 'review')
                     or target != 'coordinator' or not args.reason or not args.reason.strip() or args.deadline):
        raise CliError('--rejected-patch requires a SHA-256, findings, and a coordinator wait at implement/check/review')
    expected_rev: str | None = None
    deadline_iso: str | None = None
    if target == 'ci':
        if not args.rev:
            raise CliError('CI wait requires --rev with full hexadecimal revision')
        if not args.deadline:
            raise CliError('CI wait requires --deadline with ISO-8601 timestamp')
        expected_rev = validate_full_rev(args.rev)
        deadline_iso = format_utc(parse_iso_utc(args.deadline))
    else:
        if args.rev:
            raise CliError('--rev is only valid for CI waits')
        if args.deadline:
            deadline_iso = format_utc(parse_iso_utc(args.deadline))

    now = format_utc(utc_now())
    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, run['run_id'])
        require_writable_stage(run, stage)
        active_wait = fetch_active_wait(conn, run['run_id'])
        if rejected:
            if not run['issue'] or not run['worktree']:
                raise CliError('external patch handoffs require an issue-scoped linked worktree')
            if conn.execute("""SELECT 1 FROM writer_attempts WHERE status='open' AND
                    (worktree=? OR (repo_key=? AND (issue=? OR bound=0)))""",
                    (run['worktree'], run['repo_key'], run['issue'])).fetchone():
                raise CliError('cannot park while a writer fence is open')
            install_external_patch_table(conn)
        if active_wait is not None:
            patch = active_wait.get('external_patch')
            if patch and rejected == patch['rejected'] and args.reason == active_wait['reason']:
                return 0, build_run_dict(conn, run)
            if patch and (not rejected or not patch['supplied'] or rejected != patch['supplied'] or not args.replace):
                raise CliError('cannot replace an external patch wait except to reject its supplied candidate')
            if not args.replace:
                raise CliError(
                    f'run {run["run_id"]} already has an active wait on {active_wait["stage"]!r} '
                    f'(gen {active_wait["generation"]}); pass --replace to supersede it'
                )
            conn.execute(
                'UPDATE waits SET resolved_at = ?, resolution = ? WHERE id = ?',
                (now, 'rejected_patch' if patch else 'superseded', active_wait['id']),
            )
        new_gen = int(run['wait_generation']) + 1
        conn.execute(
            """
            INSERT INTO waits (
                run_id, generation, stage, target, expected_rev, deadline_at, reason, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (run['run_id'], new_gen, stage, target, expected_rev, deadline_iso, args.reason, now),
        )
        if rejected:
            conn.execute('INSERT INTO external_patches(wait_id, rejected) VALUES (last_insert_rowid(), ?)', (rejected,))
        conn.execute(
            "UPDATE runs SET status = 'waiting', wait_generation = ?, updated_at = ? WHERE run_id = ?",
            (new_gen, now, run['run_id']),
        )
        conn.execute(
            'INSERT INTO events (run_id, event_type, stage, detail, created_at) VALUES (?, ?, ?, ?, ?)',
            (run['run_id'], 'wait', stage, f'target={target} gen={new_gen}', now),
        )
        updated = fetch_run(conn, run['run_id'])
        payload = build_run_dict(conn, updated)
    return 0, payload


def cmd_supply_patch(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Record a maintainer's candidate without authorizing a writer or marking a stage passed."""
    if not re.fullmatch('[0-9a-f]{64}', args.candidate):
        raise CliError('candidate must be the full SHA-256 of the exact review diff')
    source = validate_evidence(args.evidence)
    fd = os.open(args.snapshot, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as snapshot:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or not st.st_size:
            raise CliError('expected a nonempty regular diff snapshot')
        digest = sha256()
        while chunk := snapshot.read(1024 * 1024):
            digest.update(chunk)
        if digest.hexdigest() != args.candidate:
            raise CliError('supplied diff does not match candidate SHA-256')
    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, args.run_id)
        wait = fetch_active_wait(conn, args.run_id)
        if not wait or not wait.get('external_patch'):
            raise CliError('no matching external patch wait generation')
        if wait['generation'] != args.generation:
            if (wait['generation'] == args.generation + 1 and wait['external_patch']['supplied'] == args.candidate
                    and wait['external_patch']['source'] == source):
                return 0, build_run_dict(conn, run)
            raise CliError('no matching external patch wait generation')
        if conn.execute("""SELECT 1 FROM external_patches JOIN waits ON wait_id=waits.id
                           WHERE waits.run_id=? AND rejected=?""", (args.run_id, args.candidate)).fetchone():
            raise CliError('candidate was already rejected')
        patch = wait['external_patch']
        if patch['supplied'] is not None:
            if (args.candidate, source) != (patch['supplied'], patch['source']):
                raise CliError('a different handoff is already pending verification')
            return 0, build_run_dict(conn, run)
        now = format_utc(utc_now())
        gen = wait['generation'] + 1
        conn.execute("UPDATE waits SET resolved_at=?, resolution='patch_received' WHERE id=?", (now, wait['id']))
        cur = conn.execute("""INSERT INTO waits (run_id,generation,stage,target,reason,created_at)
                              VALUES (?, ?, ?, 'coordinator', ?, ?)""",
                           (args.run_id, gen, wait['stage'], wait['reason'], now))
        conn.execute('INSERT INTO external_patches(wait_id,rejected,supplied,source) VALUES (?,?,?,?)',
                     (cur.lastrowid, patch['rejected'], args.candidate, source))
        conn.execute("UPDATE runs SET wait_generation=?, updated_at=? WHERE run_id=?", (gen, now, args.run_id))
        return 0, build_run_dict(conn, fetch_run(conn, args.run_id))


def needs_reservation(run: sqlite3.Row) -> bool:
    return ('issue' in run.keys() and run['issue'] is not None and
            (run['current_stage'] in SHARED_STAGES or (run['no_ci'] and run['current_stage'] == 'publish')))


def cmd_reserve(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, args.run_id)
        require_writable_stage(run, args.stage)
        if not run['issue'] or args.stage == 'ci':
            raise CliError('reserve requires an issue-scoped run outside PR CI')
        owner = conn.execute('SELECT run_id FROM runs WHERE repo_key = ? AND reserved = 1',
                             (run['repo_key'],)).fetchone()
        if owner and owner['run_id'] != args.run_id:
            raise CliError(f'repository reserved by {owner["run_id"]}; retry before any shared operation')
        conn.execute('UPDATE runs SET reserved = 1 WHERE run_id = ?', (args.run_id,))
        return 0, build_run_dict(conn, fetch_run(conn, args.run_id))


def _validate_local_only_writer_attempt(
    conn: sqlite3.Connection,
    run: sqlite3.Row,
    stage: str,
) -> sqlite3.Row:
    """Verify no open attempt blocks this run and return its latest closed exit-0 bound attempt."""
    if not run['issue'] or not run['worktree']:
        raise CliError(f'local-only run {run["run_id"]} is missing required issue or worktree binding')
    open_att = conn.execute(
        """
        SELECT attempt_id FROM writer_attempts
        WHERE status = 'open'
          AND (run_id = ? OR (repo_key = ? AND issue = ?) OR worktree = ?)
        ORDER BY rowid DESC
        LIMIT 1
        """,
        (run['run_id'], run['repo_key'], run['issue'], run['worktree']),
    ).fetchone()
    if open_att is not None:
        raise CliError(
            f'open writer attempt {open_att["attempt_id"]} blocks {stage} checkpoint for run {run["run_id"]}'
        )
    latest = conn.execute(
        """
        SELECT * FROM writer_attempts
        WHERE run_id = ?
        ORDER BY rowid DESC
        LIMIT 1
        """,
        (run['run_id'],),
    ).fetchone()
    if latest is None:
        raise CliError(
            f'local-only {stage} checkpoint requires a closed exit-0 writer attempt for run {run["run_id"]}'
        )
    if (
        latest['bound'] != 1
        or latest['repo_key'] != run['repo_key']
        or latest['issue'] != run['issue']
        or latest['worktree'] != run['worktree']
    ):
        raise CliError(f'writer attempt {latest["attempt_id"]} scope does not match run {run["run_id"]}')
    newer = conn.execute(
        """
        SELECT attempt_id FROM writer_attempts
        WHERE rowid > (SELECT rowid FROM writer_attempts WHERE attempt_id = ?)
          AND ((repo_key = ? AND issue = ?) OR worktree = ?)
        ORDER BY rowid DESC
        LIMIT 1
        """,
        (latest['attempt_id'], run['repo_key'], run['issue'], run['worktree']),
    ).fetchone()
    if newer is not None:
        raise CliError(
            f'newer writer attempt {newer["attempt_id"]} supersedes {latest["attempt_id"]} for run {run["run_id"]}'
        )
    if latest['status'] != 'closed' or not (latest['closed_at'] and str(latest['closed_at']).strip()):
        raise CliError(f'writer attempt {latest["attempt_id"]} for run {run["run_id"]} is not cleanly closed')
    if latest['exit_code'] != 0:
        raise CliError(f'latest writer attempt {latest["attempt_id"]} exited with code {latest["exit_code"]}; expected 0')
    return latest


def cmd_checkpoint(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Record a stage checkpoint with required evidence and advance the pipeline."""
    stage = validate_stage(args.stage)
    evidence = validate_evidence(args.evidence)
    if args.skip and stage not in OPTIONAL_STAGES:
        raise CliError(f'stage {stage!r} is required and cannot be skipped')
    provided_rev = validate_full_rev(args.rev) if args.rev else None
    disposition = 'skipped' if args.skip else 'completed'
    now = format_utc(utc_now())

    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, run['run_id'])
        require_writable_stage(run, stage)
        active_wait = fetch_active_wait(conn, run['run_id'])
        if needs_reservation(run) and not run['reserved'] and not args.skip:
            raise CliError(f'reserve {args.run_id} {stage} before shared operations')
        generation = getattr(args, 'generation', None)
        if generation is not None and (active_wait is None or active_wait['generation'] != generation):
            raise CliError('wait generation changed; refusing to checkpoint')
        patch = active_wait.get('external_patch') if active_wait else None
        if patch and (not patch['supplied'] or provided_rev != patch['supplied'] or generation != active_wait['generation']):
            raise CliError('external patch checkpoint requires verified supplied candidate --rev and --generation')
        if stage in ('implement', 'check', 'review') and external_patch_table(conn):
            latest = conn.execute("""SELECT supplied FROM external_patches JOIN waits ON wait_id=waits.id
                                   WHERE waits.run_id=? ORDER BY waits.id DESC LIMIT 1""", (args.run_id,)).fetchone()
            if latest and (not latest['supplied'] or provided_rev != latest['supplied']):
                raise CliError('checkpoint must verify the exact supplied patch')
            if latest and stage == 'review' and not conn.execute(
                "SELECT 1 FROM checkpoints WHERE run_id=? AND stage='check' AND rev=?", (args.run_id, provided_rev)
            ).fetchone():
                checks = getattr(args, 'checks_evidence', None)
                if not checks:
                    raise CliError('new review candidate requires --checks-evidence for its fresh checks')
                conn.execute("""INSERT INTO events(run_id,event_type,stage,detail,created_at)
                                VALUES (?,'patch_rechecked','check',?,?)""",
                             (args.run_id, json.dumps([provided_rev, validate_evidence(checks)]), now))
        if stage == 'ci':
            if active_wait is None or active_wait['target'] != 'ci' or active_wait['stage'] != 'ci':
                raise CliError('CI checkpoint requires an active CI wait first')
            if provided_rev is None:
                raise CliError('CI checkpoint requires --rev matching the waited full revision')
            if provided_rev != active_wait['expected_rev']:
                raise CliError(
                    f'CI revision mismatch: waited {active_wait["expected_rev"]}, got {provided_rev}'
                )
        raw_writer_attempt = getattr(args, 'writer_attempt', None)
        if raw_writer_attempt is not None:
            if not ATTEMPT_ID_RE.fullmatch(raw_writer_attempt):
                raise CliError('invalid --writer-attempt; expected exact wa-<32 lowercase hex>')
            if not (run['local_only'] and stage in ('check', 'review')):
                raise CliError('--writer-attempt is only supported for local-only check/review checkpoints')
        writer_attempt_id: str | None = None
        check_checkpoint_id: int | None = None
        if run['local_only'] and stage in ('check', 'review'):
            if not args.rev:
                raise CliError(
                    f'local-only {stage} checkpoint requires --rev with a full 64-character hex SHA-256 digest'
                )
            provided_rev = validate_sha256_rev(args.rev)
            latest = _validate_local_only_writer_attempt(conn, run, stage)
            if stage == 'check':
                if raw_writer_attempt is None:
                    raise CliError(
                        f'local-only check checkpoint for run {run["run_id"]} requires --writer-attempt '
                        'with the inspected closed exit-0 writer attempt ID'
                    )
                if latest['attempt_id'] != raw_writer_attempt:
                    raise CliError(
                        f'stale writer attempt for run {run["run_id"]}: expected {raw_writer_attempt}, '
                        f'latest writer attempt is {latest["attempt_id"]}'
                    )
                writer_attempt_id = latest['attempt_id']
            else:
                if raw_writer_attempt is not None and latest['attempt_id'] != raw_writer_attempt:
                    raise CliError(
                        f'stale writer attempt for run {run["run_id"]}: expected {raw_writer_attempt}, '
                        f'latest writer attempt is {latest["attempt_id"]}'
                    )
                if not evidence.startswith('review:pass:') or not evidence[len('review:pass:'):].strip():
                    raise CliError(
                        'local-only review checkpoint requires explicit evidence in the form review:pass:<opaque locator>'
                    )
                check_ckpt = conn.execute(
                    "SELECT id, disposition, rev, writer_attempt_id FROM checkpoints WHERE run_id = ? AND stage = 'check'",
                    (run['run_id'],),
                ).fetchone()
                if check_ckpt is None or check_ckpt['disposition'] != 'completed':
                    raise CliError(f'local-only review requires a completed check checkpoint for run {run["run_id"]}')
                if not check_ckpt['rev'] or not check_ckpt['writer_attempt_id']:
                    raise CliError(
                        f'check checkpoint for run {run["run_id"]} is missing digest or writer attempt binding'
                    )
                if latest['attempt_id'] != check_ckpt['writer_attempt_id']:
                    raise CliError(
                        f'stale check checkpoint for run {run["run_id"]}: check bound to '
                        f'{check_ckpt["writer_attempt_id"]}, latest writer attempt is {latest["attempt_id"]}'
                    )
                has_patch_recheck = bool(
                    patch and patch['supplied'] == provided_rev and getattr(args, 'checks_evidence', None)
                )
                if check_ckpt['rev'] != provided_rev and not has_patch_recheck:
                    raise CliError(
                        f'review digest mismatch for run {run["run_id"]}: '
                        f'check recorded {check_ckpt["rev"]}, got {provided_rev}'
                    )
                writer_attempt_id = latest['attempt_id']
                check_checkpoint_id = int(check_ckpt['id'])
        if active_wait is not None:
            conn.execute(
                'UPDATE waits SET resolved_at = ?, resolution = ? WHERE id = ?',
                (now, 'verified_patch' if patch else disposition, active_wait['id']),
            )
        conn.execute(
            """
            INSERT INTO checkpoints (
                run_id, stage, disposition, evidence, rev, note,
                writer_attempt_id, check_checkpoint_id, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                run['run_id'],
                stage,
                disposition,
                evidence,
                provided_rev,
                args.note,
                writer_attempt_id,
                check_checkpoint_id,
                now,
            ),
        )
        nxt = next_stage_after(run, stage)
        if run['reserved'] and nxt not in LANDING_STAGES:
            conn.execute('UPDATE runs SET reserved = 0 WHERE run_id = ?', (run['run_id'],))
        if nxt is None:
            conn.execute(
                """
                UPDATE runs
                SET status = 'completed', current_stage = NULL, updated_at = ?, completed_at = ?
                WHERE run_id = ?
                """,
                (now, now, run['run_id']),
            )
        else:
            conn.execute(
                """
                UPDATE runs
                SET status = 'active', current_stage = ?, updated_at = ?
                WHERE run_id = ?
                """,
                (nxt, now, run['run_id']),
            )
        conn.execute(
            'INSERT INTO events (run_id, event_type, stage, detail, created_at) VALUES (?, ?, ?, ?, ?)',
            (run['run_id'], f'checkpoint:{disposition}', stage, evidence, now),
        )
        updated = fetch_run(conn, run['run_id'])
        payload = build_run_dict(conn, updated)
    return 0, payload


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def forgejo_get(host: str, repo: str, path: str):
    token = os.environ.get('PI_TEAM_FORGEJO_TOKEN')
    if not token and host == 'git.butakov.su':
        token_file = Path.home() / '.config/forgejo/token'
        if token_file.is_file():
            token = token_file.read_text().strip()
    headers = {'Accept': 'application/json'}
    if token:
        headers['Authorization'] = f'token {token}'
    request = Request(f'https://{host}/api/v1/repos/{repo}/{path}', headers=headers)
    with build_opener(NoRedirect()).open(request, timeout=8) as response:
        return json.load(response)


def check_required(statuses: list, required: list[str]) -> tuple[list[str], list[str]]:
    by_context = {}
    for entry in statuses:
        by_context.setdefault(entry['context'], entry['status'])
    waiting = [name for name in required if by_context.get(name) in (None, 'pending', 'running')]
    failed = [name for name in required if name not in waiting and by_context[name] != 'success']
    return waiting, failed


WATCH_PREFIX = 'forgejo-ci-v1:'


DELIVERY_PROFILES = {
    ('git.butakov.su', 'nevalions/frontend-angular-signals'): {
        'base': 'master',
        'pr_checks': [f'CI / {name} (pull_request)' for name in
                      ('lint', 'typecheck', 'test', 'build', 'quality-gate')] +
                     [f'security-pr / {name} (pull_request)' for name in ('semgrep', 'gitleaks', 'trivy-fs')],
        'push_checks': ['CI / quality-gate (push)', 'CI / publish-image (push)'],
        'merge': {'mechanism': 'Forgejo server-side squash', 'entrypoint': 'scripts/ship.sh'},
        'artifact': {'repository': 'docker.butakov.su/library/statsboards-frontend',
                     'revision_label': 'org.opencontainers.image.revision'},
        'deploy': {
            'dev': {'mechanism': 'kube-lvl47 auto-deploy PR and Flux', 'namespace': 'stats-dev',
                    'hosts': ['butakov.su']},
            'prod': {'mechanism': 'separately authorized kube-lvl47 pin PR and Flux', 'namespace': 'stats-prod',
                     'hosts': ['statsboard.online', 'statsboard.ru']},
        },
        'rollout_evidence': ['authorized environment and GitOps revision applied by Flux',
                             'published image digest tied to the exact application merge SHA',
                             'ready serving pods running that digest in the target environment',
                             'served asset and affected route checks on the target public host'],
    },
}


def get_delivery_profile(host, repo):
    profile = DELIVERY_PROFILES.get((host, repo))
    if profile is None:
        raise CliError('no delivery profile for this Forgejo host and repository')
    return profile


def cmd_delivery_profile(args: argparse.Namespace, _db_path: Path) -> tuple[int, dict]:
    profile = get_delivery_profile(args.host, args.repo)
    return 0, {'host': args.host, 'repo': args.repo, **profile, 'grants_authority': False}


def cmd_monitor(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    queue = getattr(args, 'queue', False)
    once = getattr(args, 'once', False)
    if queue and (not args.run_id or args.pr is None or args.host != 'git.butakov.su'):
        raise CliError('--queue requires --run-id, --pr and the configured git.butakov.su host')
    rev = validate_full_rev(args.rev)
    host = urlsplit(f'https://{args.host}')
    if host.netloc != args.host or not re.fullmatch(r'[A-Za-z0-9.-]+(?::[0-9]+)?', args.host):
        raise CliError('invalid Forgejo host')
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', args.repo) or any(
        component in ('.', '..') for component in args.repo.split('/')
    ):
        raise CliError('expected Forgejo repository as owner/name')
    if args.pr is not None and args.pr < 1:
        raise CliError('expected positive PR number')
    if not 1 <= args.interval <= 120 or not 1 <= args.timeout <= 7200:
        raise CliError('interval must be 1–120 seconds and timeout 1–7200 seconds')
    profile = get_delivery_profile(args.host, args.repo) if getattr(args, 'profile', False) else None
    if profile and args.require and not getattr(args, 'watch_generation', None):
        raise CliError('use either --profile or --require, not both')
    required = sorted(set(profile['pr_checks' if args.pr else 'push_checks'] if profile else (args.require or [])))
    if profile and args.require and required != args.require:
        raise CliError('queued delivery profile checks changed; register a new wait')
    if not required or any(not name.strip() or len(name) > 256 or not name.isprintable() for name in required):
        raise CliError('invalid required check context')
    scope_parts = [args.host, args.repo, args.pr, required]
    queue_parts = [args.repo, args.pr, required]
    if profile:
        scope_parts.append(profile['base'])
        queue_parts.append(profile['base'])
        if getattr(args, 'queued_base', profile['base']) != profile['base']:
            raise CliError('queued delivery profile base changed; register a new wait')
    scope = sha256(json.dumps(scope_parts).encode()).hexdigest()
    reason = f'Forgejo {args.repo} PR {args.pr} monitor:{scope}'
    queued_reason = WATCH_PREFIX + json.dumps(queue_parts, separators=(',', ':'))
    if queue:
        reason = queued_reason
    deadline = utc_now() + timedelta(seconds=args.timeout)
    generation = None
    if args.run_id:
        if args.pr is None:
            raise CliError('ledger CI monitoring requires --pr; post-merge monitoring is read-only')
        with open_read_only(db_path) as conn:
            run = fetch_run(conn, args.run_id)
            require_interactive_run(conn, run['run_id'])
            require_writable_stage(run, 'ci')
            existing = fetch_active_wait(conn, args.run_id)
        watch_generation = getattr(args, 'watch_generation', None)
        if watch_generation is not None and (existing is None or existing['generation'] != watch_generation):
            raise CliError('queued CI wait was superseded')
        if existing is None:
            cmd_wait(argparse.Namespace(run_id=args.run_id, stage='ci', target='ci', rev=rev,
                                      deadline=format_utc(deadline), reason=reason,
                                      replace=False), db_path)
            with open_read_only(db_path) as conn:
                existing = fetch_active_wait(conn, args.run_id)
        if (existing is None or existing['target'] != 'ci' or existing['expected_rev'] != rev
                or (existing['reason'] != reason and not (
                    not queue and args.host == 'git.butakov.su' and existing['reason'] == queued_reason
                ))):
            raise CliError('active CI wait does not match this revision, PR and required check set')
        generation = existing['generation']
        deadline = min(deadline, parse_iso_utc(existing['deadline_at']))
    if queue:
        return 0, {'status': 'queued', 'revision': rev, 'checks': required, 'run_id': args.run_id}

    def check_head():
        if args.pr is None:
            if profile:
                branch = forgejo_get(args.host, args.repo, f"branches/{quote(profile['base'], safe='')}")
                if branch['commit']['id'] != rev:
                    raise CliError('profile base tip does not match the expected merged revision')
            return
        pr = forgejo_get(args.host, args.repo, f'pulls/{args.pr}')
        if pr['state'] != 'open' or pr.get('draft') or pr['head']['sha'] != rev:
            raise CliError('PR is not ready/open at the expected revision; CI evidence is stale')
        if profile and (pr['base']['ref'] != profile['base'] or pr['base']['repo']['full_name'] != args.repo):
            raise CliError('PR target does not match the delivery profile base')

    while utc_now() < deadline:
        try:
            check_head()
            statuses = forgejo_get(args.host, args.repo, f'commits/{quote(rev)}/status')
            if statuses.get('sha') != rev:
                raise CliError('Forgejo status response does not match the expected revision')
            waiting, failed = check_required(statuses['statuses'], required)
            if failed:
                raise CliError('required CI did not pass: ' + ', '.join(failed))
            if not waiting and utc_now() < deadline:
                check_head()
                if utc_now() >= deadline:
                    break
                if args.run_id:
                    cmd_checkpoint(argparse.Namespace(run_id=args.run_id, stage='ci', rev=rev, skip=False,
                                                      note=None, generation=generation,
                                                      evidence=f'forgejo:{args.host}/{args.repo}#{args.pr}@{rev}'), db_path)
                return 0, {'status': 'success', 'revision': rev, 'checks': required, 'run_id': args.run_id}
        except HTTPError as exc:
            if exc.code not in (429, 500, 502, 503, 504):
                raise CliError(f'Forgejo lookup failed (HTTP {exc.code})') from None
        except (URLError, TimeoutError):
            pass
        except (ValueError, TypeError, KeyError):
            raise CliError('invalid Forgejo response; required CI is unverified') from None
        if once:
            return 0, {'status': 'pending'}
        time.sleep(max(0, min(args.interval, (deadline - utc_now()).total_seconds())))
    raise CliError('CI monitoring deadline reached; required checks remain unverified')


def _validate_writer_bwrap_argv(cmd_argv: list[str], cwd: str) -> tuple[str, list[str], list[str]]:
    """Validate exact required bwrap isolation flags and extract payload argv."""
    if not cmd_argv or cmd_argv[0] not in ('bwrap', TRUSTED_BWRAP_BIN):
        raise CliError('writer-exec requires bwrap command argv')
    bwrap_bin = TRUSTED_BWRAP_BIN
    if not os.path.isabs(bwrap_bin) or not os.access(bwrap_bin, os.X_OK):
        raise CliError('trusted bwrap executable not found or not executable')
    try:
        sep_idx = cmd_argv.index('--', 1)
    except ValueError:
        raise CliError('writer-exec requires `--` separating bwrap flags and payload') from None
    bwrap_flags = cmd_argv[1:sep_idx]
    payload_argv = cmd_argv[sep_idx + 1:]
    if not payload_argv or any(not arg or '\x00' in arg for arg in payload_argv):
        raise CliError('writer-exec requires a valid payload command after `--`')

    resolved_cwd = Path(cwd).resolve()
    has_unshare_pid = False
    has_die_with_parent = False
    has_ro_root = False
    has_bind_cwd = False
    has_dev = False
    has_proc = False
    overlay_src: Path | None = None
    tmp_overlay: Path | None = None

    i = 0
    while i < len(bwrap_flags):
        flag = bwrap_flags[i]
        if flag == '--unshare-pid':
            has_unshare_pid = True
            i += 1
        elif flag == '--die-with-parent':
            has_die_with_parent = True
            i += 1
        elif flag == '--ro-bind':
            if i + 2 >= len(bwrap_flags) or bwrap_flags[i + 1] != '/' or bwrap_flags[i + 2] != '/':
                raise CliError('writer-exec requires exact `--ro-bind / /`')
            has_ro_root = True
            i += 3
        elif flag == '--bind':
            if i + 2 >= len(bwrap_flags):
                raise CliError('writer-exec requires `--bind <cwd> <cwd>`')
            if Path(bwrap_flags[i + 1]).resolve() != resolved_cwd or Path(bwrap_flags[i + 2]).resolve() != resolved_cwd:
                raise CliError('writer-exec `--bind` must target exact worktree root')
            has_bind_cwd = True
            i += 3
        elif flag == '--overlay-src':
            if i + 1 >= len(bwrap_flags) or overlay_src is not None:
                raise CliError('invalid `--overlay-src` in writer-exec')
            overlay_src = Path(bwrap_flags[i + 1]).resolve()
            i += 2
        elif flag == '--tmp-overlay':
            if i + 1 >= len(bwrap_flags) or tmp_overlay is not None:
                raise CliError('invalid `--tmp-overlay` in writer-exec')
            tmp_overlay = Path(bwrap_flags[i + 1]).resolve()
            i += 2
        elif flag == '--dev':
            if i + 1 >= len(bwrap_flags) or bwrap_flags[i + 1] != '/dev':
                raise CliError('writer-exec requires `--dev /dev`')
            has_dev = True
            i += 2
        elif flag == '--proc':
            if i + 1 >= len(bwrap_flags) or bwrap_flags[i + 1] != '/proc':
                raise CliError('writer-exec requires `--proc /proc`')
            has_proc = True
            i += 2
        else:
            raise CliError(f'unsupported or disallowed bwrap flag in writer-exec: {flag!r}')

    if not (has_unshare_pid and has_die_with_parent and has_ro_root and has_bind_cwd and has_dev and has_proc):
        raise CliError('writer-exec requires exact bwrap PID and mount isolation flags')
    if (overlay_src is None) != (tmp_overlay is None):
        raise CliError('writer-exec requires paired `--overlay-src` and `--tmp-overlay`')
    if overlay_src is not None and (overlay_src != tmp_overlay or overlay_src == Path('/') or not overlay_src.is_dir()):
        raise CliError('writer-exec overlay target must be an existing non-root directory')
    return bwrap_bin, bwrap_flags, payload_argv


def _read_bwrap_info(info_r: int, timeout: float = INFO_READ_TIMEOUT_SEC) -> dict:
    """Read bounded JSON metadata from bwrap --info-fd until EOF."""
    os.set_blocking(info_r, False)
    deadline = time.monotonic() + timeout
    chunks: list[bytes] = []
    total = 0
    with selectors.DefaultSelector() as sel:
        sel.register(info_r, selectors.EVENT_READ)
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not sel.select(timeout=remaining):
                raise CliError('bwrap --info-fd timed out before reporting child PID')
            try:
                chunk = os.read(info_r, MAX_INFO_BYTES + 1 - total)
            except BlockingIOError:
                continue
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_INFO_BYTES:
                raise CliError('bwrap --info-fd output exceeded byte limit')
            chunks.append(chunk)
    try:
        info = json.loads(b''.join(chunks).decode('utf-8'))
    except (UnicodeDecodeError, ValueError) as exc:
        raise CliError(f'bwrap --info-fd returned invalid JSON: {exc}') from None
    if not isinstance(info, dict):
        raise CliError('bwrap --info-fd payload must be a JSON object')
    return info


def _read_proc_identity(pid: int | str) -> tuple[int, str, tuple[int, ...], str, str]:
    """Read PPid, State, NStgid, starttime, and pid namespace symlink for a process."""
    try:
        status_text = Path(f'/proc/{pid}/status').read_text(encoding='utf-8')
        stat_text = Path(f'/proc/{pid}/stat').read_text(encoding='utf-8')
        ns_pid = os.readlink(f'/proc/{pid}/ns/pid')
    except OSError as exc:
        raise CliError(f'unable to inspect sandbox process {pid}: {exc}') from None
    ppid: int | None = None
    state = ''
    nstgid: tuple[int, ...] = ()
    for line in status_text.splitlines():
        if line.startswith('PPid:'):
            ppid = int(line.split(':', 1)[1].strip())
        elif line.startswith('State:'):
            state = line.split(':', 1)[1].strip()[:1]
        elif line.startswith('NStgid:'):
            nstgid = tuple(int(tok) for tok in line.split(':', 1)[1].split())
    rparen = stat_text.rfind(')')
    if rparen < 0:
        raise CliError(f'malformed /proc/{pid}/stat')
    fields = stat_text[rparen + 2:].split()
    if len(fields) <= 19 or ppid is None or not state or not nstgid or int(fields[1]) != ppid:
        raise CliError(f'incomplete /proc identity metadata for {pid}')
    return ppid, state, nstgid, fields[19], ns_pid


def _pin_verified_namespace_init(info: dict, launcher_pid: int) -> int:
    """Verify child-pid is a live nested PID namespace init under launcher and pin its pidfd."""
    child_pid = info.get('child-pid')
    if not isinstance(child_pid, int) or isinstance(child_pid, bool) or child_pid <= 1:
        raise CliError('bwrap --info-fd did not report a valid child-pid')
    _, _, host_nstgid, _, host_ns_pid = _read_proc_identity('self')

    def check_once() -> tuple[int, tuple[int, ...], str, str]:
        ppid, state, nstgid, starttime, ns_pid = _read_proc_identity(child_pid)
        if ppid != launcher_pid:
            raise CliError(f'child-pid {child_pid} is not a direct child of bwrap launcher {launcher_pid}')
        if state not in ('R', 'S', 'D'):
            raise CliError(f'child-pid {child_pid} is not live (state={state!r})')
        if len(nstgid) <= len(host_nstgid) or nstgid[-1] != 1:
            raise CliError(f'child-pid {child_pid} is not a nested PID namespace init ({nstgid})')
        if ns_pid == host_ns_pid:
            raise CliError(f'child-pid {child_pid} remained in host PID namespace')
        reported_ns = info.get('pid-namespace')
        if isinstance(reported_ns, int) and not isinstance(reported_ns, bool) and ns_pid != f'pid:[{reported_ns}]':
            raise CliError(f'child-pid {child_pid} pid namespace mismatch')
        return ppid, nstgid, starttime, ns_pid

    ident_before = check_once()
    pidfd = os.pidfd_open(child_pid, 0)
    try:
        ident_after = check_once()
        if ident_after != ident_before:
            raise CliError(f'child-pid {child_pid} identity changed during pidfd verification')
    except Exception:
        os.close(pidfd)
        raise
    return pidfd


def _validate_writer_state_path(
    db_path: Path,
    resolved_cwd: Path,
    *,
    require_exists: bool = False,
) -> tuple[int, int] | None:
    """Require a symlink-free, single-link regular ledger pathname outside the writable worktree."""
    if not db_path.is_absolute():
        raise CliError('writer ledger path must be an absolute path outside the writable worktree')
    norm_parts: list[str] = []
    missing_seen = False
    last_st: os.stat_result | None = None
    parts = db_path.parts
    for idx, part in enumerate(parts[1:], start=1):
        is_last = idx == len(parts) - 1
        if part == '.':
            continue
        if part == '..':
            if missing_seen:
                raise CliError('writer ledger path must not traverse missing directories with `..` outside the writable worktree')
            if norm_parts:
                norm_parts.pop()
            cur = Path('/', *norm_parts)
            if cur == resolved_cwd or cur.is_relative_to(resolved_cwd):
                raise CliError('writer ledger path must not be inside the writable worktree')
            continue
        norm_parts.append(part)
        cur = Path('/', *norm_parts)
        if cur == resolved_cwd or cur.is_relative_to(resolved_cwd):
            raise CliError('writer ledger path must not be inside the writable worktree')
        try:
            st = os.lstat(cur)
        except FileNotFoundError:
            missing_seen = True
            continue
        except OSError as exc:
            raise CliError(f'unable to inspect writer ledger path outside the writable worktree: {exc}') from None
        if missing_seen:
            raise CliError('writer ledger path state changed during writable worktree isolation check')
        if stat.S_ISLNK(st.st_mode):
            raise CliError(f'writer ledger path must be symlink-free and outside the writable worktree: {cur}')
        if not is_last and not stat.S_ISDIR(st.st_mode):
            raise CliError(f'writer ledger parent component is not a directory outside the writable worktree: {cur}')
        if is_last:
            if not stat.S_ISREG(st.st_mode):
                raise CliError(f'writer ledger path must be a regular file outside the writable worktree: {cur}')
            if st.st_nlink != 1:
                raise CliError(
                    f'writer ledger path must not have hardlink aliases outside the writable worktree '
                    f'(st_nlink={st.st_nlink}): {cur}'
                )
            last_st = st
    try:
        state_candidates = (db_path.resolve(), db_path.parent.resolve(), db_path.parent.parent.resolve())
    except OSError as exc:
        raise CliError(f'unable to resolve writer ledger path: {exc}') from None
    if any(candidate == resolved_cwd or candidate.is_relative_to(resolved_cwd) for candidate in state_candidates):
        raise CliError('writer ledger path must not be inside the writable worktree')
    if require_exists or last_st is not None:
        return _verify_ledger_inode(db_path, require_exists=require_exists, expected_lstat=last_st)
    return None


def _switch_host(db_path: Path, cwd: Path) -> dict:
    proc_fd, proc_st = _open_pinned_proc_root()
    try:
        ns, mounts = _verify_initial_pid_namespace_and_procfs(proc_fd, proc_st)
        boot = _validate_boot_id(_read_host_boot_id(proc_fd))
    finally:
        os.close(proc_fd)
    ledger = _inspect_ledger_provenance(db_path, cwd, mounts)
    return dict(ledger, pid_ns_inode=ns, boot=boot, machine=_hash_machine_id(_read_machine_id_raw()))


def _pidfs_inode(fd: int) -> int:
    if _fstatfs_magic(fd) != 0x50494446:
        raise CliError('switch requires Linux pidfs-backed pidfds')
    return os.fstat(fd).st_ino


def _save_switch_witness(db_path, cwd, attempt, actor, child_pid, child_fd, registered_ledger):
    # Older kernels and non-durable ledgers retain the original fail-closed fence.
    try:
        host = _switch_host(db_path, cwd)
        supervisor_fd = os.pidfd_open(os.getpid())
        try:
            identities = [(os.getpid(), _pidfs_inode(supervisor_fd)), (child_pid, _pidfs_inode(child_fd))]
        finally:
            os.close(supervisor_fd)
    except (OSError, CliError):
        return
    if (host['ledger_dev'], host['ledger_ino']) != registered_ledger:
        raise CliError('writer ledger changed before GO; fence retained')
    with _open_recovery_write_tx(db_path, host) as conn:
        conn.execute("""CREATE TABLE IF NOT EXISTS writer_switch_witness (
            attempt_id TEXT PRIMARY KEY REFERENCES writer_attempts(attempt_id), actor TEXT NOT NULL,
            host TEXT NOT NULL, identities TEXT NOT NULL)""")
        for action in ('UPDATE', 'DELETE'):
            conn.execute(f"""CREATE TRIGGER IF NOT EXISTS writer_switch_witness_no_{action}
                             BEFORE {action} ON writer_switch_witness
                             BEGIN SELECT RAISE(ABORT,'immutable writer identity'); END""")
        conn.execute('INSERT INTO writer_switch_witness VALUES (?,?,?,?)',
                     (attempt, actor, json.dumps(host, sort_keys=True), json.dumps(identities)))


def _stop_switch_source(conn, attempt, actor, host, db_path):
    _verify_pinned_ledger_under_tx(db_path, host)
    has_table = conn.execute("SELECT 1 FROM sqlite_master WHERE name='writer_switch_witness'").fetchone()
    witness = has_table and conn.execute('SELECT * FROM writer_switch_witness WHERE attempt_id=?',
                                         (attempt['attempt_id'],)).fetchone()
    if witness and (witness['actor'] != actor or json.loads(witness['host']) != host):
        raise CliError('writer switch: actor or host/ledger evidence mismatch')
    if attempt['status'] == 'closed':
        if attempt['exit_code'] is None:
            raise CliError('writer switch requires verified exit, not a retirement')
        return 'verified_exit'
    if not witness:
        raise CliError('writer switch: no pre-GO identity evidence; fence retained')
    with ExitStack() as stack:
        identities = json.loads(witness['identities'])
        if (not isinstance(identities, list) or len(identities) != 2
            or any(not isinstance(pair, list) or len(pair) != 2
                   or any(type(n) is not int or n <= 1 for n in pair) for pair in identities)
            or identities[0][0] == identities[1][0] or identities[0][1] == identities[1][1]):
            raise CliError('writer switch: incomplete process identity evidence; fence retained')
        pinned = []
        for pid, inode in identities:
            try:
                fd = os.pidfd_open(pid)
            except ProcessLookupError:
                continue
            stack.callback(os.close, fd)
            if _pidfs_inode(fd) != inode:
                raise CliError('writer switch: process identity mismatch; fence retained')
            pinned.append(fd)
        # Pin every live identity before signaling either. A dead supervisor
        # cannot issue GO; a dead namespace init cannot leave a writer behind.
        for fd in pinned:
            try:
                signal.pidfd_send_signal(fd, signal.SIGKILL)
            except ProcessLookupError:
                pass
        for fd in pinned:
            with selectors.DefaultSelector() as poll:
                poll.register(fd, selectors.EVENT_READ)
                if not poll.select(timeout=2):
                    raise CliError('writer switch: exit not witnessed; fence retained')
    cur = conn.execute("""UPDATE writer_attempts SET status='closed',closed_at=?,exit_code=NULL
                          WHERE attempt_id=? AND status='open'""",
                       (format_utc(utc_now()), attempt['attempt_id']))
    if cur.rowcount != 1:
        raise CliError('writer switch: source fence changed')
    return 'interrupted'


def cmd_writer_exec(args: argparse.Namespace, db_path: Path) -> tuple[int, None]:
    with ExitStack() as resources:
        return _writer_exec(args, db_path, resources)


def _writer_exec(args, db_path, resources):
    """Register a writer fence attempt, supervise isolated bwrap execution, and close only on verified exit."""
    if not hasattr(os, 'pidfd_open'):
        raise CliError('Linux os.pidfd_open is required for writer-exec')
    python_bin = TRUSTED_PYTHON_BIN
    if not python_bin or not os.path.isabs(python_bin) or not os.access(python_bin, os.X_OK):
        raise CliError('trusted absolute Python executable is required for writer-exec')
    explicit_run_id = validate_run_id(args.run_id) if args.run_id is not None else None
    raw_argv = list(args.argv or [])
    if raw_argv and raw_argv[0] == '--':
        raw_argv = raw_argv[1:]
    bwrap_bin, bwrap_flags, payload_argv = _validate_writer_bwrap_argv(raw_argv, args.cwd)
    resolved_cwd = Path(args.cwd).resolve()
    pre_ledger_id = _validate_writer_state_path(db_path, resolved_cwd, require_exists=False)
    repo_key = canonicalize_repo(args.cwd, git_bin=TRUSTED_GIT_BIN)
    worktree = scoped_worktree(args.cwd, repo_key, args.issue, git_bin=TRUSTED_GIT_BIN)
    attempt_id = f'wa-{secrets.token_hex(16)}'
    now = format_utc(utc_now())

    source = getattr(args, 'switch_from', None)
    actor = getattr(args, 'claim_actor', None)
    switch_host = None
    if source:
        if not actor or not ATTEMPT_ID_RE.fullmatch(source):
            raise CliError('writer switch requires an exact attempt ID and claim actor')
        _verify_linked_worktree_backlink(resolved_cwd, Path(worktree))
        switch_host = _switch_host(db_path, resolved_cwd)

    with _open_short_active_write_tx(db_path, repo_key, git_bin=TRUSTED_GIT_BIN) as (conn, active_rows, resolved_keys):
        same_repo_runs = [row for row in active_rows if resolved_keys[row['repo_key']] == repo_key]
        bound_run = None
        for row in same_repo_runs:
            if row['issue'] is None:
                raise CliError(
                    f'writer fence: exclusive unscoped run {row["run_id"]} ({row["status"]}) active for {repo_key}'
                )
            norm_row_wt = os.path.realpath(row['worktree']) if row['worktree'] else None
            if row['issue'] == args.issue:
                if norm_row_wt != worktree:
                    raise CliError(
                        f'writer fence: active run {row["run_id"]} for {args.issue} is bound to different worktree {row["worktree"]!r}'
                    )
                if row['status'] != 'active':
                    raise CliError(
                        f'writer fence: run {row["run_id"]} for {args.issue} is {row["status"]}, not active'
                    )
                bound_run = row
            elif norm_row_wt == worktree:
                raise CliError(
                    f'writer fence: worktree {worktree} already bound to active run {row["run_id"]} ({row["issue"]})'
                )
        if explicit_run_id is not None:
            if bound_run is None:
                explicit_row = conn.execute(
                    'SELECT run_id, status FROM runs WHERE run_id = ?',
                    (explicit_run_id,),
                ).fetchone()
                if explicit_row is None:
                    raise CliError(f'writer fence: explicit --run-id {explicit_run_id!r} not found')
                if explicit_row['status'] in TERMINAL_STATUSES:
                    raise CliError(
                        f'writer fence: explicit --run-id {explicit_run_id!r} is terminal ({explicit_row["status"]})'
                    )
                raise CliError(
                    f'writer fence: explicit --run-id {explicit_run_id!r} does not match active scope for '
                    f'{args.issue} in {worktree}'
                )
            if bound_run['run_id'] != explicit_run_id:
                raise CliError(
                    f'writer fence: explicit --run-id {explicit_run_id!r} does not match active run '
                    f'{bound_run["run_id"]!r} for {args.issue}'
                )
        elif bound_run is not None and bound_run['local_only']:
            raise CliError(
                f'writer fence: active local-only run {bound_run["run_id"]!r} requires explicit --run-id'
            )
        bound = 1 if bound_run is not None else 0
        run_id = bound_run['run_id'] if bound_run is not None else None
        if not bound and same_repo_runs:
            raise CliError(
                f'writer fence: unbound writer cannot start while active run {same_repo_runs[0]["run_id"]} exists for {repo_key}'
            )

        if source:
            if not bound or fetch_run(conn, run_id)['current_stage'] not in ('implement', 'review'):
                raise CliError('writer switch requires an active bound implementation or review')
            old = conn.execute("""SELECT * FROM writer_attempts WHERE run_id=?
                                ORDER BY rowid DESC LIMIT 1""", (run_id,)).fetchone()
            if not old or (old['attempt_id'], old['repo_key'], old['issue'], old['worktree']) != (
                    source, repo_key, args.issue, worktree):
                raise CliError('writer switch: stale or mismatched source attempt')
            if external_patch_table(conn) and conn.execute(
                'SELECT 1 FROM waits JOIN external_patches ON wait_id=waits.id WHERE waits.run_id=?', (run_id,)
            ).fetchone():
                raise CliError('writer switch cannot reset an external patch wait')
            disposition = _stop_switch_source(conn, old, actor, switch_host, db_path)
            lockfd = os.open(resolved_cwd, os.O_DIRECTORY | os.O_CLOEXEC)
            resources.callback(os.close, lockfd)
            try:
                fcntl.flock(lockfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise CliError('writer switch: worktree lock still held; fence retained') from None

        open_attempts = conn.execute(
            "SELECT attempt_id, repo_key, worktree, issue, bound FROM writer_attempts WHERE status = 'open'"
        ).fetchall()
        for att in open_attempts:
            same_repo = att['repo_key'] == repo_key
            same_wt = att['worktree'] == worktree
            if not same_repo and not same_wt:
                continue
            if not att['bound']:
                raise CliError(
                    f'writer fence: exclusive unbound writer attempt {att["attempt_id"]} already open for {repo_key}'
                )
            if not bound:
                raise CliError(
                    f'writer fence: unbound writer cannot start while writer attempt {att["attempt_id"]} is open for {repo_key}'
                )
            if att['issue'] == args.issue:
                raise CliError(
                    f'writer fence: writer attempt {att["attempt_id"]} already open for issue {args.issue}'
                )
            if same_wt:
                raise CliError(
                    f'writer fence: writer attempt {att["attempt_id"]} already open for worktree {worktree}'
                )

        try:
            conn.execute(
                """
                INSERT INTO writer_attempts (
                    attempt_id, repo_key, worktree, issue, bound, run_id, status, created_at
                ) VALUES (?, ?, ?, ?, ?, ?, 'open', ?)
                """,
                (attempt_id, repo_key, worktree, args.issue, bound, run_id, now),
            )
            if source:
                conn.execute("""CREATE TABLE IF NOT EXISTS writer_switches (
                    source TEXT PRIMARY KEY REFERENCES writer_attempts(attempt_id),
                    replacement TEXT UNIQUE NOT NULL REFERENCES writer_attempts(attempt_id),
                    actor TEXT NOT NULL, disposition TEXT NOT NULL)""")
                conn.execute('INSERT INTO writer_switches VALUES (?,?,?,?)',
                             (source, attempt_id, actor, disposition))
                _verify_pinned_ledger_under_tx(db_path, switch_host)
        except sqlite3.IntegrityError as exc:
            raise CliError(f'writer fence conflict for {repo_key}: {exc}') from exc

    post_ledger_id = _validate_writer_state_path(db_path, resolved_cwd, require_exists=True)
    if pre_ledger_id is not None and post_ledger_id != pre_ledger_id:
        raise CliError('writer ledger inode changed during registration; leaving writer fence open')

    info_r, info_w = os.pipe2(os.O_CLOEXEC)
    go_r, go_w = os.pipe2(os.O_CLOEXEC)
    pidfd = -1
    proc: subprocess.Popen[bytes] | None = None
    try:
        bwrap_cmd = [
            bwrap_bin,
            *bwrap_flags,
            '--info-fd',
            str(info_w),
            '--',
            python_bin,
            '-I',
            '-S',
            '-c',
            TRUSTED_WRITER_BOOTSTRAP_PY,
            *payload_argv,
        ]
        proc = subprocess.Popen(
            bwrap_cmd,
            cwd=args.cwd,
            stdin=go_r,
            stdout=None,
            stderr=None,
            pass_fds=(info_w,),
            close_fds=True,
        )
        os.close(info_w)
        info_w = -1
        os.close(go_r)
        go_r = -1

        info = _read_bwrap_info(info_r)
        os.close(info_r)
        info_r = -1

        pidfd = _pin_verified_namespace_init(info, proc.pid)
        if proc.poll() is not None:
            raise CliError(f'bwrap launcher exited prematurely ({proc.returncode}) before GO')

        if bound and actor:
            _save_switch_witness(db_path, resolved_cwd, attempt_id, actor, info['child-pid'], pidfd, post_ledger_id)
        view = memoryview(b'GO')
        sent = 0
        while sent < len(view):
            n = os.write(go_w, view[sent:])
            if n <= 0:
                raise CliError('failed to deliver GO to isolated sandbox bootstrap')
            sent += n
        os.close(go_w)
        go_w = -1

        launcher_rc = proc.wait()
        if launcher_rc < 0:
            return 128 + (-launcher_rc), None

        with selectors.DefaultSelector() as sel:
            sel.register(pidfd, selectors.EVENT_READ)
            if not sel.select(timeout=PIDFD_WAIT_TIMEOUT_SEC):
                raise CliError('namespace-init pidfd not readable after launcher wait; leaving writer fence open')

        closed_at = format_utc(utc_now())
        with open_write_tx(db_path) as conn:
            cur = conn.execute(
                """
                UPDATE writer_attempts
                SET status = 'closed', exit_code = ?, closed_at = ?
                WHERE attempt_id = ? AND status = 'open'
                """,
                (launcher_rc, closed_at, attempt_id),
            )
            if cur.rowcount != 1:
                raise CliError(f'writer fence close mismatch for {attempt_id}')
        return launcher_rc, None
    finally:
        for fd in (info_w, info_r, go_r, go_w, pidfd):
            if fd >= 0:
                try:
                    os.close(fd)
                except OSError:
                    pass
        if proc is not None and proc.poll() is None:
            try:
                proc.kill()
                proc.wait(timeout=5)
            except (OSError, subprocess.SubprocessError):
                pass


class _OpenHow(ctypes.Structure):
    """Linux struct open_how layout for openat2(2)."""

    _fields_ = [
        ('flags', ctypes.c_uint64),
        ('mode', ctypes.c_uint64),
        ('resolve', ctypes.c_uint64),
    ]


class _StatFsBuf(ctypes.Structure):
    """Aligned 64-bit Linux struct statfs buffer with native long f_type."""

    _fields_ = [
        ('f_type', ctypes.c_long),
        ('_pad', ctypes.c_long * 31),
    ]


def _require_supported_linux_abi(feature: str) -> str:
    """Require Linux on a supported 64-bit LP64 architecture and ABI."""
    if sys.platform != 'linux':
        raise CliError(f'{feature} requires Linux (got {sys.platform!r})')
    machine = os.uname().machine
    if machine not in OPENAT2_SYSCALL_NR:
        raise CliError(f'{feature} is not supported on architecture {machine!r}')
    if ctypes.sizeof(ctypes.c_long) != 8 or ctypes.sizeof(ctypes.c_void_p) != 8:
        raise CliError(f'{feature} requires 64-bit LP64 ABI on {machine!r}')
    return machine


def _fstatfs_magic(fd: int) -> int:
    """Inspect kernel filesystem magic for an open FD via pinned libc fstatfs(2)."""
    _require_supported_linux_abi('fstatfs')
    if not isinstance(fd, int) or isinstance(fd, bool) or fd < 0:
        raise CliError(f'fstatfs requires a valid open file descriptor (got {fd!r})')
    buf = _StatFsBuf()
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        fstatfs_fn = libc.fstatfs
    except (OSError, AttributeError) as exc:
        raise CliError(f'unable to resolve libc fstatfs: {exc}') from None
    fstatfs_fn.argtypes = [ctypes.c_int, ctypes.POINTER(_StatFsBuf)]
    fstatfs_fn.restype = ctypes.c_int
    ctypes.set_errno(0)
    rc = fstatfs_fn(fd, ctypes.byref(buf))
    if rc != 0:
        err = ctypes.get_errno() or errno.EIO
        raise CliError(f'unable to inspect filesystem magic via fstatfs: {os.strerror(err)}')
    return int(buf.f_type)


def _linux_openat2(dir_fd: int, rel_path: str, flags: int, resolve: int) -> int:
    """Open rel_path beneath dir_fd using Linux openat2(2) with explicit resolve flags."""
    machine = _require_supported_linux_abi('openat2')
    nr = OPENAT2_SYSCALL_NR[machine]
    if not rel_path or os.path.isabs(rel_path) or '\x00' in rel_path:
        raise CliError(f'openat2 requires a non-empty relative path (got {rel_path!r})')
    how = _OpenHow(flags=flags, mode=0, resolve=resolve)
    libc = ctypes.CDLL(None, use_errno=True)
    syscall_fn = libc.syscall
    syscall_fn.argtypes = [
        ctypes.c_long,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.POINTER(_OpenHow),
        ctypes.c_size_t,
    ]
    syscall_fn.restype = ctypes.c_long
    ctypes.set_errno(0)
    fd = syscall_fn(
        nr,
        dir_fd,
        rel_path.encode('utf-8'),
        ctypes.byref(how),
        ctypes.sizeof(how),
    )
    if fd < 0:
        err = ctypes.get_errno() or errno.EIO
        raise OSError(err, os.strerror(err))
    return int(fd)


def _open_pinned_proc_root() -> tuple[int, os.stat_result]:
    """Open /proc without following symlinks and verify its procfs inode and kernel magic."""
    try:
        proc_fd = os.open('/proc', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        raise CliError(f'unable to open /proc directory: {exc}') from None
    try:
        try:
            st = os.fstat(proc_fd)
        except OSError as exc:
            raise CliError(f'unable to fstat /proc directory: {exc}') from None
        if not stat.S_ISDIR(st.st_mode) or st.st_ino != PROC_ROOT_INO:
            raise CliError(
                f'untrusted /proc root inode (expected dir inode {PROC_ROOT_INO}, got mode={oct(st.st_mode)} ino={st.st_ino})'
            )
        fs_magic = _fstatfs_magic(proc_fd)
        if fs_magic != PROC_SUPER_MAGIC:
            raise CliError(
                f'untrusted /proc filesystem magic (expected {PROC_SUPER_MAGIC:#x}, got {fs_magic:#x})'
            )
    except Exception:
        os.close(proc_fd)
        raise
    return proc_fd, st


def _read_host_boot_id(proc_fd: int) -> str:
    """Read the raw host boot_id string from a pinned real procfs root FD without crossing mounts or symlinks."""
    try:
        fd = _linux_openat2(
            proc_fd,
            'sys/kernel/random/boot_id',
            os.O_RDONLY | os.O_CLOEXEC,
            RESOLVE_BENEATH | RESOLVE_NO_XDEV | RESOLVE_NO_SYMLINKS,
        )
    except OSError as exc:
        raise CliError(f'unable to read host boot_id from pinned procfs root: {exc}') from None
    return _read_fd_text(fd, '/proc/sys/kernel/random/boot_id', max_bytes=128).strip()


def _validate_boot_id(raw: object) -> str:
    """Validate a typed nonzero lowercase Linux kernel boot UUID."""
    if not isinstance(raw, str):
        raise CliError('invalid or zero host boot_id')
    text = raw.strip()
    if not UUID_LOWER_RE.fullmatch(text):
        raise CliError('invalid or zero host boot_id')
    try:
        parsed = uuid.UUID(text)
    except ValueError:
        raise CliError('invalid or zero host boot_id') from None
    if parsed.int == 0 or str(parsed) != text:
        raise CliError('invalid or zero host boot_id')
    return str(parsed)


def _validate_machine_id(raw: object) -> str:
    """Validate an exact canonical nonzero 32-hex lowercase host machine ID."""
    if not isinstance(raw, str) or not MACHINE_ID_RE.fullmatch(raw):
        raise CliError('invalid or zero /etc/machine-id')
    try:
        parsed = uuid.UUID(hex=raw)
    except ValueError:
        raise CliError('invalid or zero /etc/machine-id') from None
    if parsed.int == 0 or parsed.hex != raw:
        raise CliError('invalid or zero /etc/machine-id')
    return parsed.hex


def _open_machine_id_fd() -> int:
    """Open /etc/machine-id read-only without following symlinks."""
    try:
        return os.open('/etc/machine-id', os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        raise CliError(f'unable to read /etc/machine-id: {exc}') from None


def _read_machine_id_fd(fd: int) -> str:
    """Read and validate the host machine ID from a pinned regular FD through EOF."""
    raw_text = _read_fd_text(fd, '/etc/machine-id', max_bytes=128)
    candidate = raw_text[:-1] if raw_text.endswith('\n') else raw_text
    return _validate_machine_id(candidate)


def _read_machine_id_raw() -> str:
    """Read and validate the host machine ID without following symlinks."""
    return _read_machine_id_fd(_open_machine_id_fd())


def _hash_machine_id(raw: object) -> str:
    """Return a domain-separated SHA-256 digest of a validated machine ID."""
    validated = _validate_machine_id(raw)
    return sha256(f'pi-team-run:machine-id:v1:{validated}'.encode('utf-8')).hexdigest()


def _read_proc_self_pid(proc_fd: int) -> int:
    """Read /proc/self symlink on an authenticated pinned procfs FD and verify it matches os.getpid()."""
    try:
        lst = os.lstat('self', dir_fd=proc_fd)
        if not stat.S_ISLNK(lst.st_mode):
            raise CliError('/proc/self must be a procfs symlink')
        self_target = os.readlink('self', dir_fd=proc_fd)
    except OSError as exc:
        raise CliError(f'unable to read /proc/self symlink: {exc}') from None
    expected_pid = os.getpid()
    if not self_target.isascii() or not self_target.isdigit() or self_target != str(expected_pid):
        raise CliError(
            f'/proc/self PID mismatch against caller PID (expected {expected_pid}, got {self_target!r})'
        )
    return expected_pid


def _read_proc_self_mountinfo(proc_fd: int) -> str:
    """Read /proc/<pid>/mountinfo relative to a pinned procfs root FD without crossing mounts or symlinks."""
    pid = _read_proc_self_pid(proc_fd)
    try:
        fd = _linux_openat2(
            proc_fd,
            f'{pid}/mountinfo',
            os.O_RDONLY | os.O_CLOEXEC,
            RESOLVE_BENEATH | RESOLVE_NO_XDEV | RESOLVE_NO_SYMLINKS,
        )
    except OSError as exc:
        raise CliError(f'unable to read /proc/self/mountinfo: {exc}') from None
    return _read_fd_text(fd, '/proc/self/mountinfo', max_bytes=4 * 1024 * 1024)


def _read_proc_self_status(proc_fd: int) -> str:
    """Read /proc/<pid>/status relative to a pinned procfs root FD without crossing mounts or symlinks."""
    pid = _read_proc_self_pid(proc_fd)
    try:
        fd = _linux_openat2(
            proc_fd,
            f'{pid}/status',
            os.O_RDONLY | os.O_CLOEXEC,
            RESOLVE_BENEATH | RESOLVE_NO_XDEV | RESOLVE_NO_SYMLINKS,
        )
    except OSError as exc:
        raise CliError(f'unable to read /proc/self/status: {exc}') from None
    return _read_fd_text(fd, '/proc/self/status', max_bytes=262144)


def _read_proc_self_ns_pid(proc_fd: int) -> tuple[str, int]:
    """Read /proc/<pid>/ns/pid symlink target and inode relative to a pinned procfs root FD."""
    pid = _read_proc_self_pid(proc_fd)
    try:
        ns_fd = _linux_openat2(
            proc_fd,
            f'{pid}/ns',
            os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC,
            RESOLVE_BENEATH | RESOLVE_NO_XDEV | RESOLVE_NO_SYMLINKS,
        )
    except OSError as exc:
        raise CliError(f'unable to open /proc/self/ns: {exc}') from None
    try:
        lst = os.lstat('pid', dir_fd=ns_fd)
        if not stat.S_ISLNK(lst.st_mode):
            raise CliError('/proc/self/ns/pid must be a procfs namespace symlink')
        link = os.readlink('pid', dir_fd=ns_fd)
        st = os.stat('pid', dir_fd=ns_fd, follow_symlinks=True)
    except OSError as exc:
        raise CliError(f'unable to inspect /proc/self/ns/pid: {exc}') from None
    finally:
        os.close(ns_fd)
    return link, st.st_ino


def _read_fd_statvfs_fsid(fd: int) -> int:
    """Read os.fstatvfs(fd).f_fsid for an open ledger file descriptor."""
    try:
        return int(os.fstatvfs(fd).f_fsid)
    except OSError as exc:
        raise CliError(f'unable to inspect ledger filesystem ID: {exc}') from None


def _read_path_statvfs_fsid(path: Path) -> int:
    """Read os.statvfs(path).f_fsid without opening a file descriptor."""
    try:
        return int(os.statvfs(path).f_fsid)
    except OSError as exc:
        raise CliError(f'unable to inspect ledger filesystem ID: {exc}') from None


def _unescape_mountinfo(token: str) -> str:
    """Decode octal escapes used in /proc/self/mountinfo paths."""
    return re.sub(r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), token)


def _parse_mountinfo(text: str) -> list[tuple[str, str, str, str]]:
    """Parse /proc/self/mountinfo into (dev_maj_min, mount_root, mount_point, fs_type) tuples."""
    entries: list[tuple[str, str, str, str]] = []
    for line in text.splitlines():
        if not line:
            continue
        parts = line.split(' - ')
        if len(parts) != 2:
            raise CliError('malformed /proc/self/mountinfo entry')
        left = parts[0].split(' ')
        right = parts[1].split(' ')
        if len(left) < 6 or len(right) < 2:
            raise CliError('incomplete /proc/self/mountinfo entry')
        if not left[0].isdigit() or not left[1].isdigit():
            raise CliError('invalid mount ID in /proc/self/mountinfo')
        dev_maj_min = left[2]
        if not re.fullmatch(r'[0-9]+:[0-9]+', dev_maj_min):
            raise CliError('invalid device major:minor in /proc/self/mountinfo')
        mount_root = _unescape_mountinfo(left[3])
        mount_point = _unescape_mountinfo(left[4])
        fs_type = right[0]
        if not fs_type or not mount_point.startswith('/') or '\x00' in mount_root or '\x00' in mount_point:
            raise CliError('invalid mount path or filesystem type in /proc/self/mountinfo')
        valid_root = mount_root.startswith('/') or (
            fs_type == 'nsfs' and NSFS_MOUNT_ROOT_RE.fullmatch(mount_root) is not None
        )
        if not valid_root:
            raise CliError('invalid mount root in /proc/self/mountinfo')
        entries.append((dev_maj_min, mount_root, mount_point, fs_type))
    if not entries:
        raise CliError('empty /proc/self/mountinfo')
    return entries


def _verify_initial_pid_namespace_and_procfs(
    proc_fd: int,
    proc_st: os.stat_result,
) -> tuple[int, list[tuple[str, str, str, str]]]:
    """Verify authenticated /proc mountinfo against pinned /proc FD and initial host PID namespace."""
    if not stat.S_ISDIR(proc_st.st_mode) or proc_st.st_ino != PROC_ROOT_INO:
        raise CliError(f'untrusted /proc root inode ({proc_st.st_ino})')
    fs_magic = _fstatfs_magic(proc_fd)
    if fs_magic != PROC_SUPER_MAGIC:
        raise CliError(
            f'untrusted /proc filesystem magic (expected {PROC_SUPER_MAGIC:#x}, got {fs_magic:#x})'
        )
    pid_str = str(_read_proc_self_pid(proc_fd))

    mounts = _parse_mountinfo(_read_proc_self_mountinfo(proc_fd))
    proc_mounts = [m for m in mounts if m[2] == '/proc']
    if len(proc_mounts) != 1:
        raise CliError(
            f'expected unique /proc mount in /proc/self/mountinfo (found {len(proc_mounts)})'
        )
    proc_dev_maj_min, proc_root, _, proc_fs = proc_mounts[0]
    if proc_fs != 'proc' or proc_root != '/':
        raise CliError(f'untrusted /proc mount ({proc_fs}, root={proc_root!r})')
    actual_proc_maj_min = f'{os.major(proc_st.st_dev)}:{os.minor(proc_st.st_dev)}'
    if actual_proc_maj_min != proc_dev_maj_min:
        raise CliError(
            f'pinned /proc root device mismatch against mountinfo ({actual_proc_maj_min} != {proc_dev_maj_min})'
        )

    shadowed_proc_paths = {
        '/proc/sys',
        '/proc/sys/kernel',
        '/proc/sys/kernel/random',
        '/proc/sys/kernel/random/boot_id',
        '/proc/self',
        '/proc/self/ns',
        '/proc/self/ns/pid',
        '/proc/self/status',
        '/proc/self/mountinfo',
        f'/proc/{pid_str}',
        f'/proc/{pid_str}/ns',
        f'/proc/{pid_str}/ns/pid',
        f'/proc/{pid_str}/status',
        f'/proc/{pid_str}/mountinfo',
    }
    for _, _, mp, _ in mounts:
        if mp in shadowed_proc_paths:
            raise CliError(f'untrusted shadowed mount over {mp}')

    status_text = _read_proc_self_status(proc_fd)
    nstgid: tuple[int, ...] = ()
    for line in status_text.splitlines():
        if line.startswith('NStgid:'):
            try:
                nstgid = tuple(int(tok) for tok in line.split(':', 1)[1].split())
            except ValueError:
                raise CliError('malformed NStgid in /proc/self/status') from None
            break
    if len(nstgid) != 1:
        raise CliError(f'writer-recovery requires the initial host PID namespace (NStgid={nstgid})')

    ns_link, ns_ino = _read_proc_self_ns_pid(proc_fd)
    expected_link = f'pid:[{PROC_PID_INIT_INO}]'
    if ns_link != expected_link or ns_ino != PROC_PID_INIT_INO:
        raise CliError(f'writer-recovery requires the initial host PID namespace (got {ns_link}, ino={ns_ino})')
    return PROC_PID_INIT_INO, mounts


def _verify_private_mode(st: os.stat_result, label: str, *, is_dir: bool, euid: int) -> None:
    """Require current-user ownership and no group or other permission bits."""
    if stat.S_ISLNK(st.st_mode) or (not stat.S_ISDIR(st.st_mode) if is_dir else not stat.S_ISREG(st.st_mode)):
        kind = 'directory' if is_dir else 'regular file'
        raise CliError(f'{label} must be a {kind}')
    if st.st_uid != euid:
        raise CliError(f'{label} is not owned by the current user')
    if stat.S_IMODE(st.st_mode) & (stat.S_IRWXG | stat.S_IRWXO):
        raise CliError(f'{label} must have private permissions (no group/other bits)')


def _inspect_ledger_provenance(
    db_path: Path,
    resolved_cwd: Path,
    mounts: list[tuple[str, str, str, str]],
) -> dict:
    """Verify symlink-free private local durable ledger file and return pinned provenance."""
    pre_dev, pre_ino = _validate_writer_state_path(db_path, resolved_cwd, require_exists=True)
    norm_path = Path(os.path.normpath(str(db_path)))
    try:
        resolved_norm = norm_path.resolve(strict=True)
    except OSError as exc:
        raise CliError(f'unable to resolve writer ledger path: {exc}') from None
    if resolved_norm != norm_path:
        raise CliError(f'writer ledger path must be normalized and symlink-free: {db_path}')

    try:
        parent_st = os.lstat(norm_path.parent)
    except OSError as exc:
        raise CliError(f'unable to inspect writer ledger directory: {exc}') from None
    euid = os.geteuid()
    _verify_private_mode(parent_st, 'writer ledger directory', is_dir=True, euid=euid)

    try:
        fd = os.open(norm_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        raise CliError(f'unable to open writer ledger for provenance verification: {exc}') from None
    try:
        fst = os.fstat(fd)
        _verify_private_mode(fst, 'writer ledger file', is_dir=False, euid=euid)
        if fst.st_nlink != 1:
            raise CliError(f'writer ledger path must not have hardlink aliases (st_nlink={fst.st_nlink})')
        if (fst.st_dev, fst.st_ino) != (pre_dev, pre_ino):
            raise CliError('writer ledger inode changed during provenance verification')

        matching_mounts = [
            m for m in mounts
            if norm_path == Path(m[2]) or norm_path.is_relative_to(Path(m[2]))
        ]
        if not matching_mounts:
            raise CliError(f'no mount entry found for writer ledger path: {norm_path}')
        max_depth = max(len(Path(m[2]).parts) for m in matching_mounts)
        dev_maj_min, _, _, fs_type = [
            m for m in matching_mounts if len(Path(m[2]).parts) == max_depth
        ][-1]
        expected_magic = LOCAL_DURABLE_FS_MAGICS.get(fs_type)
        if expected_magic is None:
            raise CliError(
                f'writer ledger filesystem {fs_type!r} is not an allowed local durable filesystem'
            )
        actual_magic = _fstatfs_magic(fd)
        if actual_magic != expected_magic:
            raise CliError(
                f'writer ledger filesystem magic mismatch for {fs_type!r} '
                f'(expected {expected_magic:#x}, got {actual_magic:#x})'
            )
        actual_maj_min = f'{os.major(fst.st_dev)}:{os.minor(fst.st_dev)}'
        if fs_type != 'btrfs':
            if dev_maj_min != actual_maj_min:
                raise CliError(
                    f'writer ledger device mismatch against mountinfo ({actual_maj_min} != {dev_maj_min})'
                )
        elif os.major(fst.st_dev) != 0 and dev_maj_min != actual_maj_min:
            raise CliError(
                f'writer ledger btrfs device mismatch against mountinfo ({actual_maj_min} != {dev_maj_min})'
            )

        fsid = _read_fd_statvfs_fsid(fd)
        if not isinstance(fsid, int) or isinstance(fsid, bool) or fsid <= 0:
            raise CliError(f'writer ledger filesystem ID is unavailable or zero ({fsid!r})')
    finally:
        os.close(fd)

    return {
        'ledger_path': str(norm_path),
        'ledger_dev': fst.st_dev,
        'ledger_ino': fst.st_ino,
        'ledger_fs_type': fs_type,
        'ledger_fsid': f'{fsid:016x}',
    }


def _verify_pinned_ledger_under_tx(db_path: Path, expected: dict) -> None:
    """Recheck ledger path, private permissions, single-link inode, and fsid without opening any DB fd."""
    norm_path = Path(expected['ledger_path'])
    euid = os.geteuid()

    def inspect_once() -> tuple[tuple[int, int, int, int], tuple[int, int, int, int, int]]:
        try:
            resolved = db_path.resolve(strict=True)
        except OSError as exc:
            raise CliError(f'writer ledger disappeared under mutation boundary: {exc}') from None
        if resolved != norm_path:
            raise CliError('writer ledger path changed under mutation boundary')
        try:
            parent_st = os.lstat(norm_path.parent)
            st = os.lstat(norm_path)
        except OSError as exc:
            raise CliError(f'writer ledger disappeared under mutation boundary: {exc}') from None
        _verify_private_mode(parent_st, 'writer ledger directory under mutation boundary', is_dir=True, euid=euid)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            raise CliError('writer ledger failed single-link regular file check under mutation boundary')
        _verify_private_mode(st, 'writer ledger file under mutation boundary', is_dir=False, euid=euid)
        if (st.st_dev, st.st_ino) != (expected['ledger_dev'], expected['ledger_ino']):
            raise CliError('writer ledger inode changed under mutation boundary')
        return (
            (parent_st.st_dev, parent_st.st_ino, parent_st.st_mode, parent_st.st_uid),
            (st.st_dev, st.st_ino, st.st_mode, st.st_uid, st.st_nlink),
        )

    before = inspect_once()
    fsid = _read_path_statvfs_fsid(norm_path)
    if not isinstance(fsid, int) or isinstance(fsid, bool) or f'{fsid:016x}' != expected['ledger_fsid']:
        raise CliError('writer ledger filesystem ID changed under mutation boundary')
    after = inspect_once()
    if after != before:
        raise CliError('writer ledger path changed under mutation boundary')


@contextmanager
def _open_recovery_write_tx(db_path: Path, expected_ledger: dict):
    """Open an existing v3/v4 state database rw inside BEGIN IMMEDIATE without creating or migrating."""
    _verify_pinned_ledger_under_tx(db_path, expected_ledger)
    norm_path = Path(expected_ledger['ledger_path'])
    conn = sqlite3.connect(f'{norm_path.as_uri()}?mode=rw', uri=True, timeout=5.0, isolation_level=None)
    conn.row_factory = sqlite3.Row
    try:
        _verify_pinned_ledger_under_tx(db_path, expected_ledger)
        conn.execute('PRAGMA busy_timeout = 5000')
        conn.execute('PRAGMA foreign_keys = ON')
        conn.execute('PRAGMA synchronous = EXTRA')
        sync_mode = conn.execute('PRAGMA synchronous').fetchone()[0]
        if sync_mode != 3:
            raise CliError(f'writer-recovery requires SQLite PRAGMA synchronous=EXTRA (got {sync_mode!r})')
        conn.execute('BEGIN IMMEDIATE')
        _verify_pinned_ledger_under_tx(db_path, expected_ledger)
        journal_mode = str(conn.execute('PRAGMA journal_mode').fetchone()[0]).lower()
        if journal_mode not in ('delete', 'truncate', 'persist'):
            raise CliError(
                f'writer-recovery requires an existing SQLite rollback journal mode; got {journal_mode!r}'
            )
        version = conn.execute('PRAGMA user_version').fetchone()[0]
        if version not in (3, SCHEMA_VERSION):
            raise CliError(
                f'writer-recovery requires SQLite schema version 3 or {SCHEMA_VERSION}; got {version} '
                '(refusing without migrating)'
            )
        yield conn
        _verify_pinned_ledger_under_tx(db_path, expected_ledger)
        conn.execute('COMMIT')
    except Exception:
        try:
            if conn.in_transaction:
                conn.execute('ROLLBACK')
        except sqlite3.Error:
            pass
        raise
    finally:
        conn.close()


def _validate_recovery_xdg_state_home() -> None:
    """Reject nonempty XDG_STATE_HOME values with surrounding whitespace during writer-recovery."""
    raw_xdg = os.environ.get('XDG_STATE_HOME')
    if raw_xdg and raw_xdg != raw_xdg.strip():
        raise CliError(
            f'writer-recovery rejects XDG_STATE_HOME with surrounding whitespace: {raw_xdg!r}'
        )


def _validate_recovery_request(args: argparse.Namespace, db_path: Path) -> dict:
    """Validate recovery CLI inputs, Git scope, and host/ledger provenance before DB transaction."""
    _validate_recovery_xdg_state_home()
    attempt_id = args.attempt_id if args.attempt_id is not None else ''
    if not ATTEMPT_ID_RE.fullmatch(attempt_id):
        raise CliError(
            f'invalid writer attempt ID {args.attempt_id!r}; expected exact wa-<32 lowercase hex> '
            'with no surrounding whitespace'
        )
    if not getattr(args, 'confirm_local_ledger', False):
        raise CliError(
            f'--confirm-local-ledger is required to attest: {LOCAL_LEDGER_ATTESTATION}'
        )
    raw_cwd = args.cwd if args.cwd is not None else ''
    if not raw_cwd.strip():
        raise CliError('--cwd requires an existing linked Git worktree root')
    if raw_cwd != raw_cwd.strip():
        raise CliError(
            f'--cwd must name the exact linked Git worktree root without surrounding whitespace: {args.cwd!r}'
        )
    cwd_expanded = Path(raw_cwd).expanduser()
    if not os.path.isdir(cwd_expanded):
        raise CliError(f'worktree path does not exist or is not a directory: {args.cwd!r}')

    if args.unbound and args.run_id is not None:
        raise CliError('--run-id and --unbound are mutually exclusive')
    if not args.unbound and args.run_id is None:
        raise CliError('exactly one of --run-id or --unbound is required')
    if args.unbound:
        expected_bound = 0
        expected_run_id = None
    else:
        if not args.run_id:
            raise CliError('--run-id must not be empty')
        expected_bound = 1
        expected_run_id = args.run_id

    repo_key = canonicalize_repo(raw_cwd, git_bin=TRUSTED_GIT_BIN)
    if not (Path(repo_key) / 'HEAD').is_file() or not (Path(repo_key) / 'objects').is_dir():
        raise CliError(f'--cwd must belong to a real Git repository: {args.cwd!r}')
    worktree = scoped_worktree(raw_cwd, repo_key, args.issue, git_bin=TRUSTED_GIT_BIN)
    resolved_cwd = cwd_expanded.resolve()
    _verify_linked_worktree_backlink(resolved_cwd, Path(worktree))

    proc_fd, proc_st = _open_pinned_proc_root()
    try:
        pid_ns_inode, mounts = _verify_initial_pid_namespace_and_procfs(proc_fd, proc_st)
        boot_id = _validate_boot_id(_read_host_boot_id(proc_fd))
    finally:
        os.close(proc_fd)
    machine_id_hash = _hash_machine_id(_read_machine_id_raw())
    ledger = _inspect_ledger_provenance(db_path, resolved_cwd, mounts)

    return {
        'attempt_id': attempt_id,
        'repo_key': repo_key,
        'worktree': worktree,
        'issue': args.issue,
        'bound': expected_bound,
        'run_id': expected_run_id,
        'boot_id': boot_id,
        'machine_id_hash': machine_id_hash,
        'pid_ns_inode': pid_ns_inode,
        **ledger,
    }


def _has_recovery_table(conn: sqlite3.Connection) -> bool:
    """Return True if the additive writer_recovery_events table exists."""
    return (
        conn.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='writer_recovery_events'"
        ).fetchone()
        is not None
    )


def _load_and_verify_attempt_scope(conn: sqlite3.Connection, req: dict) -> sqlite3.Row:
    """Fetch and verify a single open writer attempt and any bound run scope."""
    att = conn.execute(
        'SELECT * FROM writer_attempts WHERE attempt_id = ?',
        (req['attempt_id'],),
    ).fetchone()
    if att is None:
        raise CliError(f'writer attempt not found: {req["attempt_id"]}')
    if att['status'] != 'open' or att['exit_code'] is not None or att['closed_at'] is not None:
        raise CliError(
            f'writer attempt {req["attempt_id"]} is not open '
            f'(status={att["status"]!r}, exit_code={att["exit_code"]!r})'
        )
    if (
        att['repo_key'] != req['repo_key']
        or att['worktree'] != req['worktree']
        or att['issue'] != req['issue']
        or int(att['bound']) != req['bound']
        or att['run_id'] != req['run_id']
    ):
        raise CliError(f'writer attempt {req["attempt_id"]} scope does not match requested --cwd/--issue/binding')
    if req['bound']:
        run = conn.execute('SELECT * FROM runs WHERE run_id = ?', (req['run_id'],)).fetchone()
        if run is None:
            raise CliError(f'bound run {req["run_id"]} missing for attempt {req["attempt_id"]}')
        if (
            run['repo_key'] != req['repo_key']
            or run['issue'] != req['issue']
            or run['worktree'] != req['worktree']
        ):
            raise CliError(f'bound run {req["run_id"]} scope does not match attempt {req["attempt_id"]}')
    return att


def _insert_recovery_event(
    conn: sqlite3.Connection,
    *,
    action: str,
    disposition: str | None,
    att: sqlite3.Row,
    attempt_status: str,
    attempt_closed_at: str | None,
    req: dict,
    created_at: str,
) -> None:
    """Insert an append-only arm or retire audit record into writer_recovery_events."""
    conn.execute(
        """
        INSERT INTO writer_recovery_events (
            attempt_id, action, disposition,
            attempt_repo_key, attempt_worktree, attempt_issue, attempt_bound, attempt_run_id,
            attempt_status, attempt_exit_code, attempt_created_at, attempt_closed_at,
            boot_id, machine_id_hash, pid_ns_inode,
            ledger_path, ledger_fs_type, ledger_fsid, ledger_ino,
            operator_attestation, created_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            att['attempt_id'],
            action,
            disposition,
            att['repo_key'],
            att['worktree'],
            att['issue'],
            int(att['bound']),
            att['run_id'],
            attempt_status,
            att['created_at'],
            attempt_closed_at,
            req['boot_id'],
            req['machine_id_hash'],
            req['pid_ns_inode'],
            req['ledger_path'],
            req['ledger_fs_type'],
            req['ledger_fsid'],
            req['ledger_ino'],
            LOCAL_LEDGER_ATTESTATION,
            created_at,
        ),
    )


def cmd_writer_recovery_arm(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Arm a single open writer attempt for post-reboot retirement after proving host and ledger provenance."""
    req = _validate_recovery_request(args, db_path)
    now = format_utc(utc_now())
    with _open_recovery_write_tx(db_path, req) as conn:
        att = _load_and_verify_attempt_scope(conn, req)
        if _has_recovery_table(conn):
            existing = conn.execute(
                'SELECT action FROM writer_recovery_events WHERE attempt_id = ?',
                (req['attempt_id'],),
            ).fetchone()
            if existing is not None:
                raise CliError(
                    f'writer attempt {req["attempt_id"]} already has recovery event ({existing["action"]})'
                )
        for stmt in WRITER_RECOVERY_EVENTS_SCHEMA:
            conn.execute(stmt)
        _insert_recovery_event(
            conn,
            action='arm',
            disposition=None,
            att=att,
            attempt_status='open',
            attempt_closed_at=None,
            req=req,
            created_at=now,
        )
    return 0, {
        'attempt_id': req['attempt_id'],
        'action': 'arm',
        'status': 'open',
        'exit_code': None,
        'disposition': None,
        'repo_key': req['repo_key'],
        'worktree': req['worktree'],
        'issue': req['issue'],
        'bound': bool(req['bound']),
        'run_id': req['run_id'],
        'observed_boot_id': req['boot_id'],
        'machine_id_hash': req['machine_id_hash'],
        'pid_ns_inode': req['pid_ns_inode'],
        'ledger_path': req['ledger_path'],
        'ledger_fs_type': req['ledger_fs_type'],
        'ledger_fsid': req['ledger_fsid'],
        'ledger_ino': req['ledger_ino'],
        'armed_at': now,
        'attestation_confirmed': True,
    }


def cmd_writer_recovery_retire(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Retire one armed open writer attempt as interrupted only after a verified host reboot."""
    req = _validate_recovery_request(args, db_path)
    now = format_utc(utc_now())
    with _open_recovery_write_tx(db_path, req) as conn:
        if not _has_recovery_table(conn):
            raise CliError(f'writer attempt {req["attempt_id"]} is not armed (missing recovery table)')
        events = conn.execute(
            'SELECT * FROM writer_recovery_events WHERE attempt_id = ?',
            (req['attempt_id'],),
        ).fetchall()
        arm_row = next((ev for ev in events if ev['action'] == 'arm'), None)
        retire_row = next((ev for ev in events if ev['action'] == 'retire'), None)
        if arm_row is None:
            raise CliError(f'writer attempt {req["attempt_id"]} must be armed before retiring')
        if retire_row is not None:
            raise CliError(f'writer attempt {req["attempt_id"]} has already been retired')

        att = _load_and_verify_attempt_scope(conn, req)
        if (
            arm_row['attempt_repo_key'] != att['repo_key']
            or arm_row['attempt_worktree'] != att['worktree']
            or arm_row['attempt_issue'] != att['issue']
            or int(arm_row['attempt_bound']) != int(att['bound'])
            or arm_row['attempt_run_id'] != att['run_id']
            or arm_row['attempt_status'] != 'open'
            or arm_row['attempt_exit_code'] is not None
            or arm_row['attempt_closed_at'] is not None
            or arm_row['attempt_created_at'] != att['created_at']
        ):
            raise CliError(f'writer attempt {req["attempt_id"]} changed since arm; refusing to retire')

        if arm_row['machine_id_hash'] != req['machine_id_hash']:
            raise CliError('host machine identity mismatch between arm and retire')
        if int(arm_row['pid_ns_inode']) != req['pid_ns_inode'] or req['pid_ns_inode'] != PROC_PID_INIT_INO:
            raise CliError('PID namespace mismatch between arm and retire')
        if (
            arm_row['ledger_path'] != req['ledger_path']
            or arm_row['ledger_fs_type'] != req['ledger_fs_type']
            or arm_row['ledger_fsid'] != req['ledger_fsid']
            or int(arm_row['ledger_ino']) != req['ledger_ino']
        ):
            raise CliError('ledger continuity mismatch between arm and retire')
        arm_boot_id = _validate_boot_id(arm_row['boot_id'])
        if arm_boot_id == req['boot_id']:
            raise CliError(
                'same host boot observed as arm; a completed reboot of the original host is required before retire'
            )

        cur = conn.execute(
            """
            UPDATE writer_attempts
            SET status = 'closed', closed_at = ?, exit_code = NULL
            WHERE attempt_id = ?
              AND status = 'open'
              AND exit_code IS NULL
              AND closed_at IS NULL
              AND repo_key = ?
              AND worktree = ?
              AND issue = ?
              AND bound = ?
              AND run_id IS ?
              AND created_at = ?
            """,
            (
                now,
                att['attempt_id'],
                att['repo_key'],
                att['worktree'],
                att['issue'],
                int(att['bound']),
                att['run_id'],
                att['created_at'],
            ),
        )
        if cur.rowcount != 1:
            raise CliError(f'writer attempt {req["attempt_id"]} changed during retirement update')

        _insert_recovery_event(
            conn,
            action='retire',
            disposition='interrupted',
            att=att,
            attempt_status='closed',
            attempt_closed_at=now,
            req=req,
            created_at=now,
        )
    return 0, {
        'attempt_id': req['attempt_id'],
        'action': 'retire',
        'status': 'closed',
        'exit_code': None,
        'closed_at': now,
        'disposition': 'interrupted',
        'repo_key': req['repo_key'],
        'worktree': req['worktree'],
        'issue': req['issue'],
        'bound': bool(req['bound']),
        'run_id': req['run_id'],
        'armed_boot_id': arm_row['boot_id'],
        'retired_boot_id': req['boot_id'],
        'armed_at': arm_row['created_at'],
        'retired_at': now,
        'machine_id_hash': req['machine_id_hash'],
        'pid_ns_inode': req['pid_ns_inode'],
        'ledger_path': req['ledger_path'],
        'ledger_fs_type': req['ledger_fs_type'],
        'ledger_fsid': req['ledger_fsid'],
        'ledger_ino': req['ledger_ino'],
        'attestation_confirmed': True,
    }


def _build_recovery_attempt_dict(att: sqlite3.Row, events: list[sqlite3.Row]) -> dict:
    """Build a safe read-only recovery status payload for one writer attempt."""
    ev_list = [
        {
            'action': ev['action'],
            'disposition': ev['disposition'],
            'boot_id': ev['boot_id'],
            'machine_id_hash': ev['machine_id_hash'],
            'pid_ns_inode': ev['pid_ns_inode'],
            'ledger_path': ev['ledger_path'],
            'ledger_fs_type': ev['ledger_fs_type'],
            'ledger_fsid': ev['ledger_fsid'],
            'ledger_ino': ev['ledger_ino'],
            'created_at': ev['created_at'],
        }
        for ev in events
    ]
    actions = {ev['action'] for ev in events}
    if 'retire' in actions:
        recovery_state = 'retired'
        disposition = next((ev['disposition'] for ev in events if ev['action'] == 'retire'), None)
    elif 'arm' in actions:
        recovery_state = 'armed'
        disposition = None
    else:
        recovery_state = 'unarmed'
        disposition = None
    return {
        'attempt_id': att['attempt_id'],
        'repo_key': att['repo_key'],
        'worktree': att['worktree'],
        'issue': att['issue'],
        'bound': bool(att['bound']),
        'run_id': att['run_id'],
        'status': att['status'],
        'exit_code': att['exit_code'],
        'created_at': att['created_at'],
        'closed_at': att['closed_at'],
        'recovery_state': recovery_state,
        'disposition': disposition,
        'recovery_events': ev_list,
    }


def cmd_writer_recovery_status(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Read-only inspection of one writer attempt's recovery state; never initializes or migrates."""
    _validate_recovery_xdg_state_home()
    attempt_id = (args.attempt_id or '').strip()
    if not ATTEMPT_ID_RE.fullmatch(attempt_id):
        raise CliError(f'invalid writer attempt ID {args.attempt_id!r}; expected wa-<32 lowercase hex>')
    if not db_path.exists():
        raise CliError(f'writer ledger missing: {db_path}')
    _verify_ledger_inode(db_path, require_exists=True)
    with open_read_only(db_path) as conn:
        version = conn.execute('PRAGMA user_version').fetchone()[0]
        if version not in (3, SCHEMA_VERSION):
            raise CliError(
                f'writer-recovery requires SQLite schema version 3 or {SCHEMA_VERSION}; got {version}'
            )
        att = conn.execute(
            'SELECT * FROM writer_attempts WHERE attempt_id = ?',
            (attempt_id,),
        ).fetchone()
        if att is None:
            raise CliError(f'writer attempt not found: {attempt_id}')
        events = (
            conn.execute(
                'SELECT * FROM writer_recovery_events WHERE attempt_id = ? ORDER BY created_at ASC, action ASC',
                (attempt_id,),
            ).fetchall()
            if _has_recovery_table(conn)
            else []
        )
        result = _build_recovery_attempt_dict(att, events)
        if conn.execute("SELECT 1 FROM sqlite_master WHERE name='writer_switches'").fetchone():
            switched = conn.execute("SELECT replacement,disposition FROM writer_switches WHERE source=?",
                                    (attempt_id,)).fetchone()
            if switched:
                result.update(replacement=switched['replacement'], disposition=switched['disposition'])
        return 0, result


def cmd_writer_recovery(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Dispatch writer-recovery subcommands."""
    _validate_recovery_xdg_state_home()
    if args.recovery_action == 'arm':
        return cmd_writer_recovery_arm(args, db_path)
    if args.recovery_action == 'retire':
        return cmd_writer_recovery_retire(args, db_path)
    if args.recovery_action == 'status':
        return cmd_writer_recovery_status(args, db_path)
    raise CliError(f'unknown writer-recovery action: {args.recovery_action!r}')


def cmd_cancel(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    """Cancel a non-terminal run at its current stage and free its repo key."""
    stage = validate_stage(args.stage)
    now = format_utc(utc_now())
    with open_write_tx(db_path) as conn:
        run = fetch_run(conn, args.run_id)
        require_interactive_run(conn, run['run_id'])
        require_writable_stage(run, stage)
        active_wait = fetch_active_wait(conn, run['run_id'])
        if active_wait is not None:
            conn.execute(
                'UPDATE waits SET resolved_at = ?, resolution = ? WHERE id = ?',
                (now, 'cancelled', active_wait['id']),
            )
        conn.execute(
            """
            UPDATE runs
            SET status = 'cancelled', reserved = 0, current_stage = NULL, cancelled_stage = ?,
                updated_at = ?, completed_at = ?
            WHERE run_id = ?
            """,
            (stage, now, now, run['run_id']),
        )
        conn.execute(
            'INSERT INTO events (run_id, event_type, stage, detail, created_at) VALUES (?, ?, ?, ?, ?)',
            (run['run_id'], 'cancel', stage, args.reason, now),
        )
        updated = fetch_run(conn, run['run_id'])
        payload = build_run_dict(conn, updated)
    return 0, payload


def poll_queued_ci(db_path: Path) -> tuple[list[dict], dict[int, str]]:
    with open_read_only(db_path) as conn:
        rows = conn.execute(
            "SELECT * FROM waits WHERE target = 'ci' AND resolved_at IS NULL AND reason LIKE ? ORDER BY id",
            (WATCH_PREFIX + '%',),
        ).fetchall()
    results = []
    failures = {}
    for row in rows:
        if parse_iso_utc(row['deadline_at']) <= utc_now():
            continue
        try:
            repo, pr, required, *profile_base = json.loads(row['reason'][len(WATCH_PREFIX):])
            if len(profile_base) > 1:
                raise CliError('invalid queued CI request')
            _, result = cmd_monitor(argparse.Namespace(
                rev=row['expected_rev'], host='git.butakov.su', repo=repo, pr=pr, require=required,
                profile=bool(profile_base), queued_base=profile_base[0] if profile_base else None,
                run_id=row['run_id'], interval=1, timeout=30, once=True, queue=False,
                watch_generation=row['generation'],
            ), db_path)
            if result['status'] == 'success':
                results.append({'reason': 'ci_passed', 'run_id': row['run_id'], 'stage': 'ci',
                                'expected_rev': row['expected_rev'], 'wait_generation': row['generation']})
        except CliError as exc:
            failures[row['id']] = str(exc)
        except (ValueError, TypeError, AttributeError):
            failures[row['id']] = 'invalid queued CI request'
    return results, failures


def cmd_preflight(args: argparse.Namespace, db_path: Path) -> tuple[int, dict]:
    def git(*tokens):
        try:
            result = subprocess.run([TRUSTED_GIT_BIN, '-C', args.checkout, *tokens], capture_output=True,
                                    text=True, env=_clean_git_env(), timeout=5, check=False)
        except (OSError, subprocess.TimeoutExpired):
            raise CliError('Git preflight exceeded its deadline') from None
        if result.returncode:
            raise CliError('preflight requires a readable Git checkout')
        return result.stdout.rstrip('\n')

    root, git_dir, common_dir, head = git('rev-parse', '--path-format=absolute', '--show-toplevel',
                                         '--git-dir', '--git-common-dir', 'HEAD').splitlines()
    payload = {
        'checkout': root,
        'linked_worktree': git_dir != common_dir,
        'head': validate_full_rev(head),
        'dirty': bool(git('status', '--porcelain')),
        'next': None,
    }
    if args.run_id:
        _, payload['next'] = cmd_resume(args, db_path)
    return 0, payload


def cmd_watch(args: argparse.Namespace, db_path: Path) -> tuple[int, list[dict]]:
    """Poll queued CI and emit deduped JSON notices for due or failed waits."""
    if not db_path.exists():
        return 0, []
    emitted, failures = poll_queued_ci(db_path)
    now_dt = utc_now()
    now_iso = format_utc(now_dt)
    with open_write_tx(db_path) as conn:
        has_dispatch = conn.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='dispatch_runs'"
        ).fetchone() is not None
        dispatch_filter = (
            ' AND NOT EXISTS (SELECT 1 FROM dispatch_runs d WHERE d.run_id = r.run_id)'
            if has_dispatch
            else ''
        )
        pending = conn.execute(
            f"""
            SELECT w.*, r.repo_key, r.current_stage
            FROM waits w
            JOIN runs r ON r.run_id = w.run_id
            WHERE r.status = 'waiting'
              AND w.resolved_at IS NULL
              {dispatch_filter}
              AND NOT EXISTS (
                  SELECT 1 FROM notices n
                  WHERE n.run_id = w.run_id AND n.wait_generation = w.generation
              )
            ORDER BY w.id ASC
            """
        ).fetchall()
        for wait_row in pending:
            wait_target = wait_row['target']
            failure = failures.get(wait_row['id'])
            if not failure and wait_row['deadline_at'] and now_dt < parse_iso_utc(wait_row['deadline_at']):
                continue
            if failure:
                notice_target = 'coordinator'
                reason = 'ci_unverified'
            elif wait_target == 'ci':
                notice_target = 'coordinator'
                reason = 'ci_overdue'
            else:
                notice_target = wait_target
                handoff = (conn.execute('SELECT supplied FROM external_patches WHERE wait_id=?', (wait_row['id'],)).fetchone()
                           if external_patch_table(conn) else None)
                reason = ('external_patch_ready' if handoff['supplied'] else 'external_patch_required') if handoff else 'wait_pending'
            notice = {
                'run_id': wait_row['run_id'],
                'repo_key': wait_row['repo_key'],
                'stage': wait_row['stage'],
                'wait_generation': wait_row['generation'],
                'target': notice_target,
                'wait_target': wait_target,
                'reason': reason,
                'expected_rev': wait_row['expected_rev'],
                'deadline_at': wait_row['deadline_at'],
                'wait_reason': failure or wait_row['reason'],
                'emitted_at': now_iso,
            }
            payload_json = json.dumps(notice, sort_keys=True)
            conn.execute(
                """
                INSERT INTO notices (
                    run_id, wait_generation, stage, target, wait_target, reason, payload_json, emitted_at
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    wait_row['run_id'],
                    wait_row['generation'],
                    wait_row['stage'],
                    notice_target,
                    wait_target,
                    reason,
                    payload_json,
                    now_iso,
                ),
            )
            emitted.append(notice)
    return 0, emitted


def format_human(command: str, data: object) -> str:
    """Format command output for interactive CLI callers."""
    if command == 'resume' and isinstance(data, dict):
        return data['message']
    if command == 'status' and isinstance(data, list) and not data:
        return 'no active runs'
    return json.dumps(data, indent=2, sort_keys=True)


class _RecoverySingleStoreAction(argparse.Action):
    """Store a writer-recovery scope option once; repeats are refused instead of last-wins."""

    def __call__(self, parser, namespace, values, option_string=None):
        seen = getattr(namespace, '_writer_recovery_seen_options', None)
        if seen is None:
            seen = set()
            setattr(namespace, '_writer_recovery_seen_options', seen)
        if self.dest in seen:
            parser.error(f'{option_string} may be given only once for writer-recovery arm/retire')
        seen.add(self.dest)
        setattr(namespace, self.dest, values)


def build_parser() -> argparse.ArgumentParser:
    """Construct the CLI argument parser."""
    parser = argparse.ArgumentParser(
        prog='pi-team-run',
        description='Manual durable pipeline bookkeeping for pi team runs.',
    )
    parser.add_argument('--json', action='store_true', default=False, help='Emit JSON output')
    sub = parser.add_subparsers(dest='command', required=True)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--json', action='store_true', default=argparse.SUPPRESS, help='Emit JSON output')

    p_start = sub.add_parser('start', parents=[common], help='Start a pipeline run for a repo')
    p_start.add_argument('repo', help='Repository path or identifier')
    p_start.add_argument('--issue', help='Exact Beads issue ID; repo must be the linked task worktree root')
    p_start.add_argument('--run-id', help='Optional explicit run identifier ([A-Za-z0-9][A-Za-z0-9._-]{0,127})')
    p_start.add_argument(
        '--local-only',
        action='store_true',
        help='Local-only run: require linked worktree + --issue; stop after terminal review without delivery/optional stages',
    )
    p_start.add_argument(
        '--commit-only',
        action='store_true',
        help='Stop delivery after the local commit checkpoint (optional closeout stages may follow)',
    )
    p_start.add_argument('--no-ci', action='store_true', help='Omit CI only where repository policy explicitly has none')
    p_start.add_argument('--with-deploy', action='store_true', help='Opt in to optional deploy stage')
    p_start.add_argument('--with-honcho', action='store_true', help='Opt in to optional honcho stage')
    p_start.add_argument('--with-wiki', action='store_true', help='Opt in to optional wiki stage')
    p_start.add_argument('--note', help='Optional nonsecret run note')

    p_discover = sub.add_parser('discover', parents=[common], help='List unfinished runs for this checkout')
    p_discover.add_argument('checkout', nargs='?', default='.')

    p_preflight = sub.add_parser('preflight', parents=[common], help='Show exact local checkout and ledger state')
    p_preflight.add_argument('checkout')
    p_preflight.add_argument('--run-id')

    p_status = sub.add_parser('status', parents=[common], help='Inspect a run or list runs')
    p_status.add_argument('run_id', nargs='?', help='Optional run identifier')
    p_status.add_argument('--writer', action='store_true', help='Include latest bound writer when inspecting one run')
    p_status.add_argument('--all', action='store_true', help='Include terminal runs when listing')

    p_resume = sub.add_parser('resume', parents=[common], help='Show next step without modifying state')
    p_resume.add_argument('run_id', help='Run identifier')

    p_wait = sub.add_parser('wait', parents=[common], help='Record an explicit wait on the current stage')
    p_wait.add_argument('run_id', help='Run identifier')
    p_wait.add_argument('stage', help='Current stage name')
    p_wait.add_argument('--target', required=True, choices=WAIT_TARGETS, help='Wait routing target')
    p_wait.add_argument('--rev', help='Expected full hex revision (required for CI)')
    p_wait.add_argument('--deadline', help='ISO-8601 deadline with timezone or Z (required for CI)')
    p_wait.add_argument('--reason', help='Optional nonsecret wait reason')
    p_wait.add_argument('--rejected-patch', help='Full rejected diff SHA-256; park for an external maintainer, not approval')
    p_supply = sub.add_parser('supply-patch', parents=[common], help='Record an external candidate for verification only')
    p_supply.add_argument('run_id')
    p_supply.add_argument('--generation', type=int, required=True)
    p_supply.add_argument('--candidate', required=True)
    p_supply.add_argument('--snapshot', required=True, help='Local exact diff; bytes are hashed, not stored')
    p_supply.add_argument('--evidence', required=True, help='Nonsecret locator of the exact supplied patch')
    p_wait.add_argument('--replace', action='store_true', help='Supersede an existing active wait')

    p_reserve = sub.add_parser('reserve', parents=[common], help='Reserve this repo before a shared operation')
    p_reserve.add_argument('run_id')
    p_reserve.add_argument('stage', choices=STAGES)

    p_ckpt = sub.add_parser('checkpoint', parents=[common], help='Checkpoint the current stage')
    p_ckpt.add_argument('run_id', help='Run identifier')
    p_ckpt.add_argument('stage', help='Current stage name')
    p_ckpt.add_argument(
        '--evidence',
        required=True,
        help='Required opaque nonsecret evidence locator (review:pass:<locator> required for local-only review)',
    )
    p_ckpt.add_argument(
        '--rev',
        help='Full hex revision (required for CI; full 64-hex SHA-256 required for local-only check/review)',
    )
    p_ckpt.add_argument(
        '--writer-attempt',
        metavar='ATTEMPT_ID',
        help='Inspected closed exit-0 writer attempt ID (required for local-only check)',
    )
    p_ckpt.add_argument('--checks-evidence', help='Fresh checks receipt for an external patch replacing a reviewed candidate')
    p_ckpt.add_argument('--generation', type=int, help='Exact wait generation for a scoped checkpoint')
    p_ckpt.add_argument('--skip', action='store_true', help='Explicitly skip an optional stage')
    p_ckpt.add_argument('--note', help='Optional nonsecret note')

    sub.add_parser('watch', parents=[common], help='Poll queued CI once and emit JSON notices')

    p_monitor = sub.add_parser('monitor', parents=[common], help='Poll required Forgejo CI on an exact revision')
    p_monitor.add_argument('repo', help='Forgejo owner/name')
    p_monitor.add_argument('--host', default='git.butakov.su')
    p_monitor.add_argument('--pr', type=int, help='Verify this ready PR still points at the exact revision')
    p_monitor.add_argument('--run-id', help='Checkpoint CI on success for an existing run (requires --pr)')
    p_monitor.add_argument('--rev', required=True, help='Full commit SHA')
    checks = p_monitor.add_mutually_exclusive_group(required=True)
    checks.add_argument('--require', action='append', help='Exact required check context; repeat for each check')
    checks.add_argument('--profile', action='store_true', help='Use the registered delivery profile for this host and repo')
    p_profile = sub.add_parser('delivery-profile', parents=[common], help='Show the read-only delivery policy for a repository')
    p_profile.add_argument('repo', help='Forgejo owner/name')
    p_profile.add_argument('--host', default='git.butakov.su')
    p_monitor.add_argument('--interval', type=int, default=15)
    p_monitor.add_argument('--timeout', type=int, default=900)
    p_monitor.add_argument('--queue', action='store_true', help='Register a durable Forgejo PR wait for the watch service')

    p_cancel = sub.add_parser('cancel', parents=[common], help='Cancel a run at its current stage')
    p_cancel.add_argument('run_id', help='Run identifier')
    p_cancel.add_argument('stage', help='Current stage name')
    p_cancel.add_argument('--reason', help='Optional cancellation reason')

    p_wexec = sub.add_parser('writer-exec', help=argparse.SUPPRESS)
    p_wexec.add_argument('--cwd', required=True)
    p_wexec.add_argument('--issue', required=True)
    p_wexec.add_argument('--run-id')
    p_wexec.add_argument('--claim-actor')
    p_wexec.add_argument('--switch-from', metavar='ATTEMPT_ID')
    p_wexec.add_argument('argv', nargs=argparse.REMAINDER)

    p_wrec = sub.add_parser(
        'writer-recovery',
        parents=[common],
        help='Inspect or recover an interrupted open writer attempt',
    )
    wrec_sub = p_wrec.add_subparsers(dest='recovery_action', required=True)
    for action_name, action_help in (
        ('arm', 'Arm an interrupted open writer attempt for post-reboot retirement'),
        ('retire', 'Retire an armed open writer attempt after a confirmed host reboot'),
    ):
        p_act = wrec_sub.add_parser(action_name, parents=[common], help=action_help)
        p_act.add_argument('attempt_id', help='Writer attempt identifier (wa-<32-hex>)')
        p_act.add_argument('--cwd', required=True, action=_RecoverySingleStoreAction,
                           help='Linked Git worktree root path')
        p_act.add_argument('--issue', required=True, action=_RecoverySingleStoreAction,
                           help='Exact Beads issue ID')
        scope_grp = p_act.add_mutually_exclusive_group(required=True)
        scope_grp.add_argument('--run-id', action=_RecoverySingleStoreAction,
                               help='Bound pipeline run identifier')
        scope_grp.add_argument('--unbound', action='store_true', help='Explicitly target an unbound attempt')
        p_act.add_argument(
            '--confirm-local-ledger',
            action='store_true',
            help='Operator attestation: original host, same private local ledger and scope, no sharing/copy/restore/cloned machine-id/replay',
        )
    p_wrec_status = wrec_sub.add_parser('status', parents=[common], help='Read-only writer recovery status')
    p_wrec_status.add_argument('attempt_id', help='Writer attempt identifier (wa-<32-hex>)')

    return parser


def main(argv: list[str] | None = None) -> int:
    """CLI entrypoint."""
    parser = build_parser()
    args = parser.parse_args(argv)
    handlers = {
        'start': cmd_start,
        'status': cmd_status,
        'preflight': cmd_preflight,
        'discover': cmd_discover,
        'delivery-profile': cmd_delivery_profile,
        'resume': cmd_resume,
        'wait': cmd_wait,
        'supply-patch': cmd_supply_patch,
        'checkpoint': cmd_checkpoint,
        'reserve': cmd_reserve,
        'watch': cmd_watch,
        'monitor': cmd_monitor,
        'cancel': cmd_cancel,
        'writer-exec': cmd_writer_exec,
        'writer-recovery': cmd_writer_recovery,
    }
    os.umask(0o077)
    try:
        if args.command == 'writer-recovery':
            _validate_recovery_xdg_state_home()
        db_path = resolve_state_db_path()
        code, result = handlers[args.command](args, db_path)
    except CliError as exc:
        print(f'error: {exc}', file=sys.stderr)
        return 1
    except (sqlite3.DatabaseError, OSError) as exc:
        print(f'state error: {exc}', file=sys.stderr)
        return 1

    if args.command == 'writer-exec':
        return code
    if args.command == 'watch':
        for notice in result:
            print(json.dumps(notice, sort_keys=True))
    elif args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(format_human(args.command, result))
    return code


if __name__ == '__main__':
    sys.exit(main())
