TRUSTED_WRITER_BOOTSTRAP_PY = (
    'import os, sys\n'
    'buf = b""\n'
    'while len(buf) < 3:\n'
    '    chunk = os.read(0, 3 - len(buf))\n'
    '    if not chunk:\n'
    '        break\n'
    '    buf += chunk\n'
    'if buf != b"GO":\n'
    '    sys.exit(88)\n'
    'dn = os.open("/dev/null", os.O_RDONLY)\n'
    'if dn != 0:\n'
    '    os.dup2(dn, 0)\n'
    '    os.close(dn)\n'
    'try:\n'
    '    fds = [int(name) for name in os.listdir("/proc/self/fd")]\n'
    'except OSError:\n'
    '    fds = list(range(3, 4096))\n'
    'for fd in fds:\n'
    '    if fd > 2:\n'
    '        try:\n'
    '            os.close(fd)\n'
    '        except OSError:\n'
    '            pass\n'
    'try:\n'
    '    os.execvp(sys.argv[1], sys.argv[1:])\n'
    'except FileNotFoundError:\n'
    '    prog = sys.argv[1].replace("\\r", " ").replace("\\n", " ")\n'
    '    sys.stderr.write(f"bwrap: execvp {prog}: No such file or directory\\n")\n'
    '    sys.stderr.flush()\n'
    '    sys.exit(127)\n'
    'except PermissionError:\n'
    '    prog = sys.argv[1].replace("\\r", " ").replace("\\n", " ")\n'
    '    sys.stderr.write(f"bwrap: execvp {prog}: Permission denied\\n")\n'
    '    sys.stderr.flush()\n'
    '    sys.exit(126)\n'
    'except OSError as exc:\n'
    '    prog = sys.argv[1].replace("\\r", " ").replace("\\n", " ")\n'
    '    msg = exc.strerror or "exec failed"\n'
    '    sys.stderr.write(f"bwrap: execvp {prog}: {msg}\\n")\n'
    '    sys.stderr.flush()\n'
    '    sys.exit(126)\n'
)
