MAX_BEADS_CFG_BYTES = 131_072
MAX_FILE_BYTES = 1_048_576
MAX_TOTAL_CHANGED_BYTES = 4_194_304
MAX_WRITABLE_FILES = MAX_TOTAL_CHANGED_BYTES // MAX_FILE_BYTES
MAX_TMPFS_BYTES = 8_388_608
MAX_MATERIALIZE_FILE_BYTES = 4_194_304
MAX_TOTAL_MATERIALIZED_BYTES = 33_554_432
MAX_TREE_ENTRIES = 4096
MAX_WALK_DEPTH = 32
MAX_STAGE_OUTPUT_BYTES = 262_144
MAX_ACCEPTANCE_CRITERIA_CHARS = 8192
MAX_RUN_TIMEOUT_SEC = 3600
MAX_BD_READY_ROWS = 10_000
BWRAP_BIN = '/usr/bin/bwrap'
ISSUE_ID_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$')
ACTOR_PREFIX_RE = re.compile(r'[A-Za-z0-9_.:-]{1,64}')
DERIVED_ACTOR_RE = re.compile(r'[A-Za-z0-9_.:-]{1,128}')
