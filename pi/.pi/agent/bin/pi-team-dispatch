    'import os, sys\n'
    'b = os.read(0, 1)\n'
    'if b != b"G":\n'
    '    sys.exit(88)\n'
    'dn = os.open("/dev/null", os.O_RDONLY)\n'
    'os.dup2(dn, 0)\n'
    'if dn > 0:\n'
    '    os.close(dn)\n'
    'os.execvp(sys.argv[1], sys.argv[1:])\n'
)

