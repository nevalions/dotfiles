#!/usr/bin/env python3
"""Bounded offline unattended dispatcher for Pi Team.

V1 worker execution supports exact existing regular-file content replacements
only (in-place write/truncate on prebound files within a read-only workspace,
hard RLIMIT_FSIZE, seccomp fallocate denial, bounded /tmp and /scratch tmpfs,
and a read-only root remount). File creation, deletion, rename, links, and
mode changes are unsupported.
"""
from __future__ import annotations

